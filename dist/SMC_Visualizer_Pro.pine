EV_OTE_ENTER = 32
EV_SESSION_START = 33
EV_SESSION_END = 34
EV_HTF_BIAS = 35
EV_SYS_WARM = 90
EV_SYS_WARN = 91

// Liquidity kinds and states (§7.2, A.12–A.13)
LK_SWING = 1
LK_PDH = 3
LK_PDL = 4
LK_PWH = 5
LK_PWL = 6
LK_SESS = 7
LS_ACTIVE = 1
