// ═══ 02 · TYPES ═════════════════════════════════════════════════════════════════
// Logical objects never hold drawing handles (docs §8.1): they stay serializable and
// reusable by the strategy build. Drawings live only in the visual pools (§8.4).

enum DisplayMode
    clean = "Clean"
    normal = "Normal"
    analysis = "Analysis"
    debug = "Debug"
    custom = "Custom"

enum ThemeOpt
    auto = "Auto"
    dark = "Dark"
    light = "Light"

enum PaletteOpt
    standard = "Standard"
    cvd = "Color-blind safe"

enum Verbosity
    icons = "Icons"
    brief = "Short"
    full = "Full"

enum StructPreset
    scalp = "Scalp 5/2"
    intraday = "Intraday 10/3"
    swing = "Swing 20/5"
    manual = "Manual"

enum BreakSrc
    onClose = "Close"
    wick = "Wick"

enum ObZone
    full = "Full"
    bodyWick = "Body+Wick"
    body = "Body"

enum MitRule
    touch = "Touch"
    half = "50%"
    full = "Full"

enum FillRule
    wick = "Wick far edge"
    closeEdge = "Close far edge"
    ce = "CE (50%)"

enum PdView
    off = "Off"
    eqOnly = "EQ only"
    eqOte = "EQ + OTE"
    full = "Full (wash)"

enum SesPreset
    ictNy = "ICT (NY)"
    originalUtc = "Original (UTC)"
    custom = "Custom"

enum SesView
    rangeBox = "Range box"
    off = "Off"

enum Visibility
    subtle = "Subtle"
    standard = "Standard"
    bold = "Bold"

enum PanelSize
    small = "Small"
    normal = "Normal"
    large = "Large"

enum HtfMode
    auto = "Auto"
    manual = "Manual"
    off = "Off"

enum HistView
    visible = "History window"
    recent = "Recent only"

enum SetPreset
    balanced = "Balanced"
    conservative = "Conservative"
    aggressive = "Aggressive"

enum EntryMode
    ce = "CE (50%)"
    edge = "Zone edge"
    ote = "OTE 0.705"

enum SlMode
    auto = "Auto (by model)"
    poi = "Beyond POI"
    atr = "ATR × 1.5"

enum TpMode
    liq = "Liquidity"
    rr = "RR 1 / 2 / 3"

enum GradeOpt
    c = "C"
    b = "B"
    a = "A"
    ap = "A+"

// Immutable fact about a state transition, emitted on a confirmed bar (§6.2)
type Event
    int id
    int typ
    int dir = 0
    int tf = 0
    int bar
    int t
    float price
    int ref
    int cause
    int tier = 3
    float v1
    float v2
    float v3
    string s1 = ""

// Event bus + id registry (§6.3)
type Core
    int nextId = 0
    array<Event> barEvents
    array<Event> history
    int histCap = 300
    int lastDispUpId
    int lastDispUpBar
    int lastDispDnId
    int lastDispDnBar
    int lastFvgUpBar
    int lastFvgDnBar
    Event lastStruct
    Event lastHtfStruct
    Event lastLiq
    bool warm = false

type Swing
    int id
    int side
    int lvl
    float price
    int bar
    int t
    int confirmBar
    string tag = ""
    bool eq = false
    bool broken = false

// Structure break (BOS / CHoCH). legExt0 is the leg origin extreme, legExt1 the far extreme.
type Brk
    int id
    int kind
    int dir
    int lvl
    float price
    int swingBar
    int swingT
    int bar
    int t
    float legExt0
    float legExt1
    int origBar
    int origT
    int firstDisp
    float disp
    bool mss = false
    bool initial = false
    bool shadowed = false
    int evId
    int tf = 0

// Structure automaton for one level (internal or swing) on one TF (§7.1)
type StructState
    int lvl
    int len
    int trend = 0
    Swing refHigh
    Swing refLow
    Swing lastHigh
    Swing lastLow
    float upOrigLow
    int upOrigBar
    int upOrigT
    float upLegHigh
    int upFirstDisp
    float dnOrigHigh
    int dnOrigBar
    int dnOrigT
    float dnLegLow
    int dnFirstDisp
    float protLow
    float protHigh
    int lastBrkBar
    int lastBrkDir = 0
    int lastBrkKind = 0
    int prevBrkBar
    int prevBrkDir = 0
    int prevBrkKind = 0
    Brk newUp
    Brk newDn
    Swing newHigh
    Swing newLow
    array<Swing> swings
    array<Brk> breaks

// Liquidity level (§7.2). side +1 = BSL, -1 = SSL.
type Liq
    int id
    int side
    int kind
    int tf = 0
    float price
    int bar
    int t
    int born
    int lastBar
    int touches = 1
    bool major = false
    int state = 1
    int pendSince
    float ext
    int endBar
    int endT
    int sweepType = 0
    int lvl = 1
    string tag = ""
    int hBorn

// Unified zone model for OB / BB / MB / FVG / IFVG (§8.3, ADR-07)
type Zone
    int id
    int kind
    int dir
    int state = 1
    float top
    float bottom
    int bar
    int t
    int born
    int bornT
    int endBar
    int endT
    int touches = 0
    float maxPen = 0.0
    float unfilled
    float strength = 0.0
    float disp = 0.0
    float extRef
    float legExt
    int parent
    int brkId
    int lvl = 1
    int tf = 0
    bool fallback = false
    int hBorn
    float nearD

// Dealing range (§7.5). state: 0 none, 1 developing, 2 established.
type Range
    int id
    int dir = 0
    int state = 0
    float hi
    float lo
    int hiBar
    int loBar
    int t0
    int b0
    int pdZone = 0
    bool inOte = false

// Finished dealing range kept for history rendering
type RangeSnap
    int dir
    float hi
    float lo
    int t0
    int t1
    int b0
    int b1

type Sess
    string name
    string code
    string tagHi
    string tagLo
    string spec
    bool on = false
    float hi
    float lo
    int t0
    int b0
    int endT

type SessBox
    string code
    float hi
    float lo
    int t0
    int t1
    int b0
    int b1

// Market context snapshot for Ribbon / Dashboard (§8.3)
type Ctx
    int market = 0
    int swTrend = 0
    int inTrend = 0
    bool ranging = false
    float pd
    int pdZone = 0
    bool inOte = false
    int rangeState = 0
    string sessCode = ""
    int minsLeft
    Liq nextBsl
    Liq nextSsl
    bool htfOk = false
    bool htfLow = false
    int htfTrend = 0

// Alert message (§12.7) and the events it carries
enum AlertFmt
    plain = "Text"
    json = "JSON (webhook)"

enum WhScope
    setups = "Setups"
    key = "Setups + key events"
    all = "All events (min tier)"

// Setup: an evolving trade hypothesis with its evidence, plan and score (§7.7, §9, §10).
// v1.0 setups are analytical: drawn and alerted, never executed. The DRAFT TradePlan
// (entry / SL / targets / RR) is kept inside the setup until the P9 webhook needs it apart.
type Setup
    int id
    int model
    int dir
    int state
    int bornBar
    int bornT
    int stageBar
    // liquidity component
    int sweepEvId
    int sweptLiqId
    float sweepExt
    bool sweepMajor = false
    string sweepTag = ""
    int sweepBar
    int sweepT
    float sweepPx
    bool contSweep = false
    // shift component
    int shiftEvId
    int shiftBrkId
    int shiftBar
    int shiftT
    int shiftLvl
    int shiftKind
    bool isMSS = false
    float disp
    float shiftPx
    int shiftSwT
    // location: range built by the shift leg
    float rLo
    float rHi
    int legBar
    // POI
    Zone poi
    Zone poiAlt
    bool combo = false
    float entryTop
    float entryBot
    // plan (DRAFT TradePlan)
    float entry
    float sl
    float slInit
    float inv
    float tp1
    float tp2
    float tp3
    string tp1Tag = ""
    string tp2Tag = ""
    string tp3Tag = ""
    int nTp = 0
    float rrFinal
    bool drawLiq = false
    string drawTxt = ""
    // score
    float score = 0.0
    int grade = 0
    string factors = ""
    string chain = ""
    string chainMid = ""
    string why = ""
    bool kz = false
    // lifecycle
    int readyBar
    int readyT
    int trigBar
    int trigT
    int endBar
    int endT
    int tpHit = 0
    bool be = false
    float rReal = 0.0
    string reason = ""

// Display mode ceilings (§15.3, §19.2)
type ModeCfg
    int structEvents
    int internalEvents
    bool swingLabels
    int zonesPerSide
    int majorPerSide
    int minorPerSide
    int sweptShow
    float distMax
    float theta
    int ttl
    int hist
    bool mitigated
    int pdCap
    bool gauge
    int sessions
    bool dashboard
    int labelLevel
    bool debug
    int structWin
    int internalWin
    int swingLabelWin
    int sweepWin
    int sessWin
    int rangeWin
    int poolZone
    int poolWash
    int poolLvl
    int poolStr
    int poolLab
    int htfStructEvents
    int htfStructWin
    int keyCap
    int gradeFloor = 1
    int setupPast = 0
    int poolSetBox = 8
    int poolSetLine = 16
    int poolSetLab = 16

// What the render pass draws: a bar window, split into time segments. Each segment ranks
// objects against its own anchor (close and ATR at the segment's last bar), so a wide or
// scrolled-back view keeps the same density as the live edge (docs §15, AC-M16).
type View
    bool vp
    bool live
    int iL
    int iR
    int segs = 1
    array<int> segEnd
    array<float> segPx
    array<float> segAtr
    float winLo
    float winHi
    int tL

// Visual pools: drawings are created once and reused (§4.9)
type BoxPool
    array<box> items
    int used = 0

type LinePool
    array<line> items
    int used = 0

type LabelPool
    array<label> items
    int used = 0

// Right-edge tag for levels, merged by Smart Labels (§14.7)
type Tag
    float price
    string txt
    color col
    string tip

// ═══ 03 · INPUTS & EFFECTIVE CONFIG ═════════════════════════════════════════════
// Settings panel per docs/05-ux-ui-spec.md §14.4. All inputs use display.none so the
// status line stays clean (V-10). The webhook group arrives with P9.
G_PROF = "⚙️ 0 · PROFILE"
G_VIS = "🎨 1 · VISUAL EXPERIENCE"
G_STR = "🏗 2 · STRUCTURE"
G_LIQ = "💧 3 · LIQUIDITY"
G_OB = "🧱 4 · ORDER BLOCKS"
G_FVG = "🟨 5 · FAIR VALUE GAPS"
G_RNG = "🎯 6 · DEALING RANGE"
G_SES = "⏰ 7 · SESSIONS"
G_MTF = "🌐 8 · MULTI-TIMEFRAME"
G_SET = "🧩 9 · SETUPS (analytical)"
G_ALR = "🔔 10 · ALERTS & WEBHOOK"
G_ADV = "🛠 11 · ADVANCED"

// ── 0 · Profile
i_mode = input.enum(DisplayMode.normal, "Display Mode", tooltip = "Clean: minimum for execution. Normal: everyday analysis. Analysis: internal structure, swing labels, history. Debug: IDs, relevance scores, hidden objects, budget table. Custom: Analysis ceiling, the toggles below decide.\nThe mode is a ceiling: toggles can only hide what the mode allows. Calculations never change between modes.", group = G_PROF, display = display.none)
i_theme = input.enum(ThemeOpt.auto, "Theme", tooltip = "Auto detects dark or light from the chart background color.", group = G_PROF, display = display.none)
i_visibility = input.enum(Visibility.standard, "Visibility", tooltip = "Shifts the transparency of every zone, level and line: Subtle is lighter, Bold is denser. Candles stay on top either way.", group = G_PROF, display = display.none)
i_palette = input.enum(PaletteOpt.standard, "Palette", tooltip = "Color-blind safe replaces green/red with blue/orange (Okabe–Ito). Direction is always duplicated by arrows and position.", group = G_PROF, display = display.none)

// ── 1 · Visual experience
i_verb = input.enum(Verbosity.brief, "Label verbosity", tooltip = "Icons: arrows only for minor objects. Short: BOS↑, SSL ✕. Full: adds prices and displacement (shown in Analysis/Debug).", group = G_VIS, display = display.none)
// Setups indicator: no zones or history are drawn; display filters read by the shared engines are fixed
i_smartLabels = true
i_reduceMinorFvg = true
i_reduceMinorOb = true
i_panelSize = input.enum(PanelSize.normal, "Panel text size", tooltip = "Text size of the Context Ribbon and the Dashboard.", group = G_VIS, display = display.none)

// ── 2 · Structure
i_preset = input.enum(StructPreset.intraday, "Structure preset", tooltip = "Pivot lengths swing/internal: Scalp 5/2, Intraday 10/3, Swing 20/5. Manual uses the lengths below.", group = G_STR, display = display.none)
i_swLen = input.int(10, "Swing / internal length", minval = 2, maxval = 50, inline = "len", group = G_STR, display = display.none)
i_inLen = input.int(3, "", minval = 2, maxval = 20, inline = "len", tooltip = "Manual preset only. Internal is forced below swing.", group = G_STR, display = display.none)
i_brk = input.enum(BreakSrc.onClose, "Break confirmation", tooltip = "Close: a candle must close beyond the swing (default). Wick: any trade beyond counts.", group = G_STR, display = display.none)
i_eqTol = input.float(0.10, "Equal H/L tolerance (×ATR)", minval = 0.0, maxval = 1.0, step = 0.01, group = G_STR, display = display.none)
i_kLeg = input.float(1.5, "MSS min leg displacement (×ATR)", minval = 0.5, maxval = 5.0, step = 0.1, tooltip = "A CHoCH becomes MSS when its leg moved at least this much and left a fair value gap.", group = G_STR, display = display.none)

// ── 3 · Liquidity
i_maxSweepPen = input.float(1.0, "Max sweep penetration (×ATR)", minval = 0.1, maxval = 5.0, step = 0.1, tooltip = "Deeper runs beyond a level count as TAKEN (price accepted), not as a sweep.", group = G_LIQ, display = display.none)
i_reclaimBars = input.int(2, "Reclaim window (bars)", minval = 1, maxval = 10, tooltip = "After a close beyond the level, a close back inside within this many bars makes it a reclaim sweep.", group = G_LIQ, display = display.none)
i_oldAge = input.int(50, "Old level age (bars)", minval = 5, maxval = 500, tooltip = "Single swing levels older than this become major liquidity.", group = G_LIQ, display = display.none)
i_liqTol = input.float(0.15, "Equal levels tolerance (×ATR)", minval = 0.01, maxval = 1.0, step = 0.01, inline = "eq", group = G_LIQ, display = display.none)
i_eqMaxBars = input.int(100, "within bars", minval = 10, maxval = 1000, inline = "eq", group = G_LIQ, display = display.none)
i_tsMinAge = input.int(20, "Turtle soup: level age ≥", minval = 5, maxval = 200, inline = "ts", group = G_LIQ, display = display.none)
i_tsWindow = input.int(10, "CHoCH within", minval = 3, maxval = 50, inline = "ts", group = G_LIQ, display = display.none)
i_keyDay = input.bool(true, "PDH/PDL", inline = "key", group = G_LIQ, display = display.none)
i_keyWeek = input.bool(true, "PWH/PWL", inline = "key", group = G_LIQ, display = display.none)
i_keySess = input.bool(true, "Session H/L", inline = "key", tooltip = "Key levels: previous day/week high-low (intraday charts) and Asia/London/NY session high-low.", group = G_LIQ, display = display.none)

// ── 4 · Order blocks
i_obZone = input.enum(ObZone.bodyWick, "OB zone", tooltip = "Full: high–low of the OB candle. Body+Wick: body edge to the far wick. Body: body only. Oversized zones fall back to Body.", group = G_OB, display = display.none)
i_obReqDisp = input.bool(true, "Require displacement", inline = "obd", group = G_OB, display = display.none)
i_obDispMin = input.float(1.0, "min ×ATR", minval = 0.0, maxval = 5.0, step = 0.1, inline = "obd", group = G_OB, display = display.none)
i_obMin = input.float(0.25, "Size ×ATR  min", minval = 0.0, maxval = 2.0, step = 0.05, inline = "obs", group = G_OB, display = display.none)
i_obMax = input.float(3.0, "max", minval = 0.5, maxval = 10.0, step = 0.1, inline = "obs", group = G_OB, display = display.none)
i_volFilter = input.bool(false, "Volume filter", inline = "vol", group = G_OB, display = display.none)
i_volMult = input.float(1.5, "× SMA20", minval = 1.0, maxval = 5.0, step = 0.1, inline = "vol", tooltip = "Peak volume of the impulse must exceed SMA(volume, 20) × multiplier. Ignored when the symbol has no volume.", group = G_OB, display = display.none)
i_mitRule = input.enum(MitRule.half, "Mitigation rule", tooltip = "When an order block counts as mitigated: first touch, 50% (mean threshold) or full depth.", group = G_OB, display = display.none)
i_breakers = input.bool(true, "Breaker & Mitigation Block", tooltip = "A broken OB flips polarity: Breaker if its leg swept external liquidity, Mitigation Block otherwise.", group = G_OB, display = display.none)
i_obInternal = input.bool(false, "OB from internal breaks", group = G_OB, display = display.none)

// ── 5 · Fair value gaps
i_fvgMin = input.float(0.30, "Min size (×ATR)", minval = 0.0, maxval = 2.0, step = 0.05, group = G_FVG, display = display.none)
i_fillRule = input.enum(FillRule.wick, "Fill rule", group = G_FVG, display = display.none)
i_ignoreGaps = input.bool(true, "Ignore session gaps", tooltip = "Skip gaps created by overnight or weekend openings on intraday charts.", group = G_FVG, display = display.none)
i_fvgMidDir = input.bool(true, "Require middle candle direction", group = G_FVG, display = display.none)
i_ifvg = input.bool(true, "Inversion (IFVG)", tooltip = "A gap closed through by a body flips polarity.", group = G_FVG, display = display.none)

// ── 6 · Dealing range
i_oteLo = input.float(0.62, "OTE band", minval = 0.5, maxval = 0.95, step = 0.005, inline = "ote", group = G_RNG, display = display.none)
i_oteHi = input.float(0.79, "–", minval = 0.5, maxval = 0.95, step = 0.005, inline = "ote", tooltip = "Retracement band of the dealing range; 0.705 is drawn as the sweet spot.", group = G_RNG, display = display.none)

// ── 7 · Sessions
i_tz = input.string("America/New_York", "Session timezone", tooltip = "IANA timezone. Daylight saving time is handled automatically.", group = G_SES, display = display.none)
i_sesPreset = input.enum(SesPreset.ictNy, "Preset", tooltip = "ICT (NY): Asia 20:00–00:00, London KZ 02:00–05:00, NY AM KZ 07:00–10:00 in New York time.\nOriginal (UTC): v1 spec windows in UTC; they drift against New York and London when DST changes.\nCustom: the windows below, in the session timezone.", group = G_SES, display = display.none)
i_asiaOn = input.bool(true, "Asia", inline = "as", group = G_SES, display = display.none)
i_asiaS = input.session("2000-0000", "", inline = "as", group = G_SES, display = display.none)
i_lonOn = input.bool(true, "London KZ", inline = "lo", group = G_SES, display = display.none)
i_lonS = input.session("0200-0500", "", inline = "lo", group = G_SES, display = display.none)
i_nyOn = input.bool(true, "NY AM KZ", inline = "ny", group = G_SES, display = display.none)
i_nyS = input.session("0700-1000", "", inline = "ny", group = G_SES, display = display.none)
i_sesCustom = false
i_sesColAsia = #B39DDB
i_sesColLon = #4FC3F7
i_sesColNy = #FFB74D

// ── 8 · Multi-timeframe (HTF Feed, docs §4.7)
i_htfMode = input.enum(HtfMode.auto, "Higher timeframe", inline = "htf", tooltip = "Auto: ≤1m→15m, ≤5m→1H, ≤1H→4H, ≤4H→D, D→W, W→M. Manual: the timeframe on the right. Only confirmed HTF bars are used (no repaint).", group = G_MTF, display = display.none)
i_htfTf = input.timeframe("240", "", inline = "htf", group = G_MTF, display = display.none)
i_htfLen = input.int(5, "HTF swing length", minval = 2, maxval = 20, tooltip = "Pivot length on the higher timeframe.", group = G_MTF, display = display.none)
i_minHtfBars = input.int(100, "Min HTF bars for bias", minval = 20, maxval = 1000, tooltip = "With fewer confirmed higher-timeframe bars the HTF bias is treated as unknown (A.16) and the Ribbon shows ⚠.", group = G_MTF, display = display.none)
i_htfOB = true
i_htfFVG = false
i_htfLiq = input.bool(true, "HTF liquidity", inline = "hv", group = G_MTF, display = display.none)

// ── 9 · Setups (analytical: drawn and alerted, never executed)
i_setups = input.bool(true, "Setup engine", tooltip = "Sweep Reversal and Continuation setups with Entry / SL / TP, confluence score and grade. Analytical only: no orders are placed.", group = G_SET, display = display.none)
i_smRev = input.bool(true, "Sweep Reversal", inline = "sm", group = G_SET, display = display.none)
i_smCont = input.bool(true, "Continuation", inline = "sm", tooltip = "Sweep Reversal: liquidity sweep → CHoCH/MSS against it → FVG/OB in discount (long) / premium (short). Continuation: BOS with the trend → FVG/OB in discount / premium.", group = G_SET, display = display.none)
i_setPreset = input.enum(SetPreset.balanced, "Scoring preset", tooltip = "Balanced: READY from grade B. Conservative: READY from grade A, setups against the HTF bias or with an opposing HTF zone within 1R are rejected. Aggressive: READY from grade C, killzone and HTF POI count double, HTF-against penalty −1.0.", group = G_SET, display = display.none)
i_reqHtf = input.bool(false, "Require HTF alignment", inline = "req", group = G_SET, display = display.none)
i_reqKz = input.bool(false, "Require killzone", inline = "req", tooltip = "HTF alignment: only setups in the direction of the HTF bias. Killzone: the shift must happen in the London or NY killzone; READY setups expire when the killzone ends.", group = G_SET, display = display.none)
i_minGrade = input.enum(GradeOpt.b, "Min grade to show", tooltip = "The display mode sets a floor too: Clean shows A and A+, Normal B and above, Analysis and Debug all grades.", group = G_SET, display = display.none)
i_entryMode = input.enum(EntryMode.ce, "Entry", inline = "en", group = G_SET, display = display.none)
i_slMode = input.enum(SlMode.auto, "SL", inline = "en", tooltip = "Entry: CE = middle of the POI, Zone edge = its proximal edge, OTE 0.705 = the 0.705 level of the range if inside the POI (else CE). SL Auto: beyond the sweep (Sweep Reversal) or beyond the protected swing (Continuation).", group = G_SET, display = display.none)
i_slBufAtr = input.float(0.10, "SL buffer ×ATR", minval = 0.0, maxval = 1.0, step = 0.01, inline = "buf", group = G_SET, display = display.none)
i_slBufTicks = input.int(2, "ticks", minval = 0, maxval = 100, inline = "buf", tooltip = "The larger of the two is used, plus the spread.", group = G_SET, display = display.none)
i_tpMode = input.enum(TpMode.liq, "Targets", inline = "tp", group = G_SET, display = display.none)
i_minRR = input.float(2.0, "Min RR", minval = 0.5, maxval = 10.0, step = 0.1, inline = "tp", tooltip = "Liquidity: TP1 = nearest opposite liquidity at least 1R away, TP2 = major liquidity or the range extreme, TP3 = HTF or key level; missing targets fall back to 1R / 2R / 3R. RR is measured to the last target.", group = G_SET, display = display.none)
i_expiry = input.int(30, "Expiry (bars)", minval = 5, maxval = 500, inline = "ex", group = G_SET, display = display.none)
i_spread = input.int(0, "Spread (ticks)", minval = 0, maxval = 100, inline = "ex", tooltip = "Expiry: how long a setup may stay FORMING or READY. Spread is added to the SL buffer (bid charts).", group = G_SET, display = display.none)
i_nShift = input.int(20, "Shift window (bars)", minval = 3, maxval = 100, inline = "sh", group = G_SET, display = display.none)
i_shiftDisp = input.float(1.0, "min leg ×ATR", minval = 0.0, maxval = 5.0, step = 0.1, inline = "sh", tooltip = "Sweep Reversal: the CHoCH/BOS against the sweep must come within this many bars, with a leg of at least this size starting at the sweep. Continuation: minimum leg of the BOS.", group = G_SET, display = display.none)
i_maxSlAtr = input.float(3.0, "Max SL ×ATR", minval = 0.5, maxval = 10.0, step = 0.1, inline = "slr", group = G_SET, display = display.none)
i_minSlTicks = input.int(5, "Min SL ticks", minval = 1, maxval = 100, inline = "slr", group = G_SET, display = display.none)
i_beAfterTp1 = input.bool(true, "Move SL to entry after TP1", group = G_SET, display = display.none)
i_showPlan = input.bool(true, "Show Entry/SL/TP", inline = "sp", group = G_SET, display = display.none)
i_priceMarkers = input.bool(false, "Price-scale markers", inline = "sp", tooltip = "Entry, SL and TP1 of the focus setup as values on the price scale.", group = G_SET, display = display.none)
i_alertGrade = input.enum(GradeOpt.a, "Alert min grade", tooltip = "Setup READY alerts fire only from this grade.", group = G_SET, display = display.none)
i_showPath = input.bool(true, "Setup Path", tooltip = "① sweep → ② CHoCH / BOS → ③ POI → ④ entry, marked on the very sweep, break and zone that SMC Visualizer Pro draws (same cfg). Normal: the current setups; Analysis / Debug: also recent and past ones. Off in Clean.", group = G_SET, display = display.none)
i_setPanel = input.bool(true, "Setup panel", inline = "spn", group = G_SET, display = display.none)
i_alertFmt = input.enum(AlertFmt.plain, "Alert message", tooltip = "For one alert \"Any alert() function call\": one message per bar close with every event that passes the filters below. Text: one readable line. JSON: envelope smcvp.event v1 for a webhook (docs §12). Re-create the alert after changing settings.", group = G_ALR, display = display.none)
i_whScope = input.enum(WhScope.setups, "Events", inline = "whs", group = G_ALR, display = display.none)
i_whMinTier = input.int(2, "min tier", minval = 1, maxval = 4, inline = "whs", tooltip = "Setups: setup transitions from READY on, grade ≥ Alert min grade. Setups + key events: also swing BOS / CHoCH, major sweeps, HTF bias (tier 1). All events: everything up to this tier (1 = most important).", group = G_ALR, display = display.none)
i_whSnap = input.int(0, "Snapshot every N bars", minval = 0, maxval = 500, tooltip = "0 = off. Otherwise, on bars without events, the READY / ACTIVE setups are sent every N bars (heartbeat for the gateway).", group = G_ALR, display = display.none)
i_whTok = input.string("", "Sender id (tok)", tooltip = "Optional id the gateway can check. Not a broker secret.", group = G_ALR, display = display.none)
i_whMaxLen = input.int(4000, "Max message length", minval = 500, maxval = 20000, tooltip = "Events that do not fit are dropped; JSON then carries \"truncated\": true.", group = G_ALR, display = display.none)
i_setPanelPos = input.string("Bottom Right", "", options = ["Bottom Right", "Top Right", "Bottom Left", "Top Left", "Bottom Center"], inline = "spn", tooltip = "Setup, quality, plan and invalidation of the focus setup, and the settings signature cfg (must match SMC Visualizer Pro).", group = G_SET, display = display.none)

// ── 11 · Advanced
i_atrLen = input.int(14, "ATR length", minval = 5, maxval = 200, tooltip = "Volatility unit for every threshold expressed in ×ATR.", group = G_ADV, display = display.none)
i_kBody = input.float(1.0, "Displacement body ×ATR", minval = 0.3, maxval = 3.0, step = 0.1, inline = "disp", group = G_ADV, display = display.none)
i_minBodyRatio = input.float(0.6, "body/range", minval = 0.3, maxval = 0.95, step = 0.05, inline = "disp", group = G_ADV, display = display.none)
i_log = input.bool(false, "Debug: log events to Pine Logs", tooltip = "One CSV-like line per event. Used for golden-journal regression (docs §27.5).", group = G_ADV, display = display.none)

// ── Effective configuration (Config Resolver, docs §4.4)
swLen = switch i_preset
    StructPreset.scalp => 5
    StructPreset.intraday => 10
    StructPreset.swing => 20
    => i_swLen
inLenPreset = switch i_preset
    StructPreset.scalp => 2
    StructPreset.intraday => 3
    StructPreset.swing => 5
    => i_inLen
inLen = math.max(1, math.min(inLenPreset, swLen - 1))
warmBars = math.max(300, 20 * swLen)
oteLo = math.min(i_oteLo, i_oteHi)
oteHi = math.max(i_oteLo, i_oteHi)
obMin = math.min(i_obMin, i_obMax)
obMax = math.max(i_obMin, i_obMax)
sesTz = i_sesPreset == SesPreset.originalUtc ? "UTC" : i_tz

f_sesSpec(string ict, string utc, string custom) =>
    string s = i_sesPreset == SesPreset.ictNy ? ict : i_sesPreset == SesPreset.originalUtc ? utc : custom
    str.contains(s, ":") ? s : s + ":1234567"

specAsia = f_sesSpec("2000-0000", "0000-0600", i_asiaS)
specLon = f_sesSpec("0200-0500", "0700-1000", i_lonS)
specNy = f_sesSpec("0700-1000", "1200-1500", i_nyS)

// Engine settings signature (ADR-13): both indicators show it; equal numbers mean the engines run
// with the same settings, so the setups are built on the structure the main indicator draws.
// Session specs and the timezone enter by length only.
f_sigAdd(int acc, float v) =>
    (acc * 31 + int(math.round(nz(v) * 1000))) % 999983

f_cfgSig() =>
    int a = 7
    a := f_sigAdd(a, swLen)
    a := f_sigAdd(a, inLen)
    a := f_sigAdd(a, i_brk == BreakSrc.wick ? 1 : 0)
    a := f_sigAdd(a, i_eqTol)
    a := f_sigAdd(a, i_kLeg)
    a := f_sigAdd(a, i_maxSweepPen)
    a := f_sigAdd(a, i_reclaimBars)
    a := f_sigAdd(a, i_oldAge)
    a := f_sigAdd(a, i_liqTol)
    a := f_sigAdd(a, i_eqMaxBars)
    a := f_sigAdd(a, i_tsMinAge)
    a := f_sigAdd(a, i_tsWindow)
    a := f_sigAdd(a, (i_keyDay ? 1 : 0) + (i_keyWeek ? 2 : 0) + (i_keySess ? 4 : 0))
    a := f_sigAdd(a, i_obZone == ObZone.full ? 0 : i_obZone == ObZone.bodyWick ? 1 : 2)
    a := f_sigAdd(a, (i_obReqDisp ? 1 : 0) + (i_volFilter ? 2 : 0) + (i_breakers ? 4 : 0) + (i_obInternal ? 8 : 0))
    a := f_sigAdd(a, i_obDispMin)
    a := f_sigAdd(a, obMin)
    a := f_sigAdd(a, obMax)
    a := f_sigAdd(a, i_volMult)
    a := f_sigAdd(a, i_mitRule == MitRule.touch ? 0 : i_mitRule == MitRule.half ? 1 : 2)
    a := f_sigAdd(a, i_fvgMin)
    a := f_sigAdd(a, i_fillRule == FillRule.wick ? 0 : i_fillRule == FillRule.closeEdge ? 1 : 2)
    a := f_sigAdd(a, (i_ignoreGaps ? 1 : 0) + (i_fvgMidDir ? 2 : 0) + (i_ifvg ? 4 : 0))
    a := f_sigAdd(a, oteLo)
    a := f_sigAdd(a, oteHi)
    a := f_sigAdd(a, i_sesPreset == SesPreset.ictNy ? 0 : i_sesPreset == SesPreset.originalUtc ? 1 : 2)
    a := f_sigAdd(a, (i_asiaOn ? 1 : 0) + (i_lonOn ? 2 : 0) + (i_nyOn ? 4 : 0))
    a := f_sigAdd(a, str.length(sesTz) * 10000 + str.length(specAsia) * 100 + str.length(specLon) * 10 + str.length(specNy))
    a := f_sigAdd(a, i_htfMode == HtfMode.auto ? 0 : i_htfMode == HtfMode.manual ? 1 : 2)
    a := f_sigAdd(a, timeframe.in_seconds(i_htfTf) / 60)
    a := f_sigAdd(a, i_htfLen)
    a := f_sigAdd(a, i_minHtfBars)
    a := f_sigAdd(a, i_htfLiq ? 1 : 0)
    a := f_sigAdd(a, i_atrLen)
    a := f_sigAdd(a, i_kBody)
    a := f_sigAdd(a, i_minBodyRatio)
    a

var int cfgSig = f_cfgSig()

// Display mode ceilings (docs §15.3, §19.2). Recent view uses structEvents / sweptShow / sessions;
// visible-range view uses the *Win caps, split evenly across time segments so the whole
// screen is covered. Pool sizes keep every mode within the 500-object limits.
f_modeCfg(DisplayMode m) =>
    switch m
        DisplayMode.clean => ModeCfg.new(structEvents = 1, internalEvents = 0, swingLabels = false, zonesPerSide = 1, majorPerSide = 1, minorPerSide = 0, sweptShow = 1, distMax = 3.0, theta = 0.55, ttl = 0, hist = 500, mitigated = false, pdCap = 1, gauge = false, sessions = 0, dashboard = false, labelLevel = 1, debug = false, structWin = 6, internalWin = 0, swingLabelWin = 0, sweepWin = 6, sessWin = 0, rangeWin = 1, poolZone = 24, poolWash = 4, poolLvl = 30, poolStr = 14, poolLab = 40, htfStructEvents = 1, htfStructWin = 3, keyCap = 2, gradeFloor = 2, setupPast = 0, poolSetBox = 4, poolSetLine = 8, poolSetLab = 8)
        DisplayMode.normal => ModeCfg.new(structEvents = 3, internalEvents = 0, swingLabels = false, zonesPerSide = 2, majorPerSide = 2, minorPerSide = 1, sweptShow = 3, distMax = 6.0, theta = 0.40, ttl = 10, hist = 1500, mitigated = true, pdCap = 2, gauge = true, sessions = 4, dashboard = true, labelLevel = 2, debug = false, structWin = 36, internalWin = 0, swingLabelWin = 0, sweepWin = 30, sessWin = 60, rangeWin = 6, poolZone = 64, poolWash = 64, poolLvl = 100, poolStr = 56, poolLab = 190, htfStructEvents = 2, htfStructWin = 8, keyCap = 3, gradeFloor = 1, setupPast = 6, poolSetBox = 40, poolSetLine = 100, poolSetLab = 60)
        DisplayMode.analysis => ModeCfg.new(structEvents = 15, internalEvents = 15, swingLabels = true, zonesPerSide = 6, majorPerSide = 6, minorPerSide = 4, sweptShow = 15, distMax = 12.0, theta = 0.25, ttl = 50, hist = 5000, mitigated = true, pdCap = 2, gauge = true, sessions = 20, dashboard = true, labelLevel = 3, debug = false, structWin = 80, internalWin = 60, swingLabelWin = 60, sweepWin = 60, sessWin = 80, rangeWin = 12, poolZone = 140, poolWash = 90, poolLvl = 150, poolStr = 160, poolLab = 400, htfStructEvents = 6, htfStructWin = 16, keyCap = 4, gradeFloor = 0, setupPast = 10, poolSetBox = 60, poolSetLine = 160, poolSetLab = 100)
        DisplayMode.debug => ModeCfg.new(structEvents = 30, internalEvents = 30, swingLabels = true, zonesPerSide = 20, majorPerSide = 20, minorPerSide = 20, sweptShow = 30, distMax = 1000.0, theta = 0.0, ttl = 100000, hist = 100000, mitigated = true, pdCap = 3, gauge = true, sessions = 30, dashboard = true, labelLevel = 3, debug = true, structWin = 80, internalWin = 60, swingLabelWin = 60, sweepWin = 80, sessWin = 80, rangeWin = 12, poolZone = 180, poolWash = 90, poolLvl = 150, poolStr = 160, poolLab = 460, htfStructEvents = 10, htfStructWin = 20, keyCap = 10, gradeFloor = 0, setupPast = 10, poolSetBox = 60, poolSetLine = 160, poolSetLab = 100)
        => ModeCfg.new(structEvents = 15, internalEvents = 15, swingLabels = true, zonesPerSide = 6, majorPerSide = 6, minorPerSide = 4, sweptShow = 15, distMax = 12.0, theta = 0.25, ttl = 50, hist = 5000, mitigated = true, pdCap = 3, gauge = true, sessions = 20, dashboard = true, labelLevel = 3, debug = false, structWin = 80, internalWin = 60, swingLabelWin = 60, sweepWin = 60, sessWin = 80, rangeWin = 12, poolZone = 140, poolWash = 90, poolLvl = 150, poolStr = 160, poolLab = 400, htfStructEvents = 6, htfStructWin = 16, keyCap = 4, gradeFloor = 0, setupPast = 10, poolSetBox = 60, poolSetLine = 160, poolSetLab = 100)

var ModeCfg mc = f_modeCfg(i_mode)

// Effective visibility: mode ceiling AND user toggle (ADR-09)
verbLevel = switch i_verb
    Verbosity.icons => 0
    Verbosity.brief => 1
    => 3
labelLvl = math.min(verbLevel, mc.labelLevel)
// Setups indicator: zone filters for the (unused) history archive, and the visible-range view
// for past setups in Analysis / Debug
vOB = true
vFVG = true
vHistory = true
histDepth = mc.hist
// Setups: READY threshold by preset (§9.6), display floor = mode floor and user choice (ADR-09)
f_gradeOf(GradeOpt g) =>
    switch g
        GradeOpt.c => GR_C
        GradeOpt.b => GR_B
        GradeOpt.a => GR_A
        => GR_AP
setReadyGrade = i_setPreset == SetPreset.conservative ? GR_A : i_setPreset == SetPreset.aggressive ? GR_C : GR_B
setShowGrade = mc.debug ? GR_C : math.max(mc.gradeFloor, f_gradeOf(i_minGrade))
setAlertGrade = f_gradeOf(i_alertGrade)
vPlan = i_setups and i_showPlan
panelSz = switch i_panelSize
    PanelSize.small => size.small
    PanelSize.large => size.large
    => size.normal

// ═══ 04 · CORE: IDS, EVENT BUS, HELPERS ═════════════════════════════════════════
// Engines emit events only on confirmed bars (T-3). Sinks (visual, alerts, panels) read
// barEvents / history and never write back (T-1).

f_nextId(Core c) =>
    c.nextId := c.nextId + 1
    c.nextId

f_evName(int typ) =>
    switch typ
        EV_SWING => "SWING"
        EV_BOS => "BOS"
        EV_CHOCH => "CHOCH"
        EV_DISP => "DISPLACEMENT"
        EV_LIQ_NEW => "LIQ_NEW"
        EV_LIQ_EQ => "LIQ_EQ"
        EV_LIQ_SWEPT => "LIQ_SWEPT"
        EV_LIQ_TAKEN => "LIQ_TAKEN"
        EV_LIQ_EXPIRED => "LIQ_EXPIRED"
        EV_KEY_SET => "KEYLEVEL_SET"
        EV_ZONE_NEW => "ZONE_NEW"
        EV_ZONE_TOUCHED => "ZONE_TOUCHED"
        EV_ZONE_MITIGATED => "ZONE_MITIGATED"
        EV_ZONE_CE => "ZONE_CE"
        EV_ZONE_FILLED => "ZONE_FILLED"
        EV_ZONE_BROKEN => "ZONE_BROKEN"
        EV_ZONE_CONVERTED => "ZONE_CONVERTED"
        EV_ZONE_EXPIRED => "ZONE_EXPIRED"
        EV_RANGE_NEW => "RANGE_NEW"
        EV_PD_ENTER => "PD_ENTER"
        EV_OTE_ENTER => "OTE_ENTER"
        EV_SESSION_START => "SESSION_START"
        EV_SESSION_END => "SESSION_END"
        EV_HTF_BIAS => "HTF_BIAS"
        EV_SETUP_FORMING => "SETUP_FORMING"
        EV_SETUP_READY => "SETUP_READY"
        EV_SETUP_TRIGGERED => "SETUP_TRIGGERED"
        EV_SETUP_TP => "SETUP_TP"
        EV_SETUP_SL => "SETUP_SL"
        EV_SETUP_INVALID => "SETUP_INVALID"
        EV_SETUP_EXPIRED => "SETUP_EXPIRED"
        EV_SETUP_MISSED => "SETUP_MISSED"
        EV_SYS_WARM => "SYS_WARM"
        EV_SYS_WARN => "SYS_WARN"
        => "EV" + str.tostring(typ)

f_kindTag(int k) =>
    switch k
        ZK_OB => "OB"
        ZK_BB => "BB"
        ZK_MB => "MB"
        ZK_FVG => "FVG"
        ZK_IFVG => "IFVG"
        => "ZONE"

f_zoneStateName(int s) =>
    switch s
        ZS_FRESH => "FRESH"
        ZS_TOUCHED => "TOUCHED"
        ZS_MITIGATED => "MITIGATED"
        ZS_PARTIAL => "PARTIAL"
        ZS_CE => "CE"
        ZS_FILLED => "FILLED"
        ZS_CONVERTED => "CONVERTED"
        ZS_INVALID => "INVALID"
        ZS_EXPIRED => "EXPIRED"
        => "?"

f_arrow(int d) =>
    d > 0 ? "↑" : d < 0 ? "↓" : "·"

f_px(float p) =>
    str.tostring(p, format.mintick)

f_timeStr(int t) =>
    str.format_time(t, "yyyy-MM-dd HH:mm", sesTz)

// Emit an event into the bar queue and the history ring (docs §6.3). tf = TF slot of the source.
f_emit(Core c, int typ, int dir, float price, int ref, int cause, int tier, float v1 = na, float v2 = na, float v3 = na, string s1 = "", int tf = 0) =>
    Event e = Event.new(id = f_nextId(c), typ = typ, dir = dir, tf = tf, bar = bar_index, t = time, price = price, ref = ref, cause = cause, tier = tier, v1 = v1, v2 = v2, v3 = v3, s1 = s1)
    c.barEvents.push(e)
    c.history.push(e)
    if c.history.size() > c.histCap
        c.history.shift()
    if (typ == EV_BOS or typ == EV_CHOCH) and v1 == LV_SWG
        if tf == TF_CHART
            c.lastStruct := e
        else
            c.lastHtfStruct := e
    if typ == EV_LIQ_SWEPT or (typ == EV_LIQ_TAKEN and v3 == 1)
        c.lastLiq := e
    e

// True if the current bar emitted an event of this type (dir 0 = any; v1Eq na = any; tf -1 = any)
f_evFlag(Core c, int typ, int dir, float v1Eq, int tf = -1) =>
    bool found = false
    for e in c.barEvents
        if e.typ == typ and (dir == 0 or e.dir == dir) and (na(v1Eq) or e.v1 == v1Eq) and (tf < 0 or e.tf == tf)
            found := true
            break
    found

// Debug journal (i_log): one line per event of the bar, in emission order. Called once per confirmed bar.
f_logEvents(Core c) =>
    for e in c.barEvents
        log.info(str.format("EV|{0}|{1}|{2}|tf={3}|dir={4}|px={5}|ref={6}|cause={7}|tier={8}|v1={9}|v2={10}|v3={11}|{12}", e.id, f_evName(e.typ), f_timeStr(e.t), e.tf, e.dir, f_px(e.price), e.ref, e.cause, e.tier, e.v1, e.v2, e.v3, e.s1))
    true

// ═══ 10 · DATA ENGINE ═══════════════════════════════════════════════════════════
// Per-bar measurements shared by all engines (Appendix A.1, A.6, A.10). Everything that
// needs history (ta.*, request.*, pivots) is computed here at global scope on every bar,
// so engine functions can read it safely with the [] operator.

// Volatility unit (VU) and candle geometry
float atrRaw = ta.atr(i_atrLen)
float vu = na(atrRaw) or atrRaw <= 0 ? math.max(high - low, syminfo.mintick) : atrRaw
float body = math.abs(close - open)
float barRange = high - low
float bodyRatio = body / math.max(barRange, syminfo.mintick)
bool isDispUp = close > open and body >= i_kBody * vu and bodyRatio >= i_minBodyRatio
bool isDispDn = close < open and body >= i_kBody * vu and bodyRatio >= i_minBodyRatio

// Bar timing and session gaps (A.1)
int barMs = timeframe.in_seconds() * 1000
bool isGapBar = timeframe.isintraday and bar_index > 0 and (time - time[1]) > 1.5 * barMs

// Volume (auto-degrades when the symbol has none, A.7)
float volSma = ta.sma(volume, 20)
float volRatio = not na(volSma) and volSma > 0 ? volume / volSma : na
bool hasVolume = ta.cum(nz(volume)) > 0

// Raw fair value gap patterns on the current (third) candle (A.10)
bool gapAround = i_ignoreGaps and (isGapBar or isGapBar[1])
bool fvgUp = bar_index >= 2 and low > high[2] and (not i_fvgMidDir or close[1] > open[1]) and (low - high[2]) >= i_fvgMin * vu and not gapAround
bool fvgDn = bar_index >= 2 and high < low[2] and (not i_fvgMidDir or close[1] < open[1]) and (low[2] - high) >= i_fvgMin * vu and not gapAround
bool dispFvgUp = fvgUp and isDispUp[1]
bool dispFvgDn = fvgDn and isDispDn[1]

// Pivots for both structure levels (A.2)
float phS = ta.pivothigh(high, swLen, swLen)
float plS = ta.pivotlow(low, swLen, swLen)
float phI = ta.pivothigh(high, inLen, inLen)
float plI = ta.pivotlow(low, inLen, inLen)

// Sessions clock (A.15): tracked on intraday charts up to 1H
bool sesOk = timeframe.isintraday and timeframe.in_seconds() <= 3600
// The session clock is read only where it can be used: not on charts above 1H and not for switched-off sessions
int tAsia = sesOk and i_asiaOn ? time(timeframe.period, specAsia, sesTz) : na
int tLon = sesOk and i_lonOn ? time(timeframe.period, specLon, sesTz) : na
int tNy = sesOk and i_nyOn ? time(timeframe.period, specNy, sesTz) : na
bool inAsia = sesOk and i_asiaOn and not na(tAsia)
bool inLon = sesOk and i_lonOn and not na(tLon)
bool inNy = sesOk and i_nyOn and not na(tNy)

// Key levels from confirmed D / W bars: the [1] + lookahead_on idiom never repaints (§4.7)
[pdH, pdL, pdT] = request.security(syminfo.tickerid, "D", [high[1], low[1], time[1]], lookahead = barmerge.lookahead_on)
[pwH, pwL, pwT] = request.security(syminfo.tickerid, "W", [high[1], low[1], time[1]], lookahead = barmerge.lookahead_on)
bool keyDayOk = i_keyDay and timeframe.isintraday
bool keyWeekOk = i_keyWeek and timeframe.in_seconds() < 604800
bool newDay = not na(pdT) and pdT != nz(pdT[1])
bool newWeek = not na(pwT) and pwT != nz(pwT[1])

// Data health (T-10, T-14)
bool nonStdChart = not chart.is_standard

// Buffers for dynamic lookbacks; every offset in the engines stays below MAXBACK_GUARD
max_bars_back(time, MAXBACK)
max_bars_back(open, MAXBACK)
max_bars_back(high, MAXBACK)
max_bars_back(low, MAXBACK)
max_bars_back(close, MAXBACK)
max_bars_back(volRatio, MAXBACK)
max_bars_back(isDispUp, MAXBACK)
max_bars_back(isDispDn, MAXBACK)

// ═══ 11 · HTF FEED ══════════════════════════════════════════════════════════════
// Higher-timeframe structure, pivots, order blocks and fair value gaps (docs §4.7, P5).
//
// Detection runs inside request.security on the HTF series, so it sees the full HTF history
// (deep bias even on low chart timeframes, risk P-06). Every value is returned with a [1]
// offset and lookahead_on: the chart only ever sees the last CONFIRMED HTF bar, identically
// on history and in realtime (no repaint, AC-25).
//
// Deviation from ADR-03 (recorded in CHANGELOG): detection here is a compact re-statement of
// A.2/A.4/A.7/A.10 written with fixed-length lookbacks and a small candle ring only, because
// the chart engines rely on dynamic history offsets that the HTF context cannot size. HTF order
// blocks follow the A.7 candle window but skip the integrity and volume filters; "Require
// displacement" maps to "the leg had a displacement bar". Lifecycle (touch, mitigation,
// conversion, sweeps) is NOT duplicated: HTF objects are ingested into the shared registries
// and run through the same chart-side engines.

// Auto mapping (docs §4.7): ≤1m→15m, ≤5m→1H, ≤1H→4H, ≤4H→D, D→W, W→M, M→none
f_autoHtf() =>
    int s = timeframe.in_seconds()
    s <= 60 ? "15" : s <= 300 ? "60" : s <= 3600 ? "240" : s <= 14400 ? "D" : s <= 86400 ? "W" : s <= 604800 ? "M" : ""

f_tfLabel(int sec) =>
    sec < 3600 ? str.tostring(math.round(sec / 60)) + "m" : sec < 86400 ? str.tostring(math.round(sec / 3600)) + "H" : sec < 604800 ? "D" : sec < 2419200 ? "W" : "M"

string htfTf = i_htfMode == HtfMode.off ? "" : i_htfMode == HtfMode.manual ? i_htfTf : f_autoHtf()
int chartSec = timeframe.in_seconds()
int htfSec = timeframe.in_seconds(htfTf == "" ? timeframe.period : htfTf)
bool htfOk = htfTf != "" and htfSec > chartSec
// A manual HTF that is not above the chart timeframe is not requested at all (warning in the panels)
bool htfBadCfg = i_htfMode == HtfMode.manual and not htfOk
string htfReq = htfOk ? htfTf : timeframe.period
string htfLabel = f_tfLabel(htfSec)

f_htfPrefix(int tf) =>
    tf != TF_CHART ? "◆" + htfLabel + " " : ""
// HTF objects count their age in HTF bars (hBorn vs hLastBars below); distance limits scale
// with the root of the TF ratio
float htfDistMult = htfOk ? math.max(3.0, math.sqrt(htfSec / chartSec)) : 1.0

// Order block geometry from a candle, same rules as A.7 step 4–5 (zone mode, size filter)
f_obGeom(int dir, float o, float h, float l, float c, float atr) =>
    float top = math.max(o, c)
    float bot = math.min(o, c)
    if i_obZone == ObZone.full
        top := h
        bot := l
    else if i_obZone == ObZone.bodyWick
        top := dir == 1 ? math.max(o, c) : h
        bot := dir == 1 ? l : math.min(o, c)
    if top - bot > obMax * atr and i_obZone != ObZone.body
        top := math.max(o, c)
        bot := math.min(o, c)
    float sz = top - bot
    bool ok = not na(atr) and sz > 0 and sz >= obMin * atr and sz <= obMax * atr
    [top, bot, ok]

// Order block candidates are kept as [open, high, low, close, time] (time stored as float)
f_candSet(array<float> cd, float o, float h, float l, float c, int t) =>
    cd.set(0, o)
    cd.set(1, h)
    cd.set(2, l)
    cd.set(3, c)
    cd.set(4, t)
    true

f_candRing(array<float> cd, array<float> rO, array<float> rH, array<float> rL, array<float> rC, array<int> rT, int k) =>
    f_candSet(cd, rO.get(k), rH.get(k), rL.get(k), rC.get(k), rT.get(k))

f_candCopy(array<float> dst, array<float> src) =>
    for i = 0 to 4
        dst.set(i, src.get(i))
    true

// A.7 window: the last opposite candle scanning back from k0 to origin − OB_NPRE, else the
// origin candle. rD codes the ring candles: ±2 displacement, ±1 plain bull/bear, 0 doji.
f_ringPick(array<int> rD, int k0, int o, int dir) =>
    int j = o
    int lo = math.max(0, o - OB_NPRE)
    if k0 >= lo
        for k = k0 to lo
            int dk = rD.get(k)
            if dir == 1 ? dk < 0 : dk > 0
                j := k
                break
    j

// Evaluated on every HTF bar inside request.security. Returns the previous (confirmed) HTF
// bar's state: trend, last break and last order block per direction, last pivots, last fair
// value gap, plus the open time and index of the current HTF bar.
f_htfState(int len) =>
    float atr = ta.atr(i_atrLen)
    float ph = ta.pivothigh(high, len, len)
    float pl = ta.pivotlow(low, len, len)
    int pivT = time[len]
    float bodyH = math.abs(close - open)
    bool ratioOk = bodyH / math.max(high - low, syminfo.mintick) >= i_minBodyRatio
    bool dUp = close > open and not na(atr) and bodyH >= i_kBody * atr and ratioOk
    bool dDn = close < open and not na(atr) and bodyH >= i_kBody * atr and ratioOk
    bool isBear = close < open
    bool isBull = close > open
    // ring of the last len + 4 candles, current bar included: leg rebuilds at pivot confirmation
    var array<float> rO = array.new<float>()
    var array<float> rH = array.new<float>()
    var array<float> rL = array.new<float>()
    var array<float> rC = array.new<float>()
    var array<int> rT = array.new<int>()
    var array<int> rD = array.new<int>()
    rO.push(open)
    rH.push(high)
    rL.push(low)
    rC.push(close)
    rT.push(time)
    rD.push(dUp ? 2 : dDn ? -2 : isBull ? 1 : isBear ? -1 : 0)
    if rO.size() > len + 4
        rO.shift()
        rH.shift()
        rL.shift()
        rC.shift()
        rT.shift()
        rD.shift()
    int n = rO.size()
    // structure
    var int trend = 0
    var float refH = na
    var int refHT = na
    var bool refHDone = true
    var float refL = na
    var int refLT = na
    var bool refLDone = true
    // breaks, one channel per direction (an outside bar can break both sides in wick mode)
    var int buSeq = 0
    var int buKind = 0
    var float buPx = na
    var int buT = na
    var int buSwT = na
    var int bdSeq = 0
    var int bdKind = 0
    var float bdPx = na
    var int bdT = na
    var int bdSwT = na
    var float phP = na
    var int phT = na
    var float plP = na
    var int plT = na
    // legs (A.7): origin, displacement seen (d), plain impulse candle seen (fallback d).
    // cu / cd: last opposite candle before the first displacement bar of the leg;
    // cb / ce: last opposite candle before the first candle in the leg direction.
    var float upOrig = na
    var bool upImp = false
    var bool upBull = false
    var array<float> cu = array.new<float>(5, na)
    var array<float> cb = array.new<float>(5, na)
    var float dnOrig = na
    var bool dnImp = false
    var bool dnBear = false
    var array<float> cd = array.new<float>(5, na)
    var array<float> ce = array.new<float>(5, na)
    // outputs: last order block per direction and last fair value gap
    var int ouSeq = 0
    var float ouTop = na
    var float ouBot = na
    var int ouT = na
    var int odSeq = 0
    var float odTop = na
    var float odBot = na
    var int odT = na
    var int fvgSeq = 0
    var int fvgDir = 0
    var float fvgTop = na
    var float fvgBot = na
    var int fvgT = na
    // 1 · leg tracking (bullish leg = since the reference high; bearish mirror). The fallback
    // candidates cb / ce take the current candle only after the break checks (step 5), so a
    // breaking candle never becomes its own order block.
    bool upNew = false
    bool dnNew = false
    if not na(upOrig)
        if low < upOrig
            upNew := true
            upOrig := low
            upImp := false
            upBull := false
            f_candRing(cu, rO, rH, rL, rC, rT, f_ringPick(rD, n - 1, n - 1, 1))
            f_candCopy(cb, cu)
        else if not upImp
            if dUp
                upImp := true
            else if isBear
                f_candSet(cu, open, high, low, close, time)
    if not na(dnOrig)
        if high > dnOrig
            dnNew := true
            dnOrig := high
            dnImp := false
            dnBear := false
            f_candRing(cd, rO, rH, rL, rC, rT, f_ringPick(rD, n - 1, n - 1, -1))
            f_candCopy(ce, cd)
        else if not dnImp
            if dDn
                dnImp := true
            else if isBull
                f_candSet(cd, open, high, low, close, time)
    // 2 · confirmed pivots become the new references; the leg is rebuilt from the pivot window
    if not na(ph)
        phP := ph
        phT := pivT
        refH := ph
        refHT := pivT
        refHDone := false
        int o = n - 1
        for k = n - 1 to math.max(0, n - 1 - len)
            if rL.get(k) < rL.get(o)
                o := k
        int d = -1
        int fb = -1
        if o < n - 1
            for k = o + 1 to n - 1
                int dk = rD.get(k)
                if fb < 0 and dk > 0
                    fb := k
                if d < 0 and dk == 2
                    d := k
        upNew := true
        upOrig := rL.get(o)
        upImp := d >= 0
        upBull := fb >= 0
        f_candRing(cu, rO, rH, rL, rC, rT, f_ringPick(rD, d >= 0 ? d - 1 : n - 1, o, 1))
        f_candRing(cb, rO, rH, rL, rC, rT, f_ringPick(rD, fb >= 0 ? fb - 1 : n - 1, o, 1))
    if not na(pl)
        plP := pl
        plT := pivT
        refL := pl
        refLT := pivT
        refLDone := false
        int o = n - 1
        for k = n - 1 to math.max(0, n - 1 - len)
            if rH.get(k) > rH.get(o)
                o := k
        int d = -1
        int fb = -1
        if o < n - 1
            for k = o + 1 to n - 1
                int dk = rD.get(k)
                if fb < 0 and dk < 0
                    fb := k
                if d < 0 and dk == -2
                    d := k
        dnNew := true
        dnOrig := rH.get(o)
        dnImp := d >= 0
        dnBear := fb >= 0
        f_candRing(cd, rO, rH, rL, rC, rT, f_ringPick(rD, d >= 0 ? d - 1 : n - 1, o, -1))
        f_candRing(ce, rO, rH, rL, rC, rT, f_ringPick(rD, fb >= 0 ? fb - 1 : n - 1, o, -1))
    // 3 · breaks (A.4) and the order block of the breaking leg (A.7). The break time is the
    // close of the breaking HTF bar, so lines end where the break was confirmed. A candidate
    // that is the breaking candle itself (outside bar that is also the new leg origin) is
    // never used: the chart engine's window ends at d − 1.
    float srcUp = i_brk == BreakSrc.wick ? high : close
    float srcDn = i_brk == BreakSrc.wick ? low : close
    if not refHDone and not na(refH) and srcUp > refH
        buKind := trend == -1 ? BK_CHOCH : BK_BOS
        buPx := refH
        buT := nz(time_close, time)
        buSwT := refHT
        buSeq += 1
        trend := 1
        refHDone := true
        array<float> cand = upImp ? cu : cb
        if not na(cand.get(4)) and int(cand.get(4)) != time and (upImp or not i_obReqDisp)
            [gTop, gBot, gOk] = f_obGeom(1, cand.get(0), cand.get(1), cand.get(2), cand.get(3), atr)
            if gOk
                ouSeq += 1
                ouTop := gTop
                ouBot := gBot
                ouT := int(cand.get(4))
    if not refLDone and not na(refL) and srcDn < refL
        bdKind := trend == 1 ? BK_CHOCH : BK_BOS
        bdPx := refL
        bdT := nz(time_close, time)
        bdSwT := refLT
        bdSeq += 1
        trend := -1
        refLDone := true
        array<float> cand = dnImp ? cd : ce
        if not na(cand.get(4)) and int(cand.get(4)) != time and (dnImp or not i_obReqDisp)
            [gTop, gBot, gOk] = f_obGeom(-1, cand.get(0), cand.get(1), cand.get(2), cand.get(3), atr)
            if gOk
                odSeq += 1
                odTop := gTop
                odBot := gBot
                odT := int(cand.get(4))
    // 4 · fair value gaps (A.10) on the HTF candles
    if bar_index >= 2 and not na(atr)
        if low > high[2] and (not i_fvgMidDir or close[1] > open[1]) and low - high[2] >= i_fvgMin * atr
            fvgSeq += 1
            fvgDir := 1
            fvgTop := low
            fvgBot := high[2]
            fvgT := time[2]
        else if high < low[2] and (not i_fvgMidDir or close[1] < open[1]) and low[2] - high >= i_fvgMin * atr
            fvgSeq += 1
            fvgDir := -1
            fvgTop := low[2]
            fvgBot := high
            fvgT := time[2]
    // 5 · fallback candidates: last opposite candle before the first candle in the leg direction
    if not na(upOrig) and not upNew and not upBull
        if isBull
            upBull := true
        else if isBear
            f_candSet(cb, open, high, low, close, time)
    if not na(dnOrig) and not dnNew and not dnBear
        if isBear
            dnBear := true
        else if isBull
            f_candSet(ce, open, high, low, close, time)
    [trend[1], buSeq[1], buKind[1], buPx[1], buT[1], buSwT[1], bdSeq[1], bdKind[1], bdPx[1], bdT[1], bdSwT[1], phP[1], phT[1], plP[1], plT[1], ouSeq[1], ouTop[1], ouBot[1], ouT[1], odSeq[1], odTop[1], odBot[1], odT[1], fvgSeq[1], fvgDir[1], fvgTop[1], fvgBot[1], fvgT[1], time, bar_index]

// Confirmed HTF state on every chart bar. The open time and index of the current HTF bar are
// known when it opens, so they need no offset.
[hTrend, hBuSeq, hBuKind, hBuPx, hBuT, hBuSwT, hBdSeq, hBdKind, hBdPx, hBdT, hBdSwT, hPhP, hPhT, hPlP, hPlT, hOuSeq, hOuTop, hOuBot, hOuT, hOdSeq, hOdTop, hOdBot, hOdT, hFvgSeq, hFvgDir, hFvgTop, hFvgBot, hFvgT, hBarT, hBars] = request.security(syminfo.tickerid, htfReq, f_htfState(i_htfLen), lookahead = barmerge.lookahead_on) // no-repaint: [1] inside

// A chart bar that opened before the current HTF bar straddles an HTF boundary (W→M, 45m→4H).
// It keeps the previous state, so realtime and history ingest on the same bar (AC-25).
bool htfHold = not na(hBarT) and time < hBarT
bool htfStep = htfOk and not htfHold
var int hLastTrend = 0
var int hLastBu = 0
var int hLastBd = 0
var int hLastPhT = 0
var int hLastPlT = 0
var int hLastOu = 0
var int hLastOd = 0
var int hLastFvg = 0
var int hLastBars = 0
// Change detection: each HTF object is ingested once, on the first chart bar after its HTF bar closed
bool htfNewBu = htfStep and nz(hBuSeq) > 0 and nz(hBuSeq) != hLastBu
bool htfNewBd = htfStep and nz(hBdSeq) > 0 and nz(hBdSeq) != hLastBd
bool htfNewPh = htfStep and nz(hPhT) > 0 and nz(hPhT) != hLastPhT
bool htfNewPl = htfStep and nz(hPlT) > 0 and nz(hPlT) != hLastPlT
bool htfNewOu = htfStep and nz(hOuSeq) > 0 and nz(hOuSeq) != hLastOu
bool htfNewOd = htfStep and nz(hOdSeq) > 0 and nz(hOdSeq) != hLastOd
bool htfNewFvg = htfStep and nz(hFvgSeq) > 0 and nz(hFvgSeq) != hLastFvg
if htfStep
    hLastTrend := nz(hTrend)
    hLastBu := nz(hBuSeq)
    hLastBd := nz(hBdSeq)
    hLastPhT := nz(hPhT)
    hLastPlT := nz(hPlT)
    hLastOu := nz(hOuSeq)
    hLastOd := nz(hOdSeq)
    hLastFvg := nz(hFvgSeq)
    hLastBars := nz(hBars)
// A.16 htfReliable: with too little HTF history the bias is unknown
bool htfLowHist = htfOk and hLastBars < i_minHtfBars
int hBias = htfOk and not htfLowHist ? hLastTrend : 0
bool htfNewBias = htfOk and hBias != nz(hBias[1])

// ═══ 20 · STRUCTURE ENGINE ══════════════════════════════════════════════════════
// Swings, HH/HL/LH/LL, BOS / CHoCH / MSS, protected levels (Appendix A.2–A.5, §7.1).
// One StructState per level (internal, swing). Runs once per confirmed bar.

f_newStruct(int lvl, int len) =>
    StructState.new(lvl = lvl, len = len, swings = array.new<Swing>(), breaks = array.new<Brk>())

// Register a confirmed pivot and classify it against the previous pivot of the same side (A.3)
f_makeSwing(Core c, StructState st, int side, float price) =>
    Swing prev = side == 1 ? st.lastHigh : st.lastLow
    float tol = i_eqTol * vu
    string tg = side == 1 ? "H" : "L"
    bool eq = false
    if not na(prev)
        float d = price - prev.price
        if math.abs(d) <= tol
            eq := true
            tg := side == 1 ? "EQH" : "EQL"
        else
            tg := side == 1 ? (d > 0 ? "HH" : "LH") : (d > 0 ? "HL" : "LL")
    Swing sw = Swing.new(id = f_nextId(c), side = side, lvl = st.lvl, price = price, bar = bar_index - st.len, t = time[st.len], confirmBar = bar_index, tag = tg, eq = eq, broken = false)
    st.swings.push(sw)
    if st.swings.size() > SWING_CAP
        st.swings.shift()
    if side == 1
        st.lastHigh := sw
    else
        st.lastLow := sw
    f_emit(c, EV_SWING, side, price, sw.id, na, 3, st.lvl, na, na, tg)
    sw

// Rebuild the up-leg tracker from the new reference high: origin = lowest low since the pivot
f_resetUpLeg(StructState st, bool on) =>
    if on
        int k0 = bar_index - st.refHigh.bar
        float mn = na
        int mb = na
        int mt = na
        for k = k0 to 0
            if na(mn) or low[k] < mn
                mn := low[k]
                mb := bar_index - k
                mt := time[k]
        float lh = na
        int fd = na
        int k1 = bar_index - mb
        for k = k1 to 0
            lh := na(lh) ? high[k] : math.max(lh, high[k])
            if k < k1 and na(fd) and isDispUp[k]
                fd := bar_index - k
        st.upOrigLow := mn
        st.upOrigBar := mb
        st.upOrigT := mt
        st.upLegHigh := lh
        st.upFirstDisp := fd
    true

// Mirror: down-leg origin = highest high since the reference low
f_resetDnLeg(StructState st, bool on) =>
    if on
        int k0 = bar_index - st.refLow.bar
        float mx = na
        int mb = na
        int mt = na
        for k = k0 to 0
            if na(mx) or high[k] > mx
                mx := high[k]
                mb := bar_index - k
                mt := time[k]
        float ll = na
        int fd = na
        int k1 = bar_index - mb
        for k = k1 to 0
            ll := na(ll) ? low[k] : math.min(ll, low[k])
            if k < k1 and na(fd) and isDispDn[k]
                fd := bar_index - k
        st.dnOrigHigh := mx
        st.dnOrigBar := mb
        st.dnOrigT := mt
        st.dnLegLow := ll
        st.dnFirstDisp := fd
    true

// Incremental leg tracking on every confirmed bar
f_trackLegs(StructState st) =>
    if not na(st.upOrigLow)
        if low < st.upOrigLow
            st.upOrigLow := low
            st.upOrigBar := bar_index
            st.upOrigT := time
            st.upLegHigh := high
            st.upFirstDisp := na
        else
            st.upLegHigh := math.max(st.upLegHigh, high)
            if na(st.upFirstDisp) and isDispUp
                st.upFirstDisp := bar_index
    if not na(st.dnOrigHigh)
        if high > st.dnOrigHigh
            st.dnOrigHigh := high
            st.dnOrigBar := bar_index
            st.dnOrigT := time
            st.dnLegLow := low
            st.dnFirstDisp := na
        else
            st.dnLegLow := math.min(st.dnLegLow, low)
            if na(st.dnFirstDisp) and isDispDn
                st.dnFirstDisp := bar_index
    true

f_recordBreak(StructState st, int dir, int kind) =>
    st.prevBrkBar := st.lastBrkBar
    st.prevBrkDir := st.lastBrkDir
    st.prevBrkKind := st.lastBrkKind
    st.lastBrkBar := bar_index
    st.lastBrkDir := dir
    st.lastBrkKind := kind
    true

// Bullish break of the reference high (A.4)
f_breakUp(Core c, StructState st) =>
    Swing rh = st.refHigh
    int kind = st.trend == -1 ? BK_CHOCH : BK_BOS
    bool initial = st.trend == 0
    float legHi = math.max(st.upLegHigh, high)
    float disp = (legHi - st.upOrigLow) / vu
    bool hasFvg = not na(c.lastFvgUpBar) and c.lastFvgUpBar >= st.upOrigBar + 2
    bool mss = kind == BK_CHOCH and disp >= i_kLeg and hasFvg
    int cause = not na(c.lastDispUpBar) and c.lastDispUpBar >= st.upOrigBar ? c.lastDispUpId : na
    Brk b = Brk.new(id = f_nextId(c), kind = kind, dir = 1, lvl = st.lvl, price = rh.price, swingBar = rh.bar, swingT = rh.t, bar = bar_index, t = time, legExt0 = st.upOrigLow, legExt1 = legHi, origBar = st.upOrigBar, origT = st.upOrigT, firstDisp = st.upFirstDisp, disp = disp, mss = mss, initial = initial)
    rh.broken := true
    f_recordBreak(st, 1, kind)
    st.trend := 1
    st.protLow := st.upOrigLow
    st.breaks.push(b)
    if st.breaks.size() > BRK_CAP
        st.breaks.shift()
    Event e = f_emit(c, kind == BK_BOS ? EV_BOS : EV_CHOCH, 1, rh.price, b.id, cause, st.lvl == LV_SWG ? 1 : 3, st.lvl, disp, mss ? 1.0 : 0.0, initial ? "initial" : "")
    b.evId := e.id
    st.newUp := b
    b

// Bearish break of the reference low (mirror of f_breakUp)
f_breakDn(Core c, StructState st) =>
    Swing rl = st.refLow
    int kind = st.trend == 1 ? BK_CHOCH : BK_BOS
    bool initial = st.trend == 0
    float legLo = math.min(st.dnLegLow, low)
    float disp = (st.dnOrigHigh - legLo) / vu
    bool hasFvg = not na(c.lastFvgDnBar) and c.lastFvgDnBar >= st.dnOrigBar + 2
    bool mss = kind == BK_CHOCH and disp >= i_kLeg and hasFvg
    int cause = not na(c.lastDispDnBar) and c.lastDispDnBar >= st.dnOrigBar ? c.lastDispDnId : na
    Brk b = Brk.new(id = f_nextId(c), kind = kind, dir = -1, lvl = st.lvl, price = rl.price, swingBar = rl.bar, swingT = rl.t, bar = bar_index, t = time, legExt0 = st.dnOrigHigh, legExt1 = legLo, origBar = st.dnOrigBar, origT = st.dnOrigT, firstDisp = st.dnFirstDisp, disp = disp, mss = mss, initial = initial)
    rl.broken := true
    f_recordBreak(st, -1, kind)
    st.trend := -1
    st.protHigh := st.dnOrigHigh
    st.breaks.push(b)
    if st.breaks.size() > BRK_CAP
        st.breaks.shift()
    Event e = f_emit(c, kind == BK_BOS ? EV_BOS : EV_CHOCH, -1, rl.price, b.id, cause, st.lvl == LV_SWG ? 1 : 3, st.lvl, disp, mss ? 1.0 : 0.0, initial ? "initial" : "")
    b.evId := e.id
    st.newDn := b
    b

// One confirmed-bar step for a structure level. Called on every calculation with on = confirmed
// bar (CW10003): functions that read the bar history are never called from a conditional scope.
f_structStep(Core c, StructState st, float ph, float pl, bool on) =>
    if on
        st.newUp := na
        st.newDn := na
        st.newHigh := na
        st.newLow := na
        f_trackLegs(st)
        if not na(ph)
            Swing swH = f_makeSwing(c, st, 1, ph)
            st.refHigh := swH
            st.newHigh := swH
    f_resetUpLeg(st, on and not na(ph))
    if on and not na(pl)
        Swing swL = f_makeSwing(c, st, -1, pl)
        st.refLow := swL
        st.newLow := swL
    f_resetDnLeg(st, on and not na(pl))
    if on
        float srcUp = i_brk == BreakSrc.wick ? high : close
        float srcDn = i_brk == BreakSrc.wick ? low : close
        Swing rh = st.refHigh
        if not na(rh)
            if not rh.broken and srcUp > rh.price
                f_breakUp(c, st)
        Swing rl = st.refLow
        if not na(rl)
            if not rl.broken and srcDn < rl.price
                f_breakDn(c, st)
    true

// ═══ 21 · LIQUIDITY ENGINE ══════════════════════════════════════════════════════
// Levels from swing pivots, equal-level clusters, key levels and the sweep/taken
// automaton (Appendix A.12–A.13, §7.2). Session tracking feeds session high/low levels.

// New swing pivot → merge into an equal-level cluster or open a new level
f_liqAddSwing(Core c, array<Liq> lv, Swing sw) =>
    float tol = i_liqTol * vu
    bool merged = false
    int n = lv.size()
    if n > 0
        for i = n - 1 to 0
            Liq x = lv.get(i)
            if x.side == sw.side and x.kind == LK_SWING and x.tf == TF_CHART and x.state == LS_ACTIVE and math.abs(x.price - sw.price) <= tol and sw.bar - x.lastBar <= i_eqMaxBars
                x.touches := x.touches + 1
                x.price := sw.side == 1 ? math.max(x.price, sw.price) : math.min(x.price, sw.price)
                x.lastBar := sw.bar
                x.tag := sw.side == 1 ? "EQH" : "EQL"
                if x.touches == 2
                    f_emit(c, EV_LIQ_EQ, sw.side, x.price, x.id, na, 2, x.touches, na, na, x.tag)
                merged := true
                break
    if not merged
        Liq nl = Liq.new(id = f_nextId(c), side = sw.side, kind = LK_SWING, tf = TF_CHART, price = sw.price, bar = sw.bar, t = sw.t, born = bar_index, lastBar = sw.bar, touches = 1, major = false, state = LS_ACTIVE, lvl = sw.lvl, tag = sw.side == 1 ? "BSL" : "SSL")
        lv.push(nl)
        f_emit(c, EV_LIQ_NEW, sw.side, sw.price, nl.id, na, 3, LK_SWING, na, na, nl.tag)
    merged

// Key level (PDH/PDL/PWH/PWL/session H/L). A new level with the same tag retires the old one.
f_liqAddKey(Core c, array<Liq> lv, int kind, int side, float price, int t0, string tag) =>
    int n = lv.size()
    if n > 0
        for i = n - 1 to 0
            Liq x = lv.get(i)
            if x.kind == kind and x.tag == tag and (x.state == LS_ACTIVE or x.state == LS_PENDING)
                x.state := LS_EXPIRED
                x.endBar := bar_index
                x.endT := time
    Liq nl = Liq.new(id = f_nextId(c), side = side, kind = kind, tf = TF_CHART, price = price, bar = bar_index, t = t0, born = bar_index, lastBar = bar_index, touches = 1, major = true, state = LS_ACTIVE, lvl = -1, tag = tag)
    lv.push(nl)
    f_emit(c, EV_KEY_SET, side, price, nl.id, na, 3, kind, na, na, tag)
    nl

f_liqSwept(Core c, Liq x, float extreme, int stype) =>
    x.state := LS_SWEPT
    x.ext := extreme
    x.sweepType := stype
    x.endBar := bar_index
    x.endT := time
    float pen = math.abs(extreme - x.price) / vu
    string sideTxt = x.side == 1 ? "BSL" : "SSL"
    f_emit(c, EV_LIQ_SWEPT, -x.side, x.price, x.id, na, x.major ? 1 : 2, pen, stype, x.major ? 1.0 : 0.0, sideTxt + " " + x.tag, x.tf)

f_liqTaken(Core c, Liq x, float pen) =>
    x.state := LS_TAKEN
    x.endBar := bar_index
    x.endT := time
    string sideTxt = x.side == 1 ? "BSL" : "SSL"
    f_emit(c, EV_LIQ_TAKEN, x.side, x.price, x.id, na, 2, pen / vu, na, x.major ? 1.0 : 0.0, sideTxt + " " + x.tag, x.tf)

// Finished levels go to the archive for history rendering; HTF levels only while they are displayed
f_liqArchive(array<Liq> arch, Liq x) =>
    bool keep = x.tf == TF_CHART or i_htfLiq
    if keep
        arch.push(x)
        if arch.size() > LIQ_ARCH_CAP
            arch.shift()
    keep

// Confirmed-bar step: sweep / taken checks, major flag, expiry, turtle soup (A.13).
// Finished levels move to the archive (history rendering) once the turtle-soup window has passed.
f_liqStep(Core c, array<Liq> lv, array<Liq> arch, int chochIntDir) =>
    int n = lv.size()
    float maxPen = i_maxSweepPen * vu
    float tb = syminfo.mintick
    if n > 0
        for i = n - 1 to 0
            Liq x = lv.get(i)
            bool live = x.state == LS_ACTIVE or x.state == LS_PENDING
            if live
                if x.born < bar_index
                    int s = x.side
                    float ext = s == 1 ? high - x.price : x.price - low
                    bool beyondClose = s == 1 ? close > x.price : close < x.price
                    if x.state == LS_ACTIVE
                        if ext > tb
                            if ext > maxPen
                                f_liqTaken(c, x, ext)
                            else if not beyondClose
                                f_liqSwept(c, x, s == 1 ? high : low, SWEEP_WICK)
                            else
                                x.state := LS_PENDING
                                x.pendSince := bar_index
                                x.ext := s == 1 ? high : low
                    else
                        x.ext := s == 1 ? math.max(x.ext, high) : math.min(x.ext, low)
                        float pen = s == 1 ? x.ext - x.price : x.price - x.ext
                        if pen > maxPen
                            f_liqTaken(c, x, pen)
                        else if not beyondClose
                            f_liqSwept(c, x, x.ext, SWEEP_RECLAIM)
                        else if bar_index - x.pendSince >= i_reclaimBars
                            f_liqTaken(c, x, pen)
                if x.state == LS_ACTIVE or x.state == LS_PENDING
                    bool htf = x.tf != TF_CHART
                    x.major := htf or x.kind != LK_SWING or x.touches >= 2 or bar_index - x.bar >= i_oldAge
                    // HTF levels count their age in HTF bars (also right on session instruments)
                    int age = htf ? hLastBars - nz(x.hBorn, hLastBars) : bar_index - x.bar
                    if math.abs(close - x.price) > LIQ_MAX_DIST * vu * (htf ? htfDistMult : 1.0) or age > LIQ_MAX_AGE
                        x.state := LS_EXPIRED
                        x.endBar := bar_index
                        x.endT := time
                        f_emit(c, EV_LIQ_EXPIRED, x.side, x.price, x.id, na, 4, na, na, na, "", x.tf)
            else
                if x.state == LS_SWEPT and chochIntDir == -x.side and x.sweepType < SWEEP_TURTLE and bar_index - x.endBar <= i_tsWindow and x.endBar - x.bar >= i_tsMinAge
                    x.sweepType := SWEEP_TURTLE
                if bar_index - x.endBar > i_tsWindow
                    f_liqArchive(arch, lv.remove(i))
    if lv.size() > LIQ_CAP
        Liq old = lv.shift()
        if old.state == LS_ACTIVE or old.state == LS_PENDING
            old.state := LS_EXPIRED
            old.endBar := bar_index
            old.endT := time
        f_liqArchive(arch, old)
    true

// Session tracking: start / running high-low / end → history box + key levels (A.15)
f_sessEndT(string spec, string tz) =>
    int eh = int(str.tonumber(str.substring(spec, 5, 7)))
    int em = int(str.tonumber(str.substring(spec, 7, 9)))
    int e = timestamp(tz, year(time, tz), month(time, tz), dayofmonth(time, tz), eh, em)
    e <= time ? e + 86400000 : e

f_sessStep(Core c, Sess s, bool inNow, array<Liq> lv, array<SessBox> hist) =>
    if inNow and not s.on
        s.on := true
        s.hi := high
        s.lo := low
        s.t0 := time
        s.b0 := bar_index
        s.endT := f_sessEndT(s.spec, sesTz)
        f_emit(c, EV_SESSION_START, 0, open, na, na, 3, na, na, na, s.code)
    else if inNow and s.on
        s.hi := math.max(s.hi, high)
        s.lo := math.min(s.lo, low)
    else if not inNow and s.on
        s.on := false
        hist.push(SessBox.new(s.code, s.hi, s.lo, s.t0, time, s.b0, bar_index - 1))
        if hist.size() > SESS_CAP
            hist.shift()
        f_emit(c, EV_SESSION_END, 0, close, na, na, 3, s.hi, s.lo, na, s.code)
        if i_keySess
            f_liqAddKey(c, lv, LK_SESS, 1, s.hi, s.t0, s.tagHi)
            f_liqAddKey(c, lv, LK_SESS, -1, s.lo, s.t0, s.tagLo)
    true

// ═══ 22 · ZONE ENGINE ═══════════════════════════════════════════════════════════
// Order blocks and fair value gaps with explicit lifecycles; Breaker / Mitigation Block /
// IFVG are outcomes of a broken zone (Appendix A.7, A.8, A.10, §7.3–7.4, ADR-07).

f_zoneStrength(float disp, float size, float vr) =>
    float sd = math.min(1.0, disp / 2.5)
    float ss = math.min(1.0, size / vu / 1.5)
    na(vr) ? 0.8 * sd + 0.2 * ss : 0.6 * sd + 0.2 * ss + 0.2 * math.min(1.0, vr / 2.0)

// Latest pivot of one side on a structure level that formed before a given bar
f_swingBefore(StructState st, int side, int beforeBar) =>
    float p = na
    int n = st.swings.size()
    if n > 0
        for i = n - 1 to 0
            Swing s = st.swings.get(i)
            if s.side == side and s.bar < beforeBar
                p := s.price
                break
    p

// Order block from a structure break (A.7)
f_obFromBreak(Core c, array<Zone> zs, Brk b, StructState swSt, bool on) =>
    bool created = false
    // on: confirmed bar; shadowed internal breaks (a swing break on the same bar) make no OB
    if on and not na(b) and not b.shadowed
        int dir = b.dir
        bool ok = bar_index - (b.origBar - OB_NPRE) <= MAXBACK_GUARD
        // d: first displacement bar of the impulse (fallback: first candle in break direction)
        int d = b.firstDisp
        if ok and na(d)
            if b.origBar < bar_index
                for k = b.origBar + 1 to bar_index
                    int off = bar_index - k
                    if (dir == 1 and close[off] > open[off]) or (dir == -1 and close[off] < open[off])
                        d := k
                        break
            if na(d)
                d := bar_index
        // j: last opposite candle in [origin - nPre, d - 1]
        int j = na
        bool fb = false
        if ok
            int lo = math.max(b.origBar - OB_NPRE, d - OB_MAX_SEARCH)
            int hi = d - 1
            if hi >= lo
                for k = hi to lo
                    int off = bar_index - k
                    if (dir == 1 and close[off] < open[off]) or (dir == -1 and close[off] > open[off])
                        j := k
                        break
            if na(j)
                j := b.origBar
                fb := true
        if ok and not na(j)
            int offJ = bar_index - j
            float o = open[offJ]
            float cl = close[offJ]
            float h = high[offJ]
            float l = low[offJ]
            float top = math.max(o, cl)
            float bot = math.min(o, cl)
            if i_obZone == ObZone.full
                top := h
                bot := l
            else if i_obZone == ObZone.bodyWick
                top := dir == 1 ? math.max(o, cl) : h
                bot := dir == 1 ? l : math.min(o, cl)
            float sz = top - bot
            if sz > obMax * vu and i_obZone != ObZone.body
                top := math.max(o, cl)
                bot := math.min(o, cl)
                sz := top - bot
            bool pass = sz >= obMin * vu and sz <= obMax * vu and sz > 0
            if pass and i_obReqDisp and b.disp < i_obDispMin
                pass := false
            // peak relative volume of the impulse
            float vrMax = na
            if pass and hasVolume and d <= bar_index
                for k = d to bar_index
                    float vr = volRatio[bar_index - k]
                    if not na(vr)
                        vrMax := na(vrMax) ? vr : math.max(vrMax, vr)
            if pass and i_volFilter and hasVolume and not na(vrMax) and vrMax < i_volMult
                pass := false
            // integrity: closed through before birth → reject; traded into after the impulse → touched
            bool touched = false
            if pass and j < bar_index
                for k = j + 1 to bar_index
                    int off = bar_index - k
                    if (dir == 1 and close[off] < bot) or (dir == -1 and close[off] > top)
                        pass := false
                        break
                    if k > d and ((dir == 1 and low[off] <= top) or (dir == -1 and high[off] >= bot))
                        touched := true
            // dedupe: the same candle from internal and swing breaks is one OB
            int tJ = time[offJ]
            if pass
                int n = zs.size()
                if n > 0
                    for i = n - 1 to 0
                        Zone z = zs.get(i)
                        if z.tf == TF_CHART and z.kind == ZK_OB and z.dir == dir and z.t == tJ
                            pass := false
                            if b.lvl > z.lvl
                                z.lvl := b.lvl
                            break
            if pass
                float extRef = b.lvl == LV_SWG ? na : f_swingBefore(swSt, dir, b.origBar)
                float strength = f_zoneStrength(b.disp, sz, vrMax) * (fb ? 0.7 : 1.0)
                Zone z = Zone.new(id = f_nextId(c), kind = ZK_OB, dir = dir, state = touched ? ZS_TOUCHED : ZS_FRESH, top = top, bottom = bot, bar = j, t = tJ, born = bar_index, bornT = time, touches = touched ? 1 : 0, strength = strength, disp = b.disp, extRef = extRef, legExt = b.legExt1, brkId = b.id, lvl = b.lvl, tf = TF_CHART, fallback = fb)
                zs.push(z)
                f_emit(c, EV_ZONE_NEW, dir, (top + bot) / 2, z.id, b.evId, 2, ZK_OB, top, bot, "OB")
                created := true
    created

// Fair value gap on the current (third) candle (A.10)
f_fvgNew(Core c, array<Zone> zs, int dir, bool on) =>
    if on
        float top = dir == 1 ? low : low[2]
        float bot = dir == 1 ? high[2] : high
        float sz = top - bot
        bool disp = dir == 1 ? isDispUp[1] : isDispDn[1]
        float strength = 0.6 * (disp ? math.min(1.0, body[1] / vu / 2.0) : 0.2) + 0.4 * math.min(1.0, sz / vu)
        Zone z = Zone.new(id = f_nextId(c), kind = ZK_FVG, dir = dir, state = ZS_FRESH, top = top, bottom = bot, bar = bar_index - 2, t = time[2], born = bar_index, bornT = time, unfilled = dir == 1 ? top : bot, strength = strength, disp = disp ? body[1] / vu : 0.0, lvl = LV_SWG, tf = TF_CHART)
        zs.push(z)
        int cause = disp ? (dir == 1 ? c.lastDispUpId : c.lastDispDnId) : na
        f_emit(c, EV_ZONE_NEW, dir, (top + bot) / 2, z.id, cause, 2, ZK_FVG, top, bot, "FVG")
    on

f_zoneEvent(Core c, Zone z, int typ, int tier, float v2 = na) =>
    f_emit(c, typ, z.dir, close, z.id, na, tier, z.kind, v2, z.touches, f_kindTag(z.kind), z.tf)

// Lifecycle for OB / BB / MB / IFVG (§7.3)
f_obLife(Core c, array<Zone> zs, Zone z) =>
    bool bull = z.dir == 1
    float h = math.max(z.top - z.bottom, syminfo.mintick)
    float mid = (z.top + z.bottom) / 2
    if z.kind == ZK_OB and not na(z.legExt)
        z.legExt := bull ? math.max(z.legExt, high) : math.min(z.legExt, low)
    bool broken = bull ? close < z.bottom : close > z.top
    if broken
        z.endBar := bar_index
        z.endT := time
        Event be = f_zoneEvent(c, z, EV_ZONE_BROKEN, 2)
        if z.kind == ZK_OB and i_breakers
            bool swept = z.lvl == LV_SWG or (not na(z.extRef) and not na(z.legExt) and (bull ? z.legExt > z.extRef : z.legExt < z.extRef))
            int nk = swept ? ZK_BB : ZK_MB
            Zone nz = Zone.new(id = f_nextId(c), kind = nk, dir = -z.dir, state = ZS_FRESH, top = z.top, bottom = z.bottom, bar = z.bar, t = z.t, born = bar_index, bornT = time, strength = z.strength * 0.9, disp = z.disp, parent = z.id, brkId = z.brkId, lvl = z.lvl, tf = z.tf, hBorn = hLastBars)
            zs.push(nz)
            z.state := ZS_CONVERTED
            f_emit(c, EV_ZONE_CONVERTED, nz.dir, (nz.top + nz.bottom) / 2, nz.id, be.id, 2, nk, z.id, na, f_kindTag(nk), z.tf)
        else
            z.state := ZS_INVALID
    else
        bool inZone = bull ? low <= z.top : high >= z.bottom
        if inZone
            float pen = bull ? (z.top - low) / h : (high - z.bottom) / h
            pen := math.max(0.0, math.min(1.0, pen))
            z.maxPen := math.max(z.maxPen, pen)
            bool newTouch = bull ? low[1] > z.top : high[1] < z.bottom
            if newTouch
                z.touches := z.touches + 1
            if z.state == ZS_FRESH
                z.state := ZS_TOUCHED
                f_zoneEvent(c, z, EV_ZONE_TOUCHED, 2, pen)
            if z.state == ZS_TOUCHED
                bool mit = i_mitRule == MitRule.touch ? true : i_mitRule == MitRule.half ? (bull ? low <= mid : high >= mid) : (bull ? low <= z.bottom : high >= z.top)
                if mit
                    z.state := ZS_MITIGATED
                    f_zoneEvent(c, z, EV_ZONE_MITIGATED, 3, z.maxPen)
    true

// Lifecycle for FVG (§7.4)
f_fvgLife(Core c, array<Zone> zs, Zone z) =>
    bool bull = z.dir == 1
    float mid = (z.top + z.bottom) / 2
    bool inZone = bull ? low <= z.top : high >= z.bottom
    if inZone
        if z.state == ZS_FRESH
            z.state := ZS_PARTIAL
            z.touches := 1
            f_zoneEvent(c, z, EV_ZONE_TOUCHED, 2)
        z.unfilled := bull ? math.max(z.bottom, math.min(z.unfilled, low)) : math.min(z.top, math.max(z.unfilled, high))
        if z.state == ZS_PARTIAL and (bull ? low <= mid : high >= mid)
            z.state := ZS_CE
            f_zoneEvent(c, z, EV_ZONE_CE, 3)
        bool filled = i_fillRule == FillRule.wick ? (bull ? low <= z.bottom : high >= z.top) : i_fillRule == FillRule.closeEdge ? (bull ? close <= z.bottom : close >= z.top) : (bull ? low <= mid : high >= mid)
        if filled
            z.endBar := bar_index
            z.endT := time
            Event fe = f_zoneEvent(c, z, EV_ZONE_FILLED, 3)
            bool inv = i_ifvg and (bull ? close < z.bottom : close > z.top)
            if inv
                Zone nz = Zone.new(id = f_nextId(c), kind = ZK_IFVG, dir = -z.dir, state = ZS_FRESH, top = z.top, bottom = z.bottom, bar = z.bar, t = z.t, born = bar_index, bornT = time, strength = z.strength, disp = z.disp, parent = z.id, lvl = z.lvl, tf = z.tf, hBorn = hLastBars)
                zs.push(nz)
                z.state := ZS_CONVERTED
                f_emit(c, EV_ZONE_CONVERTED, nz.dir, (nz.top + nz.bottom) / 2, nz.id, fe.id, 2, ZK_IFVG, z.id, na, "IFVG", z.tf)
            else
                z.state := ZS_FILLED
    true

// Display filter shared with the renderer: kind toggles and minor-zone reduction (ADR-09)
f_zoneShown(Zone z) =>
    bool isOb = z.kind == ZK_OB or z.kind == ZK_BB or z.kind == ZK_MB
    bool htf = z.tf != TF_CHART
    bool kindOk = htf ? (z.kind == ZK_FVG or z.kind == ZK_IFVG ? i_htfFVG and vFVG : i_htfOB and vOB and (z.kind == ZK_OB or i_breakers)) : isOb ? vOB and (z.kind == ZK_OB or i_breakers) : vFVG
    bool minorOk = mc.debug or htf or not ((i_reduceMinorOb and z.kind == ZK_OB and z.fallback) or (i_reduceMinorFvg and z.kind == ZK_FVG and z.strength < 0.35))
    kindOk and minorOk

// Only zones the history view can ever draw are archived, so the archive reaches further back:
// shown by the display settings, and within the distance window of price at some point of
// their life (a view scrolled back to that moment ranks them there, §15 M6).
f_archiveZone(array<Zone> arch, Zone z) =>
    bool htf = z.tf != TF_CHART
    float dist = close > z.top ? (close - z.top) / vu : close < z.bottom ? (z.bottom - close) / vu : 0.0
    float dEff = na(z.nearD) ? dist : math.min(dist, z.nearD)
    bool keep = f_zoneShown(z) and (mc.debug or dEff <= mc.distMax * (htf ? 2 : 1))
    if keep
        arch.push(z)
        if arch.size() > ZONE_ARCH_CAP
            arch.shift()
    keep

// Confirmed-bar step for live zones: lifecycle, expiry, then finished zones move to the archive
f_zoneStep(Core c, array<Zone> zs, array<Zone> arch) =>
    int n = zs.size()
    if n > 0
        // Bar values and limits are the same for every zone: read once (profiled hot loop, v0.3.0: 22% of a full run)
        float cl = close
        float hi = high
        float lo = low
        float vuNow = vu
        int bi = bar_index
        float distLim = ZONE_MAX_DIST * vuNow
        float distLimHtf = distLim * htfDistMult
        for i = n - 1 to 0
            Zone z = zs.get(i)
            if z.state < ZS_FILLED
                if z.born < bi
                    // A lifecycle step changes nothing unless the bar reaches the zone (same test as `inZone` in
                    // f_fvgLife / f_obLife). A close through the far edge implies it (low <= close < bottom <= top),
                    // so only the running leg extreme of an OB still has to follow every bar.
                    bool bull = z.dir == 1
                    bool reached = bull ? lo <= z.top : hi >= z.bottom
                    if z.kind == ZK_FVG
                        if reached
                            f_fvgLife(c, zs, z)
                    else
                        if z.kind == ZK_OB and not na(z.legExt)
                            z.legExt := bull ? math.max(z.legExt, hi) : math.min(z.legExt, lo)
                        if reached
                            f_obLife(c, zs, z)
                if z.state < ZS_FILLED
                    float dist = cl > z.top ? cl - z.top : cl < z.bottom ? z.bottom - cl : 0.0
                    // closest approach in ATR while alive: decides whether the archive keeps it
                    z.nearD := na(z.nearD) ? dist / vuNow : math.min(z.nearD, dist / vuNow)
                    bool htf = z.tf != TF_CHART
                    int maxAge = z.kind == ZK_FVG or z.kind == ZK_IFVG ? FVG_MAX_AGE : OB_MAX_AGE
                    // HTF zones count their age in HTF bars (also right on session instruments)
                    int age = htf ? hLastBars - nz(z.hBorn, hLastBars) : bi - z.born
                    if age > maxAge or dist > (htf ? distLimHtf : distLim)
                        z.state := ZS_EXPIRED
                        z.endBar := bar_index
                        z.endT := time
                        f_zoneEvent(c, z, EV_ZONE_EXPIRED, 4)
            if z.state >= ZS_FILLED
                f_archiveZone(arch, zs.remove(i))
    if zs.size() > ZONE_CAP
        Zone old = zs.shift()
        old.state := ZS_EXPIRED
        old.endBar := bar_index
        old.endT := time
        f_archiveZone(arch, old)
    true

// ═══ 23 · CONTEXT ENGINE ════════════════════════════════════════════════════════
// Dealing range, premium/discount, OTE, regime and the MarketContext snapshot used by
// the Ribbon and Dashboard (Appendix A.14, A.16, A.17, §7.5).

// Dealing range follows swing-level breaks: protected extreme → far extreme of the leg
f_rangeStep(Core c, Range r, StructState sw, array<RangeSnap> arch) =>
    Brk bu = sw.newUp
    Brk bd = sw.newDn
    if r.state > 0 and (not na(bu) or not na(bd))
        arch.push(RangeSnap.new(r.dir, r.hi, r.lo, r.t0, time, r.b0, bar_index))
        if arch.size() > RANGE_ARCH_CAP
            arch.shift()
    if not na(bu)
        r.id := f_nextId(c)
        r.dir := 1
        r.state := 1
        r.lo := bu.legExt0
        r.loBar := bu.origBar
        r.hi := bu.legExt1
        r.hiBar := bar_index
        r.t0 := bu.origT
        r.b0 := bu.origBar
        r.inOte := false
        f_emit(c, EV_RANGE_NEW, 1, (r.hi + r.lo) / 2, r.id, bu.evId, 3, r.hi, r.lo, 1)
    else if not na(bd)
        r.id := f_nextId(c)
        r.dir := -1
        r.state := 1
        r.hi := bd.legExt0
        r.hiBar := bd.origBar
        r.lo := bd.legExt1
        r.loBar := bar_index
        r.t0 := bd.origT
        r.b0 := bd.origBar
        r.inOte := false
        f_emit(c, EV_RANGE_NEW, -1, (r.hi + r.lo) / 2, r.id, bd.evId, 3, r.hi, r.lo, 1)
    else if r.state > 0
        if high > r.hi and r.dir == 1
            r.hi := high
            r.hiBar := bar_index
        if low < r.lo and r.dir == -1
            r.lo := low
            r.loBar := bar_index
        if r.state == 1
            Swing nh = sw.newHigh
            Swing nl = sw.newLow
            if r.dir == 1 and not na(nh)
                if nh.bar >= r.loBar
                    r.state := 2
            if r.dir == -1 and not na(nl)
                if nl.bar >= r.hiBar
                    r.state := 2
    true

// Premium / discount location and OTE entry (A.14). Returns pd (0 = range low, 1 = high).
f_pdStep(Core c, Range r) =>
    float pd = na
    if r.state > 0 and r.hi > r.lo
        pd := (close - r.lo) / (r.hi - r.lo)
        int zone = pd > 0.5 + EQ_BAND ? 1 : pd < 0.5 - EQ_BAND ? -1 : 0
        if zone != r.pdZone
            r.pdZone := zone
            f_emit(c, EV_PD_ENTER, zone, close, r.id, na, 3, pd, na, na, zone == 1 ? "PREMIUM" : zone == -1 ? "DISCOUNT" : "EQ")
        bool ote = r.dir == 1 ? (pd >= 1 - oteHi and pd <= 1 - oteLo) : (pd >= oteLo and pd <= oteHi)
        if ote and not r.inOte
            f_emit(c, EV_OTE_ENTER, r.dir, close, r.id, na, 2, pd)
        r.inOte := ote
    pd

// MarketContext snapshot (A.16, A.17)
// hLow: too little HTF history (A.16 htfReliable = false) → the HTF bias counts as unknown
f_ctxBuild(Ctx x, StructState sw, StructState si, Range r, float pd, array<Liq> lv, Sess sa, Sess sl, Sess sn, bool hOk, bool hLow, int hTr) =>
    x.swTrend := sw.trend
    x.inTrend := si.trend
    x.htfOk := hOk
    x.htfLow := hOk and hLow
    x.htfTrend := hOk and not hLow ? hTr : 0
    bool chop = sw.lastBrkKind == BK_CHOCH and sw.prevBrkKind == BK_CHOCH and sw.lastBrkDir != sw.prevBrkDir and not na(sw.prevBrkBar) and sw.lastBrkBar - sw.prevBrkBar <= 6 * sw.len
    bool stale = not na(sw.lastBrkBar) and bar_index - sw.lastBrkBar >= 8 * sw.len and not na(pd) and pd >= 0 and pd <= 1
    x.ranging := chop or stale
    // A.16: ranging → RANGING; HTF unknown → chart trend; HTF agrees → that side; otherwise
    // (including an undefined chart trend under a known HTF bias) → MIXED
    x.market := x.ranging ? MK_RANGE : x.htfTrend == 0 ? sw.trend : x.htfTrend == sw.trend ? sw.trend : MK_MIXED
    x.pd := pd
    x.pdZone := r.pdZone
    x.inOte := r.inOte
    x.rangeState := r.state
    string code = ""
    int left = na
    if sl.on
        code := sl.code
        left := sl.endT
    else if sn.on
        code := sn.code
        left := sn.endT
    else if sa.on
        code := sa.code
        left := sa.endT
    x.sessCode := code
    x.minsLeft := na(left) ? na : math.max(0, int(math.round((left - time_close) / 60000.0)))
    // nextBsl / nextSsl are read only by the Dashboard TARGET rows, which show the last confirmed state:
    // scan the registry on the last confirmed historical bar and on realtime bars instead of on all history
    if barstate.islastconfirmedhistory or barstate.isrealtime or barstate.islast
        Liq nb = na
        Liq ns = na
        for l in lv
            if (l.state == LS_ACTIVE or l.state == LS_PENDING) and l.major
                if l.side == 1 and l.price > close and (na(nb) or l.price < nb.price)
                    nb := l
                if l.side == -1 and l.price < close and (na(ns) or l.price > ns.price)
                    ns := l
        x.nextBsl := nb
        x.nextSsl := ns
    true

// ═══ 24 · HTF INGESTION ═════════════════════════════════════════════════════════
// Confirmed HTF objects enter the shared registries with tf = TF_HTF1. From here on they
// use the same chart-side lifecycle as chart objects: sweeps of HTF levels and touches of
// HTF zones are detected on chart bars (ADR-03: one lifecycle, docs §4.7).

// HTF pivot → major liquidity level (never clustered with chart levels)
f_liqAddHtf(Core c, array<Liq> lv, int side, float price, int t0) =>
    Liq nl = Liq.new(id = f_nextId(c), side = side, kind = LK_SWING, tf = TF_HTF1, price = price, bar = bar_index, t = t0, born = bar_index, lastBar = bar_index, touches = 1, major = true, state = LS_ACTIVE, lvl = LV_SWG, tag = side == 1 ? "BSL" : "SSL", hBorn = hLastBars)
    lv.push(nl)
    f_emit(c, EV_LIQ_NEW, side, price, nl.id, na, 2, LK_SWING, na, na, "HTF " + nl.tag, TF_HTF1)
    nl

// HTF order block or fair value gap → zone. Skipped if already closed through on the chart.
f_zoneAddHtf(Core c, array<Zone> zs, int kind, int dir, float top, float bot, int t0) =>
    bool ok = not na(top) and not na(bot) and top > bot and not na(t0)
    if ok
        ok := dir == 1 ? close >= bot : close <= top
    if ok
        for z in zs
            if z.tf == TF_HTF1 and z.kind == kind and z.dir == dir and z.t == t0
                ok := false
                break
    if ok
        Zone z = Zone.new(id = f_nextId(c), kind = kind, dir = dir, state = ZS_FRESH, top = top, bottom = bot, bar = bar_index, t = t0, born = bar_index, bornT = time, unfilled = kind == ZK_FVG ? (dir == 1 ? top : bot) : na, strength = 0.8, disp = 0.0, lvl = LV_SWG, tf = TF_HTF1, hBorn = hLastBars)
        zs.push(z)
        f_emit(c, EV_ZONE_NEW, dir, (top + bot) / 2, z.id, na, 2, kind, top, bot, "HTF " + f_kindTag(kind), TF_HTF1)
    ok

// HTF structure break → kept for rendering and emitted on the bus with tf = HTF1
f_htfBreak(Core c, array<Brk> hb, int dir, int kind, float px, int swT, int brkT) =>
    Brk b = Brk.new(id = f_nextId(c), kind = kind, dir = dir, lvl = LV_SWG, price = px, swingT = swT, bar = bar_index, t = brkT, disp = na, tf = TF_HTF1)
    hb.push(b)
    if hb.size() > BRK_CAP
        hb.shift()
    Event e = f_emit(c, kind == BK_BOS ? EV_BOS : EV_CHOCH, dir, px, b.id, na, 1, LV_SWG, na, na, htfLabel, TF_HTF1)
    b.evId := e.id
    b

// ═══ 30 · SETUP ENGINE ══════════════════════════════════════════════════════════
// Setup automaton (§7.7) for the models SWEEP_REVERSAL and CONTINUATION (A.18), POI selection
// (§9.4), the DRAFT TradePlan (§10), risk checks (§11.3) and the explainable confluence score
// with presets (§9.5–9.6). Runs on confirmed bars after the Context engine: it reads the event
// bus and the registries and emits SETUP_* events. Analytical in v1.0: nothing is executed.

// Outcome and rejection counters over the whole history, shown by the Setup panel ("why so few
// setups", §19.1): READY, WIN / SL, and the first word of every reason a setup ended without a trade
var map<string, int> setStats = map.new<string, int>()

f_statAdd(string k) =>
    setStats.put(k, nz(setStats.get(k)) + 1)

f_modelName(int m) =>
    m == SM_REV ? "Sweep Reversal" : "Continuation"

f_gradeName(int g) =>
    g == GR_AP ? "A+" : g == GR_A ? "A" : g == GR_B ? "B" : "C"

f_gradeFor(float sc) =>
    sc >= 8.0 ? GR_AP : sc >= 6.5 ? GR_A : sc >= 5.0 ? GR_B : GR_C

f_sideName(int d) =>
    d == 1 ? "LONG" : "SHORT"

// UI stage (§7.7 table): FORMING · READY · ACTIVE · DONE
f_uiStage(int st) =>
    st <= SS_FORMING ? "FORMING" : st == SS_READY ? "READY" : st <= SS_TP2 ? "ACTIVE" : "DONE"

f_setActive(Setup s) =>
    s.state >= SS_TRIG and s.state <= SS_TP2

f_tpAt(Setup s, int n) =>
    n == 1 ? s.tp1 : n == 2 ? s.tp2 : s.tp3

// Position split over the targets (v2 default 0.5 / 0.3 / 0.2, renormalised to the targets that exist)
f_alloc(int nTp, int n) =>
    nTp >= 3 ? (n == 1 ? 0.5 : n == 2 ? 0.3 : 0.2) : nTp == 2 ? (n == 1 ? 0.6 : 0.4) : 1.0

f_rrAt(Setup s, float px) =>
    float risk = (s.entry - s.slInit) * s.dir
    risk > 0 ? (px - s.entry) * s.dir / risk : na

f_setEmit(Core c, Setup s, int typ, float price, float v1 = na, float v2 = na, float v3 = na, string s1 = "") =>
    int tier = typ == EV_SETUP_EXPIRED or typ == EV_SETUP_MISSED ? 2 : 1
    f_emit(c, typ, s.dir, price, s.id, na, tier, v1, v2, v3, s1)

// Terminal transition before entry (INVALID / EXPIRED / MISSED). Only setups that were shown
// (a POI was chosen) report it on the bus.
f_setEnd(Core c, Setup s, int st, string why) =>
    f_statAdd(why == "" ? "UNKNOWN" : str.split(why, " ").first())
    s.state := st
    s.reason := why
    s.endBar := bar_index
    s.endT := time
    if not na(s.poi)
        int typ = st == SS_INVALID ? EV_SETUP_INVALID : st == SS_MISSED ? EV_SETUP_MISSED : EV_SETUP_EXPIRED
        f_setEmit(c, s, typ, close, s.score, na, s.grade, why)
    true

// POI broken: the zone a setup waits for no longer exists as such
f_poiBroken(Setup s) =>
    Zone z = s.poi
    na(z) ? false : z.state == ZS_CONVERTED or z.state == ZS_INVALID or z.state == ZS_EXPIRED or z.state == ZS_FILLED

f_zoneName(Zone z) =>
    na(z) ? "—" : f_kindTag(z.kind)

// ── POI selection (§9.4). Candidates: FVG / OB of the shift leg, same direction, FRESH.
// Location: proximal edge in the discount (long) / premium (short) half of the shift range.
// Priority: FVG ∩ OB → FVG in OTE → OB in OTE → closest to EQ. Returns 2 = picked,
// 1 = leg zones exist but none in the right half, 0 = no leg zones.
f_pickPoi(Setup s, array<Zone> zs) =>
    int d = s.dir
    float span = s.rHi - s.rLo
    float eq = (s.rHi + s.rLo) / 2
    float bLo = d == 1 ? s.rHi - oteHi * span : s.rLo + oteLo * span
    float bHi = d == 1 ? s.rHi - oteLo * span : s.rLo + oteHi * span
    array<Zone> cand = array.new<Zone>()
    int nLeg = 0
    if span > 0
        for z in zs
            if z.tf == TF_CHART and z.dir == d and z.state == ZS_FRESH
                bool legOb = z.kind == ZK_OB and z.brkId == s.shiftBrkId
                bool legFvg = z.kind == ZK_FVG and z.bar >= s.legBar
                if legOb or legFvg
                    nLeg += 1
                    if d == 1 ? z.top <= eq : z.bottom >= eq
                        cand.push(z)
    int m = cand.size()
    Zone best = na
    Zone alt = na
    bool combo = false
    float cTop = na
    float cBot = na
    if m > 0
        // 1 · FVG ∩ OB (overlap ≥ 30% of the smaller zone)
        float bestC = -1.0
        for a in cand
            if a.kind == ZK_FVG
                for o in cand
                    if o.kind == ZK_OB
                        float ov = math.min(a.top, o.top) - math.max(a.bottom, o.bottom)
                        float sm = math.min(a.top - a.bottom, o.top - o.bottom)
                        if sm > 0 and ov >= 0.3 * sm
                            bool inOte = a.top >= bLo and a.bottom <= bHi
                            float pc = (inOte ? 1.0 : 0.0) - math.abs((d == 1 ? a.top : a.bottom) - eq) / span
                            if pc > bestC
                                bestC := pc
                                best := a
                                alt := o
                                combo := true
                                cTop := math.min(a.top, o.top)
                                cBot := math.max(a.bottom, o.bottom)
        // 2 · single zones: FVG in OTE → OB in OTE → closest to EQ; the runner-up is the alt POI
        if not combo
            float p1 = -1.0e10
            float p2 = -1.0e10
            for a in cand
                bool inOte = a.top >= bLo and a.bottom <= bHi
                float p = (inOte ? (a.kind == ZK_FVG ? 3.0 : 2.0) : 1.0) - math.abs((d == 1 ? a.top : a.bottom) - eq) / span
                if p > p1
                    alt := best
                    p2 := p1
                    best := a
                    p1 := p
                else if p > p2
                    alt := a
                    p2 := p
            cTop := best.top
            cBot := best.bottom
        s.poi := best
        s.poiAlt := alt
        s.combo := combo
        s.entryTop := cTop
        s.entryBot := cBot
    m > 0 ? 2 : nLeg > 0 ? 1 : 0

// ── DRAFT TradePlan (§10): entry, SL, targets, RR. Returns "" or the reason it is not valid.
f_setPlan(Setup s, array<Liq> lv) =>
    int d = s.dir
    float tick = syminfo.mintick
    float span = s.rHi - s.rLo
    float top = s.entryTop
    float bot = s.entryBot
    float ce = (top + bot) / 2
    float l705 = d == 1 ? s.rHi - 0.705 * span : s.rLo + 0.705 * span
    float e = i_entryMode == EntryMode.edge ? (d == 1 ? top : bot) : i_entryMode == EntryMode.ote and l705 <= top and l705 >= bot ? l705 : ce
    e := math.round_to_mintick(e)
    // stop: beyond the sweep (reversal) / the protected swing (continuation), the POI, or ATR
    float buf = math.max(i_slBufTicks * tick, i_slBufAtr * vu) + i_spread * tick
    float distal = d == 1 ? s.poi.bottom : s.poi.top
    if s.combo and not na(s.poiAlt)
        distal := d == 1 ? math.min(distal, s.poiAlt.bottom) : math.max(distal, s.poiAlt.top)
    float anchor = s.model == SM_REV ? s.sweepExt : d == 1 ? s.rLo : s.rHi
    float sl = i_slMode == SlMode.atr ? e - d * 1.5 * vu : (i_slMode == SlMode.poi ? distal : anchor) - d * buf
    sl := d == 1 ? math.floor(sl / tick) * tick : math.ceil(sl / tick) * tick
    s.inv := anchor
    s.entry := e
    s.sl := sl
    s.slInit := sl
    float risk = (e - sl) * d
    string fail = risk <= 0 ? "SL_INVALID" : risk / tick < i_minSlTicks ? "SL_TOO_TIGHT" : risk > i_maxSlAtr * vu ? "SL_TOO_WIDE" : ""
    s.tp1 := na
    s.tp2 := na
    s.tp3 := na
    s.tp1Tag := ""
    s.tp2Tag := ""
    s.tp3Tag := ""
    s.nTp := 0
    s.drawLiq := false
    s.drawTxt := ""
    if fail == ""
        // opposite liquidity beyond the entry, nearest first; the shift range extreme is the weak high / low
        array<float> px = array.new<float>()
        array<float> dist = array.new<float>()
        array<string> tg = array.new<string>()
        array<bool> maj = array.new<bool>()
        array<bool> hk = array.new<bool>()
        for x in lv
            if (x.state == LS_ACTIVE or x.state == LS_PENDING) and x.side == d and (x.price - e) * d > 0
                bool htf = x.tf != TF_CHART
                px.push(x.price)
                dist.push((x.price - e) * d)
                tg.push(f_htfPrefix(x.tf) + (x.kind == LK_SWING ? (d == 1 ? "BSL" : "SSL") : x.tag))
                maj.push(x.major or htf)
                hk.push(htf or x.kind != LK_SWING)
        float ext = d == 1 ? s.rHi : s.rLo
        if (ext - e) * d > 0
            px.push(ext)
            dist.push((ext - e) * d)
            tg.push(d == 1 ? "Range high" : "Range low")
            maj.push(true)
            hk.push(false)
        int nc = px.size()
        if i_tpMode == TpMode.liq and nc > 0
            array<int> ord = dist.sort_indices(order.ascending)
            for k in ord
                float dd = dist.get(k)
                if na(s.tp1)
                    if dd >= risk
                        s.tp1 := px.get(k)
                        s.tp1Tag := tg.get(k)
                else if na(s.tp2)
                    if dd > (s.tp1 - e) * d and maj.get(k)
                        s.tp2 := px.get(k)
                        s.tp2Tag := tg.get(k)
                else if na(s.tp3)
                    if dd > (s.tp2 - e) * d and hk.get(k)
                        s.tp3 := px.get(k)
                        s.tp3Tag := tg.get(k)
                // draw on liquidity: a major opposite target at least 2R away (§9.5)
                if not s.drawLiq and maj.get(k) and dd >= 2 * risk
                    s.drawLiq := true
                    s.drawTxt := tg.get(k) + " " + f_px(px.get(k)) + " (" + str.tostring(dd / risk, "0.0") + "R)"
        if i_tpMode == TpMode.rr
            s.tp1 := e + d * risk
            s.tp2 := e + d * 2 * risk
            s.tp3 := e + d * 3 * risk
            s.tp1Tag := "1R"
            s.tp2Tag := "2R"
            s.tp3Tag := "3R"
        // no opposite liquidity at all → one target at Min RR
        if na(s.tp1)
            s.tp1 := e + d * i_minRR * risk
            s.tp1Tag := str.tostring(i_minRR, "0.0#") + "R"
        s.tp1 := math.round_to_mintick(s.tp1)
        s.tp2 := na(s.tp2) ? na : math.round_to_mintick(s.tp2)
        s.tp3 := na(s.tp3) ? na : math.round_to_mintick(s.tp3)
        s.nTp := na(s.tp2) ? 1 : na(s.tp3) ? 2 : 3
        s.rrFinal := (f_tpAt(s, s.nTp) - e) * d / risk
        fail := s.rrFinal < i_minRR ? "RR_LOW" : ""
    fail

// Opposing FRESH HTF zone between entry and the price pxTo (§9.5 penalty, §11.3 check 3)
f_htfAgainst(Setup s, array<Zone> zs, float pxTo) =>
    bool hit = false
    float lo = math.min(s.entry, pxTo)
    float hi = math.max(s.entry, pxTo)
    for z in zs
        if z.tf != TF_CHART and z.dir == -s.dir and z.state == ZS_FRESH and z.top >= lo and z.bottom <= hi
            hit := true
            break
    hit

f_fac(string acc, string name, float pts) =>
    acc + (pts >= 0 ? "+ " : "− ") + name + "  " + (pts >= 0 ? "+" : "−") + str.tostring(math.abs(pts), "0.0#") + "\n"

// ── Confluence score (§9.5) with the preset weights (§9.6). Fills score, grade, factors.
f_setScore(Setup s, Ctx x, array<Zone> zs) =>
    bool agg = i_setPreset == SetPreset.aggressive
    int d = s.dir
    float span = s.rHi - s.rLo
    float eq = (s.rHi + s.rLo) / 2
    float bLo = d == 1 ? s.rHi - oteHi * span : s.rLo + oteLo * span
    float bHi = d == 1 ? s.rHi - oteLo * span : s.rLo + oteHi * span
    string f = ""
    // Context (≤ 3.0)
    float gC = 0.0
    float pen = 0.0
    bool htfRel = x.htfOk and not x.htfLow
    if htfRel and x.htfTrend == d
        gC += 1.5
        f := f_fac(f, "HTF " + htfLabel + (d == 1 ? " BULLISH" : " BEARISH"), 1.5)
    else if htfRel and x.htfTrend == -d
        float p = agg ? -1.0 : -1.5
        pen += p
        f := f_fac(f, "HTF " + htfLabel + " against", p)
    bool disc = d == 1 ? s.entryTop <= eq : s.entryBot >= eq
    bool inOte = s.entryTop >= bLo and s.entryBot <= bHi
    if disc
        gC += 0.75
        f := f_fac(f, d == 1 ? "Discount" : "Premium", 0.75)
    if inOte
        gC += 0.75
        f := f_fac(f, "OTE", 0.75)
    gC := math.min(3.0, gC)
    // Liquidity (≤ 2.5)
    float gL = 0.0
    if s.model == SM_REV
        float mp = s.sweepMajor ? 1.0 : 0.3
        gL += 1.0 + mp
        f := f_fac(f, s.sweepTag + " swept (" + (s.sweepMajor ? "major" : "minor") + ")", 1.0 + mp)
    else if s.contSweep
        gL += 1.0
        f := f_fac(f, "Internal liquidity swept on the pullback", 1.0)
    if s.drawLiq
        gL += 0.5
        f := f_fac(f, "Draw: " + s.drawTxt, 0.5)
    gL := math.min(2.5, gL)
    // Structure (≤ 2.0)
    float gS = (s.shiftLvl == LV_SWG ? 1.0 : 0.5) + math.min(1.0, nz(s.disp) / 2.0)
    string sn = s.shiftKind == BK_BOS ? "BOS" : s.isMSS ? "MSS" : "CHoCH"
    f := f_fac(f, (s.shiftLvl == LV_SWG ? "Swing " : "Internal ") + sn + " " + str.tostring(nz(s.disp), "0.0") + " ATR", math.min(2.0, gS))
    gS := math.min(2.0, gS)
    // POI (≤ 1.5; Aggressive: HTF POI ×2)
    float gP = s.combo ? 1.0 : 0.6
    f := f_fac(f, s.combo ? "FVG ∩ OB" : f_zoneName(s.poi), gP)
    bool htfPoi = false
    for z in zs
        if z.tf != TF_CHART and z.dir == d and z.state < ZS_FILLED and z.top >= s.entryBot and z.bottom <= s.entryTop
            htfPoi := true
            break
    if htfPoi
        float hp = agg ? 1.0 : 0.5
        gP += hp
        f := f_fac(f, "Inside " + htfLabel + " zone", hp)
    gP := math.min(agg ? 2.0 : 1.5, gP)
    // Time (≤ 0.5; Aggressive ×2)
    float gT = 0.0
    if s.kz
        gT := agg ? 1.0 : 0.5
        f := f_fac(f, "Killzone", gT)
    // Risk (≤ 0.5)
    float gR = s.rrFinal >= 3.0 ? 0.5 : s.rrFinal >= 2.0 ? 0.25 : 0.0
    if gR > 0
        f := f_fac(f, "RR " + str.tostring(s.rrFinal, "0.0"), gR)
    // Penalties
    if f_htfAgainst(s, zs, s.tp1)
        pen -= 1.0
        f := f_fac(f, htfLabel + " zone against before TP1", -1.0)
    if s.model == SM_CONT and x.ranging
        pen -= 0.5
        f := f_fac(f, "Ranging regime", -0.5)
    s.score := math.max(0.0, math.min(10.0, gC + gL + gS + gP + gT + gR + pen))
    s.grade := f_gradeFor(s.score)
    s.factors := f
    s.score

// Entry zone inside the OTE band of the shift range
f_poiInOte(Setup s) =>
    float span = s.rHi - s.rLo
    float bLo = s.dir == 1 ? s.rHi - oteHi * span : s.rLo + oteLo * span
    float bHi = s.dir == 1 ? s.rHi - oteLo * span : s.rLo + oteHi * span
    not na(s.entryTop) and s.entryTop >= bLo and s.entryBot <= bHi

// Setup Path text (§9.7): short for the card, medium for Analysis and the tooltip
f_setChain(Setup s) =>
    int d = s.dir
    string sn = s.shiftKind == BK_BOS ? "BOS" : s.isMSS ? "MSS" : "CHoCH"
    bool inOte = f_poiInOte(s)
    string poi = na(s.poi) ? "" : " → " + (s.combo ? "FVG+OB" : f_zoneName(s.poi))
    string loc = na(s.poi) ? "" : inOte ? " → OTE" : d == 1 ? " → DISC" : " → PREM"
    string head = s.model == SM_REV ? "Sweep → " + sn : sn
    s.chain := head + poi + loc
    string mid0 = s.model == SM_REV ? s.sweepTag + " swept → " : ""
    s.chainMid := mid0 + (s.shiftLvl == LV_SWG ? "" : "i") + sn + f_arrow(d) + " (" + str.tostring(nz(s.disp), "0.0") + " ATR)" + poi + loc
    s.chain

// ── Open a setup for model × direction. At most one not-yet-active setup per model × direction
// (§9.3): a newer one supersedes it unless it is READY. Returns na when blocked.
f_setOpen(Core c, array<Setup> ss, array<Setup> arch, int model, int dir) =>
    bool blocked = false
    int n = ss.size()
    if n > 0
        for i = n - 1 to 0
            Setup o = ss.get(i)
            if o.model == model and o.dir == dir and o.state < SS_TRIG
                if o.state == SS_READY
                    blocked := true
                else
                    f_setEnd(c, o, SS_EXPIRED, "SUPERSEDED")
                    Setup old = ss.remove(i)
                    if not na(old.poi)
                        arch.push(old)
                        if arch.size() > SETUP_ARCH_CAP
                            arch.shift()
    Setup s = na
    if not blocked
        s := Setup.new(id = f_nextId(c), model = model, dir = dir, state = SS_SWEEP, bornBar = bar_index, bornT = time, stageBar = bar_index)
        ss.push(s)
        if ss.size() > SETUP_CAP
            Setup old = ss.shift()
            f_setEnd(c, old, SS_EXPIRED, "CAPACITY")
            if not na(old.poi)
                arch.push(old)
                if arch.size() > SETUP_ARCH_CAP
                    arch.shift()
    s

// Shift candidate on this bar: swing break first, then internal (A.18)
f_shiftOf(Setup s, StructState sw, StructState si) =>
    Brk pick = na
    for k = 0 to 1
        Brk b = k == 0 ? (s.dir == 1 ? sw.newUp : sw.newDn) : (s.dir == 1 ? si.newUp : si.newDn)
        if na(pick) and not na(b)
            bool fromSweep = s.dir == 1 ? b.legExt0 <= s.sweepExt + 0.25 * vu : b.legExt0 >= s.sweepExt - 0.25 * vu
            if b.bar >= s.sweepBar and nz(b.disp) >= i_shiftDisp and fromSweep
                pick := b
    pick

f_setShift(Setup s, Brk b) =>
    s.shiftBrkId := b.id
    s.shiftEvId := b.evId
    s.shiftBar := bar_index
    s.shiftT := time
    s.shiftLvl := b.lvl
    s.shiftKind := b.kind
    s.isMSS := b.mss
    s.disp := b.disp
    s.shiftPx := b.price
    s.shiftSwT := b.swingT
    s.legBar := b.origBar
    if s.dir == 1
        s.rLo := s.model == SM_REV ? math.min(s.sweepExt, b.legExt0) : b.legExt0
        s.rHi := b.legExt1
    else
        s.rHi := s.model == SM_REV ? math.max(s.sweepExt, b.legExt0) : b.legExt0
        s.rLo := b.legExt1
    s.state := SS_SHIFTED
    s.stageBar := bar_index
    true

// ── Advance one setup on a confirmed bar (A.18 guards). kzNow: London or NY killzone open.
f_setAdvance(Core c, Setup s, StructState sw, StructState si, array<Liq> lv, array<Zone> zs, Ctx x, bool kzNow) =>
    int d = s.dir
    Brk opp = d == 1 ? sw.newDn : sw.newUp
    bool oppChoch = not na(opp) and opp.kind == BK_CHOCH
    // A terminal transition before the entry is recorded here and applied once at the end. The stages below are
    // mutually exclusive on s.state, which still holds its pre-end value, so no later stage can run after it.
    int endSt = 0
    string endWhy = ""
    // 1 · SWEEP_SEEN: wait for the shift against the sweep
    if s.state == SS_SWEEP
        if d == 1 ? close < s.sweepExt : close > s.sweepExt
            endSt := SS_EXPIRED
            endWhy := "SWEEP_FAILED"
        else
            if d == 1 ? low < s.sweepExt : high > s.sweepExt
                s.sweepExt := d == 1 ? low : high
            Brk b = f_shiftOf(s, sw, si)
            if not na(b) and (not i_reqKz or kzNow)
                f_setShift(s, b)
                s.kz := kzNow
            else if bar_index - s.sweepBar >= i_nShift
                endSt := SS_EXPIRED
                endWhy := "NO_SHIFT_IN_WINDOW"
    // 2 · SHIFTED: the range follows the leg until a POI in the right half appears
    if s.state == SS_SHIFTED
        if bar_index > s.shiftBar
            if d == 1
                s.rHi := math.max(s.rHi, high)
            else
                s.rLo := math.min(s.rLo, low)
        int pc = f_pickPoi(s, zs)
        float invLvl = s.model == SM_REV ? s.sweepExt : d == 1 ? s.rLo : s.rHi
        if pc == 2
            s.state := SS_FORMING
            s.stageBar := bar_index
            f_setChain(s)
            f_setEmit(c, s, EV_SETUP_FORMING, close, s.model, SS_FORMING, na, s.chain)
        else if (d == 1 ? close < invLvl : close > invLvl) or oppChoch
            endSt := SS_EXPIRED
            endWhy := oppChoch ? "OPPOSITE_CHOCH" : "CLOSE_BEYOND"
        else if bar_index - s.shiftBar >= i_expiry
            endSt := SS_EXPIRED
            endWhy := pc == 0 ? "NO_POI" : d == 1 ? "POI_IN_PREMIUM" : "POI_IN_DISCOUNT"
    // 3 · FORMING: build the plan, score it, promote to READY (checks are repeated every bar)
    if s.state == SS_FORMING
        float invLvl = s.model == SM_REV ? s.sweepExt : d == 1 ? s.rLo : s.rHi
        if d == 1 ? close < invLvl : close > invLvl
            endSt := SS_INVALID
            endWhy := "CLOSE_BEYOND " + f_px(invLvl)
        else if oppChoch
            endSt := SS_INVALID
            endWhy := "OPPOSITE_CHOCH"
        else if f_poiBroken(s)
            endSt := SS_INVALID
            endWhy := "POI_BROKEN"
        else
            string fail = f_setPlan(s, lv)
            if fail == ""
                s.kz := s.kz or kzNow
                f_setScore(s, x, zs)
                float r1 = s.entry + d * (s.entry - s.slInit) * d
                if i_setPreset == SetPreset.conservative and f_htfAgainst(s, zs, r1)
                    fail := "HTF_ZONE_NEAR"
                else if s.grade < setReadyGrade
                    fail := "GRADE_LOW"
            s.why := fail
            if fail == ""
                s.state := SS_READY
                s.stageBar := bar_index
                s.readyBar := bar_index
                s.readyT := time
                f_statAdd("READY")
                f_setEmit(c, s, EV_SETUP_READY, s.entry, s.score, s.rrFinal, s.grade, s.chain)
            else if bar_index - s.stageBar >= i_expiry
                endSt := SS_EXPIRED
                endWhy := fail
    // 4 · READY: wait for the entry from the next bar on; cancel rules before it (§10.2)
    if s.state == SS_READY and bar_index > s.readyBar
        if d == 1 ? low <= s.entry : high >= s.entry
            s.state := SS_TRIG
            s.stageBar := bar_index
            s.trigBar := bar_index
            s.trigT := time
            f_setEmit(c, s, EV_SETUP_TRIGGERED, s.entry, s.score, s.rrFinal, s.grade)
        else if d == 1 ? close < s.inv : close > s.inv
            endSt := SS_INVALID
            endWhy := "CLOSE_BEYOND " + f_px(s.inv)
        else if oppChoch
            endSt := SS_INVALID
            endWhy := "OPPOSITE_CHOCH"
        else if f_poiBroken(s)
            endSt := SS_INVALID
            endWhy := "POI_BROKEN"
        else if d == 1 ? high >= s.tp1 : low <= s.tp1
            endSt := SS_MISSED
            endWhy := "TP1_BEFORE_ENTRY"
        else if bar_index - s.readyBar >= i_expiry
            endSt := SS_EXPIRED
            endWhy := "EXPIRY"
        else if i_reqKz and s.kz and not kzNow
            endSt := SS_EXPIRED
            endWhy := "SESSION_END"
    // 5 · ACTIVE: SL first when SL and TP fall on one bar (§20.3); BE after TP1 (option)
    if f_setActive(s)
        bool hitSl = d == 1 ? low <= s.sl : high >= s.sl
        if hitSl
            float rSl = f_rrAt(s, s.sl)
            float left = 1.0
            if s.tpHit > 0
                for n = 1 to s.tpHit
                    left -= f_alloc(s.nTp, n)
            s.rReal += left * rSl
            s.state := s.tpHit > 0 ? SS_WIN : SS_SL
            s.reason := s.be ? "BE" : "SL"
            f_statAdd(s.tpHit > 0 ? "WIN" : "SL")
            s.endBar := bar_index
            s.endT := time
            f_setEmit(c, s, EV_SETUP_SL, s.sl, rSl, s.rReal)
        else if s.tpHit < s.nTp
            for n = s.tpHit + 1 to s.nTp
                float tp = f_tpAt(s, n)
                if n == s.tpHit + 1 and (d == 1 ? high >= tp : low <= tp)
                    float rr = f_rrAt(s, tp)
                    s.tpHit := n
                    s.rReal += f_alloc(s.nTp, n) * rr
                    f_setEmit(c, s, EV_SETUP_TP, tp, n, rr)
                    if n == 1 and i_beAfterTp1
                        s.sl := s.entry
                        s.be := true
            if s.tpHit >= s.nTp
                f_statAdd("WIN")
                s.state := SS_WIN
                s.reason := "TP" + str.tostring(s.nTp)
                s.endBar := bar_index
                s.endT := time
            else if s.tpHit > 0
                s.state := s.tpHit == 1 ? SS_TP1 : SS_TP2
    if endSt != 0
        f_setEnd(c, s, endSt, endWhy)
    true

// ── One confirmed-bar step: advance live setups, then open new ones from this bar's events.
// One loop and ONE f_setAdvance call site, in the original order: j in [0, n) live setups newest first
// (advance, continuation bonus, retire); j in [n, n + nb) the sweeps of this bar (SWEEP_REVERSAL);
// then four break candidates (CONTINUATION). A new setup is advanced at once, before the next candidate.
// nb is read before the loop: events emitted while advancing are SETUP_* and never a sweep.
f_setupStep(Core c, array<Setup> ss, array<Setup> arch, StructState sw, StructState si, array<Liq> lv, array<Zone> zs, Ctx x, bool kzNow) =>
    int n = ss.size()
    int nb = i_smRev ? c.barEvents.size() : 0
    bool htfRel = x.htfOk and not x.htfLow
    bool cons = i_setPreset == SetPreset.conservative
    for j = 0 to n + nb + 3
        bool isLive = j < n
        Setup s = na
        if isLive
            s := ss.get(n - 1 - j)
        else if j < n + nb
            // SWEEP_REVERSAL: every sweep on this bar opens a hypothesis in the reaction direction
            Event e = c.barEvents.get(j - n)
            if e.typ == EV_LIQ_SWEPT
                int d = e.dir
                bool htfOkDir = not (htfRel and x.htfTrend == -d and cons) and (not i_reqHtf or (htfRel and x.htfTrend == d))
                Liq lq = na
                for l in lv
                    if l.id == e.ref
                        lq := l
                if htfOkDir and not na(lq)
                    s := f_setOpen(c, ss, arch, SM_REV, d)
                    if not na(s)
                        s.sweepEvId := e.id
                        s.sweptLiqId := lq.id
                        s.sweepExt := nz(lq.ext, d == 1 ? low : high)
                        s.sweepMajor := lq.major or lq.tf != TF_CHART
                        s.sweepTag := f_htfPrefix(lq.tf) + (d == 1 ? "SSL" : "BSL") + (lq.kind == LK_SWING ? (lq.touches >= 2 ? " ≡" + str.tostring(lq.touches) : "") : " " + lq.tag)
                        s.sweepBar := bar_index
                        s.sweepT := time
                        s.sweepPx := lq.price
        else if i_smCont
            // CONTINUATION: BOS with the swing trend and a real leg (swing, or internal inside a swing trend)
            int k = j - n - nb
            Brk b = k == 0 ? sw.newUp : k == 1 ? sw.newDn : k == 2 ? si.newUp : si.newDn
            if not na(b)
                int d = b.dir
                bool okB = b.kind == BK_BOS and nz(b.disp) >= i_shiftDisp and sw.trend == d and not b.shadowed
                bool htfOkDir = (not cons or (htfRel and x.htfTrend == d)) and (not i_reqHtf or (htfRel and x.htfTrend == d))
                if okB and htfOkDir and (not i_reqKz or kzNow)
                    s := f_setOpen(c, ss, arch, SM_CONT, d)
                    if not na(s)
                        s.sweepExt := b.legExt0
                        s.sweepBar := bar_index
                        f_setShift(s, b)
                        s.kz := kzNow
        if not na(s)
            // a shift on the sweep bar itself counts (sweep and CHoCH on one bar, §12.3)
            f_setAdvance(c, s, sw, si, lv, zs, x, kzNow)
            if isLive
                // continuation bonus: internal liquidity swept on the pullback before the entry
                if s.model == SM_CONT and (s.state == SS_FORMING or s.state == SS_READY)
                    if f_evFlag(c, EV_LIQ_SWEPT, s.dir, na)
                        s.contSweep := true
                if s.state >= SS_WIN
                    Setup done = ss.remove(n - 1 - j)
                    if not na(done.poi)
                        arch.push(done)
                        if arch.size() > SETUP_ARCH_CAP
                            arch.shift()
    true

// Focus setup for the Ribbon, the Dashboard and the price-scale markers: the most advanced
// visible stage first (ACTIVE → READY → FORMING), then the higher score, then the newer one
f_setRank(Setup s) =>
    f_setActive(s) ? 3 : s.state == SS_READY ? 2 : s.state == SS_FORMING ? 1 : 0

f_setShown(Setup s) =>
    s.state == SS_FORMING or (s.state >= SS_READY and s.grade >= setShowGrade)

f_focusSetup(array<Setup> ss, int dirOnly) =>
    Setup best = na
    for s in ss
        if f_setShown(s) and s.state < SS_WIN and (dirOnly == 0 or s.dir == dirOnly)
            if na(best)
                best := s
            else
                int ra = f_setRank(s)
                int rb = f_setRank(best)
                if ra > rb or (ra == rb and (s.score > best.score or (s.score == best.score and s.bornBar > best.bornBar)))
                    best := s
    best

// ═══ 50 · ALERT MESSAGE & WEBHOOK (SMC Pro · Setups) ═══════════════════════════════
// One alert() per confirmed bar (§12.7, ADR-08) with every event of the bar that passes the
// filters, as text or as the JSON envelope `smcvp.event` v1 (§12.2). Read-only sink of the event
// bus: nothing here changes engine state. JSON is assembled from small helpers and array.join,
// so commas and quotes are placed mechanically.
// v0.5 scope: setup events carry full `setup` and `plan` objects with stable keys; other events
// carry `data` as raw payload slots v1..v3 / s1 (names per type: §6.4), `ref` / `cause` = null.

f_esc(string s) =>
    str.replace_all(str.replace_all(str.replace_all(s, "\\", "\\\\"), "\"", "\\\""), "\n", "\\n")

f_q(string s) =>
    "\"" + f_esc(s) + "\""

f_kv(string k, string v) =>
    "\"" + k + "\":" + v

f_obj(array<string> parts) =>
    "{" + array.join(parts, ",") + "}"

f_jn(float v) =>
    na(v) ? "null" : str.tostring(v, "0.0###")

f_jp(float v) =>
    na(v) ? "null" : str.tostring(v, format.mintick)

f_stateCode(int st) =>
    switch st
        SS_SWEEP => "SWEEP_SEEN"
        SS_SHIFTED => "SHIFTED"
        SS_FORMING => "FORMING"
        SS_READY => "READY"
        SS_TRIG => "TRIGGERED"
        SS_TP1 => "TP1"
        SS_TP2 => "TP2"
        SS_WIN => "WIN"
        SS_SL => "SL"
        SS_INVALID => "INVALID"
        SS_EXPIRED => "EXPIRED"
        => "MISSED"

// Live registry first; a setup that ended on this bar is already among the newest archive entries
f_setupById(array<Setup> ss, array<Setup> arch, int id) =>
    Setup s = na
    for x in ss
        if x.id == id
            s := x
    int n = arch.size()
    if na(s) and n > 0
        for i = n - 1 to math.max(0, n - 12)
            Setup y = arch.get(i)
            if na(s) and y.id == id
                s := y
    s

// Stable external key (ADR-12): built from the bar time the setup was born, not from bar_index
f_setKey(Setup s) =>
    "SETUP|" + (s.model == SM_REV ? "SWEEP_REVERSAL" : "CONTINUATION") + "|" + str.tostring(s.dir) + "|CHART|" + str.tostring(s.bornT)

f_jSetup(Setup s) =>
    array<string> a = array.new<string>()
    a.push(f_kv("model", f_q(s.model == SM_REV ? "SWEEP_REVERSAL" : "CONTINUATION")))
    a.push(f_kv("state", f_q(f_stateCode(s.state))))
    a.push(f_kv("grade", na(s.readyBar) ? "null" : f_q(f_gradeName(s.grade))))
    a.push(f_kv("score", f_jn(s.score)))
    a.push(f_kv("chain", f_q(s.chain)))
    a.push(f_kv("factors", f_q(s.factors)))
    a.push(f_kv("r_real", s.state >= SS_TRIG and s.state <= SS_SL ? f_jn(s.rReal) : "null"))
    a.push(f_kv("reason", s.reason == "" ? "null" : f_q(s.reason)))
    f_obj(a)

// DRAFT TradePlan (§10, §12.4): limit entry in the POI, stop, targets with RR and allocation
f_jPlan(Setup s) =>
    float risk = (s.entry - s.slInit) * s.dir
    array<string> tp = array.new<string>()
    for n = 1 to 3
        if n <= s.nTp
            float p = f_tpAt(s, n)
            tp.push(f_obj(array.from(f_kv("n", str.tostring(n)), f_kv("price", f_jp(p)), f_kv("rr", f_jn(f_rrAt(s, p))), f_kv("src", f_q(n == 1 ? s.tp1Tag : n == 2 ? s.tp2Tag : s.tp3Tag)), f_kv("alloc", f_jn(f_alloc(s.nTp, n))))))
    string em = i_entryMode == EntryMode.edge ? "EDGE" : i_entryMode == EntryMode.ote ? "OTE" : "CE"
    string sm = i_slMode == SlMode.atr ? "ATR" : i_slMode == SlMode.poi ? "BEYOND_POI" : s.model == SM_REV ? "BEYOND_SWEEP" : "STRUCTURAL"
    array<string> a = array.new<string>()
    a.push(f_kv("id", f_q("PLAN|" + f_setKey(s) + "|r1")))
    a.push(f_kv("rev", "1"))
    a.push(f_kv("side", f_q(s.dir == 1 ? "LONG" : "SHORT")))
    a.push(f_kv("entry", f_obj(array.from(f_kv("type", f_q("LIMIT")), f_kv("mode", f_q(em)), f_kv("price", f_jp(s.entry)), f_kv("zone", "[" + f_jp(s.entryBot) + "," + f_jp(s.entryTop) + "]")))))
    a.push(f_kv("sl", f_obj(array.from(f_kv("mode", f_q(sm)), f_kv("price", f_jp(s.slInit))))))
    a.push(f_kv("tp", "[" + array.join(tp, ",") + "]"))
    a.push(f_kv("rr_final", f_jn(s.rrFinal)))
    a.push(f_kv("invalidation", f_jp(s.inv)))
    a.push(f_kv("valid_until_t", str.tostring(s.readyT + i_expiry * barMs)))
    a.push(f_kv("cancel", "[\"INVALIDATION_CLOSE\",\"OPP_CHOCH\",\"POI_BROKEN\",\"TP1_BEFORE_ENTRY\",\"EXPIRY\"" + (i_reqKz ? ",\"SESSION_END\"" : "") + "]"))
    a.push(f_kv("risk", f_obj(array.from(f_kv("sl_atr", f_jn(risk / vu)), f_kv("sl_ticks", str.tostring(math.round(risk / syminfo.mintick))), f_kv("risk_pct", "null"), f_kv("qty", "null")))))
    f_obj(a)

f_isSetupEv(int typ) =>
    typ >= EV_SETUP_FORMING and typ <= EV_SETUP_MISSED

// Filters (§12.7): scope, minimum tier, and for setups the alert grade (a setup is reported once it
// has been READY with a grade at or above "Alert min grade"; FORMING is not reported)
f_whWanted(Event e, Setup s) =>
    bool setupOk = not na(s) and not na(s.readyBar) and s.grade >= setAlertGrade
    bool keyEv = e.tier <= 1 and not f_isSetupEv(e.typ)
    f_isSetupEv(e.typ) ? setupOk : i_whScope == WhScope.key ? keyEv : i_whScope == WhScope.all and e.tier <= i_whMinTier

f_jEvent(Event e, Setup s, int seq, string base) =>
    string ty = f_evName(e.typ)
    array<string> a = array.new<string>()
    a.push(f_kv("seq", str.tostring(seq)))
    a.push(f_kv("key", f_q(base + "|" + ty + "|" + str.tostring(seq))))
    a.push(f_kv("type", f_q(ty)))
    a.push(f_kv("dir", str.tostring(e.dir)))
    a.push(f_kv("price", f_jp(e.price)))
    a.push(f_kv("tf", f_q(e.tf == TF_CHART ? "CHART" : "HTF1")))
    a.push(f_kv("tier", str.tostring(e.tier)))
    a.push(f_kv("ref", na(s) ? "null" : f_q(f_setKey(s))))
    a.push(f_kv("cause", "null"))
    a.push(f_kv("data", f_obj(array.from(f_kv("v1", f_jn(e.v1)), f_kv("v2", f_jn(e.v2)), f_kv("v3", f_jn(e.v3)), f_kv("s1", f_q(e.s1))))))
    if not na(s)
        a.push(f_kv("setup", f_jSetup(s)))
        if not na(s.readyBar)
            a.push(f_kv("plan", f_jPlan(s)))
    f_obj(a)

// One line of the text format per event
f_txtEvent(Event e, Setup s) =>
    string side = e.dir == 1 ? "LONG " : e.dir == -1 ? "SHORT " : ""
    na(s) ? f_evName(e.typ) + " " + f_arrow(e.dir) + " " + f_px(e.price) + (e.s1 != "" ? " · " + e.s1 : "") : side + f_stateCode(s.state) + " · " + f_modelName(s.model) + " · " + f_gradeName(s.grade) + " " + str.tostring(s.score, "0.0") + " · E " + f_px(s.entry) + " · SL " + f_px(s.slInit) + " · TP1 " + f_px(s.tp1) + " · RR " + str.tostring(s.rrFinal, "0.0") + " · " + s.chain + (s.reason != "" ? " · " + s.reason : "")

f_ctxJson(Ctx x) =>
    string str0 = x.ranging ? "RANGE" : x.swTrend == 1 ? "BULL" : x.swTrend == -1 ? "BEAR" : "NONE"
    string pdz = na(x.pd) ? "null" : f_q(x.pdZone == 1 ? "PREMIUM" : x.pdZone == -1 ? "DISCOUNT" : "EQ")
    f_obj(array.from(f_kv("htf", htfOk ? f_q(htfTf) : "null"), f_kv("htf_bias", f_q(not x.htfOk or x.htfLow ? "NONE" : x.htfTrend == 1 ? "BULL" : x.htfTrend == -1 ? "BEAR" : "NONE")), f_kv("structure", f_q(str0)), f_kv("session", x.sessCode == "" ? "null" : f_q(str.replace_all(x.sessCode, " ", "_"))), f_kv("pd", pdz), f_kv("pd_pct", f_jn(x.pd)), f_kv("regime", f_q(x.ranging ? "RANGING" : "TRENDING"))))

// The bar's message: [text, number of events]. snap adds the READY / ACTIVE setups (§12.6).
f_whMessage(Core c, Ctx x, array<Setup> ss, array<Setup> arch, bool snap) =>
    string base = syminfo.tickerid + "|" + timeframe.period + "|" + str.tostring(time)
    array<string> ev = array.new<string>()
    int seq = 0
    int len = 0
    bool trunc = false
    for e in c.barEvents
        Setup s = f_isSetupEv(e.typ) ? f_setupById(ss, arch, e.ref) : na
        if f_whWanted(e, s)
            seq += 1
            string j = i_alertFmt == AlertFmt.json ? f_jEvent(e, s, seq, base) : f_txtEvent(e, s)
            if len + str.length(j) <= i_whMaxLen
                ev.push(j)
                len += str.length(j) + 1
            else
                trunc := true
    string out = ""
    if i_alertFmt == AlertFmt.json
        array<string> a = array.new<string>()
        a.push(f_kv("schema", f_q("smcvp.event")))
        a.push(f_kv("v", f_q("1.0")))
        a.push(f_kv("msg_id", f_q("SMCVP|" + base)))
        a.push(f_kv("build", f_q(BUILD)))
        a.push(f_kv("cfg", f_q(str.tostring(cfgSig))))
        if i_whTok != ""
            a.push(f_kv("tok", f_q(i_whTok)))
        a.push(f_kv("inst", f_obj(array.from(f_kv("tickerid", f_q(syminfo.tickerid)), f_kv("tf", f_q(timeframe.period)), f_kv("mintick", str.tostring(syminfo.mintick, "0.##########"))))))
        a.push(f_kv("bar", f_obj(array.from(f_kv("t", str.tostring(time)), f_kv("o", f_jp(open)), f_kv("h", f_jp(high)), f_kv("l", f_jp(low)), f_kv("c", f_jp(close))))))
        a.push(f_kv("ctx", f_ctxJson(x)))
        a.push(f_kv("events", "[" + array.join(ev, ",") + "]"))
        if trunc
            a.push(f_kv("truncated", "true"))
        if snap
            array<string> sn = array.new<string>()
            for s in ss
                if s.state >= SS_READY and s.state <= SS_TP2 and s.grade >= setAlertGrade
                    sn.push(f_obj(array.from(f_kv("ref", f_q(f_setKey(s))), f_kv("setup", f_jSetup(s)), f_kv("plan", f_jPlan(s)))))
            a.push(f_kv("snapshot", "[" + array.join(sn, ",") + "]"))
        out := f_obj(a)
    else
        out := "SMC Pro · " + syminfo.ticker + " " + timeframe.period + " · " + (seq == 0 ? "SNAPSHOT" : array.join(ev, " | ")) + (trunc ? " | …" : "")
    [out, seq]

// ═══ 60 · VISUAL TOKENS ═════════════════════════════════════════════════════════
// Design system tokens (docs/04-visual-design-system.md §13.3–13.7). Renderers use only
// these values: hue = meaning, form = entity type, transparency = state × relevance.
// v0.2–0.3: transparency scale retuned after visual tests on dark and blue backgrounds
// (zones and sessions were too faint) and made adjustable with the Visibility setting.

// Theme (§13.4): luminance of the chart background, or manual override
float bgLum = 0.2126 * color.r(chart.bg_color) + 0.7152 * color.g(chart.bg_color) + 0.0722 * color.b(chart.bg_color)
bool isDark = i_theme == ThemeOpt.dark ? true : i_theme == ThemeOpt.light ? false : bgLum < 128
bool isCvd = i_palette == PaletteOpt.cvd

// Hue tokens (Standard / Color-blind safe × Dark / Light)
color C_BULL = isCvd ? (isDark ? #56B4E9 : #0072B2) : (isDark ? #22AB94 : #089981)
color C_BEAR = isCvd ? (isDark ? #E69F00 : #D55E00) : (isDark ? #F7525F : #F23645)
color C_NEUT = isDark ? #9598A1 : #6B7080
color C_LIQ = isCvd ? (isDark ? #D0D3DB : #3B3F4A) : (isDark ? #E3B341 : #A86F00)
color C_SIG = isCvd ? (isDark ? #CC79A7 : #AA3377) : (isDark ? #4C8DFF : #2962FF)
color C_WARN = isCvd ? (isDark ? #F0E442 : #9C6B00) : (isDark ? #FF9F1A : #E65100)
color C_MITI = isCvd ? (isDark ? #9C9EA6 : #8A8C94) : (isDark ? #9C83D6 : #7B5CC4)
color C_INV = isDark ? #6A6E7A : #A9ADB8
color C_TEXT = chart.fg_color
color C_PANEL = isDark ? #1E222D : #F0F3FA
color C_PBORDER = isDark ? #2A2E39 : #D1D4DC

// Visibility offset: Subtle lighter, Bold denser (applies to fills and non-text lines)
visOff = switch i_visibility
    Visibility.subtle => 8
    Visibility.bold => -12
    => 0

f_tok(int base) =>
    math.max(0, math.min(97, base + visOff))

// Line transparency (§13.5)
OP_SOLID = 0
OP_STRONG = f_tok(5)
OP_MEDIUM = f_tok(25)
OP_SOFT = f_tok(45)
OP_FAINT = f_tok(60)

// Fill transparency (§13.5)
F_FOCUS = f_tok(60)
F_STRONG = f_tok(66)
F_BASE = f_tok(72)
F_LIGHT = f_tok(77)
F_FAINT = f_tok(84)
F_WASH = f_tok(90)
F_GHOST = f_tok(94)
F_PANEL = 10

// Relevance modulation (§16.4): less important objects fade a little, never to invisible
f_tr(int base, float r) =>
    math.max(0, math.min(94, base + math.round((1.0 - r) * 6.0)))

f_dirColor(int d) =>
    d > 0 ? C_BULL : d < 0 ? C_BEAR : C_NEUT

// Session hues: theme-adaptive light tints on dark charts (they stand out on navy/blue
// backgrounds too), deeper tones on light charts; or the user's own colors
color C_SES_ASIA = i_sesCustom ? i_sesColAsia : isDark ? #C5A3FF : #7E57C2
color C_SES_LON = i_sesCustom ? i_sesColLon : isDark ? #7FDBFF : #0277BD
color C_SES_NY = i_sesCustom ? i_sesColNy : isDark ? #FFC46B : #EF6C00

f_sesColor(string code) =>
    code == "ASIA" ? C_SES_ASIA : code == "LON KZ" ? C_SES_LON : C_SES_NY

// ═══ 62 · VISUAL BASE: POOLS, PRIMITIVES, TAGS, VIEW ═══════════════════════════════
// Shared by both indicators (ADR-13): object pools created once and reused (§4.9), primitive
// setters, right-edge tags with Smart Labels, and the View — the history window of the last
// histDepth bars split into time segments (§15). Rendered on the last historical bar and on each
// closed realtime bar (ADR-02, v0.6).

// ── Pools
f_fillBoxPool(BoxPool p, int n) =>
    if n > 0
        for i = 1 to n
            p.items.push(box.new(int(na), float(na), int(na), float(na), xloc = xloc.bar_time, border_color = color(na), bgcolor = color(na)))
    p.items.size()

f_fillLinePool(LinePool p, int n) =>
    if n > 0
        for i = 1 to n
            p.items.push(line.new(int(na), float(na), int(na), float(na), xloc = xloc.bar_time, color = color(na)))
    p.items.size()

f_fillLabelPool(LabelPool p, int n) =>
    if n > 0
        for i = 1 to n
            p.items.push(label.new(int(na), float(na), "", xloc = xloc.bar_time, color = color(na), textcolor = color(na), style = label.style_none))
    p.items.size()

method takeBox(BoxPool this) =>
    box b = na
    if this.used < this.items.size()
        b := this.items.get(this.used)
        this.used := this.used + 1
    b

method takeLine(LinePool this) =>
    line ln = na
    if this.used < this.items.size()
        ln := this.items.get(this.used)
        this.used := this.used + 1
    ln

method takeLabel(LabelPool this) =>
    label lb = na
    if this.used < this.items.size()
        lb := this.items.get(this.used)
        this.used := this.used + 1
    lb

f_finishBoxes(BoxPool p) =>
    int n = p.items.size()
    if p.used < n
        for i = p.used to n - 1
            box b = p.items.get(i)
            box.set_bgcolor(b, color(na))
            box.set_border_color(b, color(na))
            box.set_text(b, "")
    p.used

f_finishLines(LinePool p) =>
    int n = p.items.size()
    if p.used < n
        for i = p.used to n - 1
            line.set_color(p.items.get(i), color(na))
    p.used

f_finishLabels(LabelPool p) =>
    int n = p.items.size()
    if p.used < n
        for i = p.used to n - 1
            label lb = p.items.get(i)
            label.set_text(lb, "")
            label.set_tooltip(lb, "")
            label.set_textcolor(lb, color(na))
            label.set_color(lb, color(na))
    p.used

// ── Primitive setters
// Box text is only used for Debug IDs; zone tags go to the right-edge column (v0.3).
f_box(BoxPool p, int l, int r, float top, float bot, color fill, color border, int bw, string bst, string txt, color tc, string halign) =>
    box b = p.takeBox()
    if not na(b)
        box.set_lefttop(b, l, top)
        box.set_rightbottom(b, r, bot)
        box.set_bgcolor(b, fill)
        box.set_border_color(b, border)
        box.set_border_width(b, bw)
        box.set_border_style(b, bst)
        box.set_text(b, txt)
        box.set_text_color(b, tc)
        box.set_text_size(b, size.tiny)
        box.set_text_halign(b, halign)
        box.set_text_valign(b, text.align_center)
    not na(b)

f_line(LinePool p, int x1, float y1, int x2, float y2, color c, string st, int w) =>
    line ln = p.takeLine()
    if not na(ln)
        line.set_xy1(ln, x1, y1)
        line.set_xy2(ln, x2, y2)
        line.set_color(ln, c)
        line.set_style(ln, st)
        line.set_width(ln, w)
    not na(ln)

f_label(LabelPool p, int x, float y, string txt, color tc, string st, string sz, string tip, string yl) =>
    label lb = p.takeLabel()
    if not na(lb)
        label.set_xy(lb, x, y)
        label.set_yloc(lb, yl)
        label.set_text(lb, txt)
        label.set_textcolor(lb, tc)
        label.set_color(lb, color(na))
        label.set_style(lb, st)
        label.set_size(lb, sz)
        label.set_tooltip(lb, tip)
        label.set_textalign(lb, text.align_left)
    not na(lb)

// ── Right-edge tags with Smart Labels merging (§14.7). The merge distance grows with the
// visible price span, so tags never print on top of each other when zoomed out.
f_drawTags(LabelPool p, array<Tag> tags, int x, float sep) =>
    int n = tags.size()
    if n > 0
        array<float> ps = array.new<float>()
        for tg in tags
            ps.push(tg.price)
        array<int> idx = ps.sort_indices(order.ascending)
        float curP = na
        string curT = ""
        string curTip = ""
        color curC = na
        for k = 0 to n - 1
            Tag tg = tags.get(idx.get(k))
            if i_smartLabels and not na(curP) and tg.price - curP < sep
                curT := curT + " · " + tg.txt
                curTip := curTip + "\n" + tg.tip
            else
                if not na(curP)
                    f_label(p, x, curP, curT, curC, label.style_label_left, size.tiny, curTip, yloc.price)
                curP := tg.price
                curT := tg.txt
                curTip := tg.tip
                curC := tg.col
        if not na(curP)
            f_label(p, x, curP, curT, curC, label.style_label_left, size.tiny, curTip, yloc.price)
    n

// ── View: history window (last histDepth bars) split into time segments (§15)
f_histAt(array<float> a, int base, int idx, float dflt) =>
    int k = idx - base
    k >= 0 and k < a.size() ? a.get(k) : dflt

f_buildView(array<float> hc, array<float> ha, int hb, float pxLive) =>
    // v0.6: the window is the last histDepth bars, not the chart's visible range: reading
    // chart.left/right_visible_bar_time made TradingView re-run the whole script on every scroll
    // and zoom. The window is still split into time segments, so history keeps an even density.
    bool vp = vHistory
    int iR = bar_index
    int iL = math.max(0, bar_index - histDepth)
    int w = iR - iL + 1
    int segs = vp ? math.max(1, math.min(SEG_MAX, int(math.ceil(w / SEG_BARS)))) : 1
    View v = View.new(vp, true, iL, iR, segs, array.new<int>(), array.new<float>(), array.new<float>())
    for s = 0 to segs - 1
        int e = s == segs - 1 ? iR : iL + int(math.round((s + 1) * w / segs)) - 1
        v.segEnd.push(e)
        v.segPx.push(e >= bar_index ? pxLive : f_histAt(hc, hb, e, pxLive))
        v.segAtr.push(e >= bar_index ? vu : f_histAt(ha, hb, e, vu))
    // price span of the recent closes for tag spacing: the last 300 bars stand in for the screen
    if vp
        float lo = na
        float hi = na
        for k = math.max(iL, iR - 300) to iR
            float c = k >= bar_index ? pxLive : f_histAt(hc, hb, k, na)
            if not na(c)
                lo := na(lo) ? c : math.min(lo, c)
                hi := na(hi) ? c : math.max(hi, c)
        v.winLo := lo
        v.winHi := hi
    v

// Segment that contains a bar index (the last segment for anything at or beyond the right edge)
f_segOf(View v, int idx) =>
    int s = v.segs - 1
    for k = 0 to v.segs - 1
        if idx <= v.segEnd.get(k)
            s := k
            break
    s

// Per-segment share of a window cap, so objects cover the whole screen instead of piling
// up near the right edge (user feedback v0.2: "the chart is empty on the left"). Rounded
// down, so the shares never add up to more than the cap and the pools behind it.
f_quota(View v, int cap) =>
    cap <= 0 ? 0 : math.max(1, int(cap / v.segs))

// Even spread inside segments (v0.3): candidates arrive in priority order. Pass 1 takes at most
// one object per time slot, pass 2 fills each segment's quota in priority order. Returns the
// indices of the picked candidates; index 0 is always picked first when anything is.
f_spreadPick(View v, array<int> xs, array<int> sg, int q, int slots) =>
    array<int> out = array.new<int>()
    int m = xs.size()
    if m > 0 and q > 0
        int ns = math.max(1, slots)
        int w = math.max(1, v.iR - v.iL + 1)
        array<int> cnt = array.new<int>(v.segs, 0)
        array<bool> slotUsed = array.new<bool>(ns, false)
        array<bool> took = array.new<bool>(m, false)
        for pass = 0 to 1
            for k = 0 to m - 1
                if not took.get(k)
                    int s = sg.get(k)
                    if cnt.get(s) < q
                        int sl = math.max(0, math.min(ns - 1, int((xs.get(k) - v.iL) * ns / w)))
                        if pass == 1 or not slotUsed.get(sl)
                            took.set(k, true)
                            slotUsed.set(sl, true)
                            cnt.set(s, cnt.get(s) + 1)
                            out.push(k)
    out

// ═══ 63 · SETUP COMPOSER ════════════════════════════════════════════════════════
// Setup composition (§14.8, §14.9) in the convention of TradingView's Long/Short Position
// tool: entry zone (POI), Entry / SL / TP lines, reward and risk boxes, the card. Every stage
// has its own look (FORMING outline → READY full → ACTIVE with entry marker → DONE faded with
// the outcome). Visual only: reads Setup objects, never changes them.

f_reasonText(string r) =>
    str.replace_all(str.lower(r), "_", " ")

f_setOutcome(Setup s) =>
    s.state == SS_WIN ? "✓ " + (s.rReal >= 0 ? "+" : "") + str.tostring(s.rReal, "0.0") + "R" + (s.reason == "BE" ? " · BE" : "") : s.state == SS_SL ? "✕ SL " + str.tostring(s.rReal, "0.0") + "R" : s.state == SS_INVALID ? "✕ INVALID · " + f_reasonText(s.reason) : s.state == SS_EXPIRED ? "⌛ EXPIRED · " + f_reasonText(s.reason) : s.state == SS_MISSED ? "MISSED · TP1 before entry" : ""

f_setPlanText(Setup s) =>
    float risk = (s.entry - s.slInit) * s.dir
    string t = "E " + f_px(s.entry) + " · SL " + f_px(s.slInit) + " (" + str.tostring(risk / vu, "0.0") + " ATR, " + str.tostring(math.round(risk / syminfo.mintick)) + " ticks)"
    for n = 1 to 3
        if n <= s.nTp
            string tg = n == 1 ? s.tp1Tag : n == 2 ? s.tp2Tag : s.tp3Tag
            t := t + "\nTP" + str.tostring(n) + " " + f_px(f_tpAt(s, n)) + " · " + str.tostring(f_rrAt(s, f_tpAt(s, n)), "0.0") + "R · " + tg
    t + "\ninvalidation: close " + (s.dir == 1 ? "below " : "above ") + f_px(s.inv)

// Full explanation (§9.7) for the card tooltip
f_setTip(Setup s) =>
    string head = f_sideName(s.dir) + " · " + str.upper(f_modelName(s.model)) + (na(s.readyBar) ? " · FORMING" : " · " + f_gradeName(s.grade) + " " + str.tostring(s.score, "0.0") + "/10")
    string detail = s.chainMid + (s.factors != "" ? "\n" + s.factors : "\n")
    string plan = na(s.readyBar) ? (s.why != "" ? "waiting: " + f_reasonText(s.why) : "waiting for a valid plan") : f_setPlanText(s)
    head + "\n" + detail + plan + "\nANALYTICAL · not executed. The score measures how complete the setup is, not a win probability."

f_card(LabelPool p, int x, float y, string txt, color tc, color bg, string sz, string tip) =>
    label lb = p.takeLabel()
    if not na(lb)
        label.set_xy(lb, x, y)
        label.set_yloc(lb, yloc.price)
        label.set_text(lb, txt)
        label.set_textcolor(lb, tc)
        label.set_color(lb, bg)
        label.set_style(lb, label.style_label_left)
        label.set_size(lb, sz)
        label.set_tooltip(lb, tip)
        label.set_textalign(lb, text.align_left)
    not na(lb)

// One composition. past: an older setup in the Analysis history (no price tags, small card).
f_drawSetup(BoxPool pb, LinePool pl, LabelPool plb, Setup s, bool past) =>
    int d = s.dir
    bool forming = s.state <= SS_FORMING
    bool planned = not na(s.readyBar)
    bool active = f_setActive(s)
    bool done = s.state >= SS_WIN
    // v0.4.2: finished setups must stay readable on dark charts (user feedback "barely visible").
    // A trade that was entered shows its outcome hue (win green, stop red) over a faded plan;
    // one that ended before the entry (invalid, expired, missed) keeps only a neutral dashed zone.
    bool noTrade = done and na(s.trigT)
    color sig = noTrade ? C_NEUT : C_SIG
    color rew = C_BULL
    color rsk = C_BEAR
    color outc = s.state == SS_WIN ? C_BULL : s.state == SS_SL ? C_BEAR : C_NEUT
    int x0 = planned ? s.readyT : s.shiftT
    int x1 = done ? math.max(s.endT, x0 + 5 * barMs) : math.max(x0 + 20 * barMs, time + 3 * barMs)
    int lnT = done ? OP_SOFT : OP_SOLID
    // entry zone (POI): dashed outline while forming or for a setup without a trade, focus fill when READY / ACTIVE
    bool outline = forming or noTrade
    // v0.4.3: READY / ACTIVE POI is a 2 px frame with a light fill, so it marks the zone SMC Visualizer
    // Pro already fills instead of stacking a second heavy fill on it (and stays visible on its own)
    f_box(pb, x0, x1, s.entryTop, s.entryBot, color.new(sig, outline or done ? F_WASH : F_FAINT), color.new(done ? outc : sig, OP_MEDIUM), outline or done ? 1 : 2, outline ? line.style_dashed : line.style_solid, "", color(na), text.align_right)
    if planned and vPlan and not noTrade
        float e = s.entry
        float lastTp = f_tpAt(s, s.nTp)
        if i_mode != DisplayMode.clean
            f_box(pb, x0, x1, math.max(e, lastTp), math.min(e, lastTp), color.new(rew, done ? F_WASH : F_FAINT), color(na), 1, line.style_solid, "", color(na), text.align_right)
            f_box(pb, x0, x1, math.max(e, s.slInit), math.min(e, s.slInit), color.new(rsk, done ? F_WASH : F_FAINT), color(na), 1, line.style_solid, "", color(na), text.align_right)
        f_line(pl, x0, e, x1, e, color.new(sig, lnT), line.style_solid, 2)
        f_line(pl, x0, s.slInit, x1, s.slInit, color.new(rsk, lnT), line.style_solid, 2)
        for n = 1 to 3
            if n <= s.nTp
                float tp = f_tpAt(s, n)
                bool hit = n <= s.tpHit
                f_line(pl, x0, tp, x1, tp, color.new(rew, done or hit ? OP_SOFT : OP_MEDIUM), line.style_dashed, 1)
                if not past and labelLvl > 0
                    f_label(plb, x1, tp, "TP" + str.tostring(n) + " " + f_px(tp) + " · " + str.tostring(f_rrAt(s, tp), "0.0") + "R" + (hit ? " ✓" : ""), color.new(rew, done ? OP_SOFT : OP_SOLID), label.style_label_left, size.tiny, (n == 1 ? s.tp1Tag : n == 2 ? s.tp2Tag : s.tp3Tag) + " · " + f_px(tp), yloc.price)
        if not past and labelLvl > 0
            f_label(plb, x1, s.slInit, "SL " + f_px(s.slInit) + (s.be and not done ? " → BE" : ""), color.new(rsk, done ? OP_SOFT : OP_SOLID), label.style_label_left, size.tiny, "Stop loss " + f_px(s.slInit) + (s.be ? " · moved to entry after TP1" : ""), yloc.price)
        // invalidation differs from the stop by the buffer: shown while the entry is pending
        if s.state == SS_READY and math.abs(s.inv - s.slInit) >= syminfo.mintick
            f_line(pl, x0, s.inv, x1, s.inv, color.new(C_BEAR, OP_SOFT), line.style_dotted, 1)
        if not na(s.trigT)
            f_label(plb, s.trigT, e, "●", color.new(sig, done ? OP_SOFT : OP_SOLID), label.style_label_center, size.small, "Entry " + f_px(e) + " · " + f_timeStr(s.trigT), yloc.price)
    // card: direction, grade and score, chain, RR / SL size; outcome when done
    float risk = planned ? (s.entry - s.slInit) * d : na
    string head = done ? f_setOutcome(s) : f_sideName(d) + (forming ? " — FORMING" : " · " + f_gradeName(s.grade) + " " + str.tostring(s.score, "0.0") + (active ? " · ACTIVE" : ""))
    string txt = head
    if not past
        if planned and not done
            txt := head + "   E " + f_px(s.entry) + "\n" + s.chain + "\nRR 1:" + str.tostring(s.rrFinal, "0.0") + " · SL " + str.tostring(risk / vu, "0.0") + " ATR"
        else
            txt := head + "\n" + s.chain
    float cy = planned and not noTrade ? s.entry : (s.entryTop + s.entryBot) / 2
    color tc = done ? outc : forming ? color.new(sig, OP_MEDIUM) : sig
    color bg = past ? color(na) : color.new(C_PANEL, done ? 40 : 15)
    f_card(plb, x1 + barMs, cy, txt, tc, bg, past ? size.tiny : size.small, f_setTip(s))
    true

// Setup Path (§17.2): numbered markers on the events the setup is built from — the sweep, the
// shift and the POI, i.e. the very level, break and zone SMC Visualizer Pro draws with the same
// settings (equal cfg) — joined by dotted links, so setup and chart markup read as one story.
f_step(int k) =>
    k == 1 ? "①" : k == 2 ? "②" : k == 3 ? "③" : k == 4 ? "④" : "⑤"

f_drawPath(LinePool pl, LabelPool plb, Setup s, bool faded) =>
    int d = s.dir
    color pc = color.new(C_SIG, faded ? OP_SOFT : OP_STRONG)
    color lc = color.new(C_SIG, faded ? OP_FAINT : OP_SOFT)
    string sn = s.shiftKind == BK_BOS ? "BOS" : s.isMSS ? "MSS" : "CHoCH"
    int k = 0
    int qx = na
    float qy = na
    // ① sweep (Sweep Reversal): below / above the sweep candle, on the level the chart shows with ✕
    if s.model == SM_REV and not na(s.sweepT)
        k += 1
        f_label(plb, s.sweepT, s.sweepPx, f_step(k) + " " + s.sweepTag + " ✕", pc, d == 1 ? label.style_label_up : label.style_label_down, size.tiny, "Step " + str.tostring(k) + " · liquidity sweep: " + s.sweepTag + " " + f_px(s.sweepPx) + " · " + f_timeStr(s.sweepT), d == 1 ? yloc.belowbar : yloc.abovebar)
        qx := s.sweepT
        qy := s.sweepPx
    // ② shift: the broken swing level from its pivot to the break, drawn over the structure line
    if not na(s.shiftT) and not na(s.shiftPx)
        k += 1
        if not na(s.shiftSwT)
            f_line(pl, s.shiftSwT, s.shiftPx, s.shiftT, s.shiftPx, pc, line.style_solid, 2)
        if not na(qx)
            f_line(pl, qx, qy, s.shiftT, s.shiftPx, lc, line.style_dotted, 1)
        f_label(plb, s.shiftT, s.shiftPx, f_step(k) + " " + sn + f_arrow(d) + " " + str.tostring(nz(s.disp), "0.0") + " ATR", pc, d == 1 ? label.style_label_down : label.style_label_up, size.tiny, "Step " + str.tostring(k) + " · " + (s.shiftLvl == LV_SWG ? "swing " : "internal ") + sn + " of " + f_px(s.shiftPx) + " · leg " + str.tostring(nz(s.disp), "0.0") + " ATR · " + f_timeStr(s.shiftT), d == 1 ? yloc.abovebar : yloc.belowbar)
        qx := s.shiftT
        qy := s.shiftPx
    // ③ POI: at the left edge of the zone it was picked from, with its location in the range
    if not na(s.poi) and not na(s.entryTop)
        k += 1
        int pt = s.poi.t
        float pm = (s.entryTop + s.entryBot) / 2
        if not na(qx)
            f_line(pl, qx, qy, pt, pm, lc, line.style_dotted, 1)
        string loc = f_poiInOte(s) ? " · OTE" : d == 1 ? " · DISC" : " · PREM"
        string pn = s.combo ? "FVG+OB" : f_zoneName(s.poi)
        f_label(plb, pt, d == 1 ? s.entryBot : s.entryTop, f_step(k) + " " + pn + loc, pc, d == 1 ? label.style_label_upper_left : label.style_label_lower_left, size.tiny, "Step " + str.tostring(k) + " · POI " + pn + " " + f_px(s.entryBot) + " – " + f_px(s.entryTop) + loc, yloc.price)
        qx := pt
        qy := pm
    // ④ entry: the composition draws the ● dot; the path links to it and numbers it
    if not na(s.trigT)
        k += 1
        if not na(qx)
            f_line(pl, qx, qy, s.trigT, s.entry, lc, line.style_dotted, 1)
        f_label(plb, s.trigT, s.entry, f_step(k), pc, d == 1 ? label.style_label_upper_left : label.style_label_lower_left, size.tiny, "Step " + str.tostring(k) + " · entry " + f_px(s.entry) + " · " + f_timeStr(s.trigT), yloc.price)
    k

// Live: the focus composition per direction plus recently finished ones (TTL by outcome and
// mode, §14.8). Older setups inside the visible window: up to setupPast (Normal 6, Analysis / Debug 10).
f_setDoneTtl(Setup s) =>
    bool clean = i_mode == DisplayMode.clean
    s.state == SS_WIN ? (clean ? 10 : 30) : s.state == SS_SL or s.state == SS_INVALID ? (clean ? 5 : 30) : (clean ? 0 : 10)

f_setShownDone(Setup s) =>
    not na(s.readyBar) ? s.grade >= setShowGrade : setShowGrade == GR_C

f_renderSetups(View v, BoxPool pb, LinePool pl, LabelPool plb, array<Setup> ss, array<Setup> arch) =>
    int shown = 0
    // Setup Path: the current setups from Normal on; recent and past ones too in Analysis / Debug / Custom
    bool pathOn = i_showPath and i_mode != DisplayMode.clean
    bool pathAll = pathOn and (i_mode != DisplayMode.normal)
    if i_setups
        array<int> drawn = array.new<int>()
        if v.live
            for d in array.from(1, -1)
                Setup fs = f_focusSetup(ss, d)
                if not na(fs)
                    if pathOn
                        f_drawPath(pl, plb, fs, false)
                    f_drawSetup(pb, pl, plb, fs, false)
                    drawn.push(fs.id)
                    shown += 1
        int n = arch.size()
        if n > 0
            int recent = 0
            int past = 0
            for i = n - 1 to 0
                Setup s = arch.get(i)
                if not drawn.includes(s.id) and f_setShownDone(s)
                    if v.live and recent < 2 and bar_index - s.endBar <= f_setDoneTtl(s)
                        if pathAll
                            f_drawPath(pl, plb, s, true)
                        f_drawSetup(pb, pl, plb, s, false)
                        drawn.push(s.id)
                        recent += 1
                        shown += 1
                    else if mc.setupPast > 0 and past < mc.setupPast
                        int b0 = na(s.readyBar) ? s.shiftBar : s.readyBar
                        if s.endBar >= v.iL and b0 <= v.iR
                            if pathAll
                                f_drawPath(pl, plb, s, true)
                            f_drawSetup(pb, pl, plb, s, true)
                            past += 1
                            shown += 1
    shown

// ═══ 66 · PANELS ═════════════════════════════════════════════════════════════════
// SMC Visualizer Pro: Context Ribbon answers "what is happening" in one line (§14.6); Dashboard
// gives the answers with details in tooltips (§14.5); Debug shows budgets and data health (§19.1).
// SMC Pro · Setups: one compact Setup panel (§14.5 SETUP / QUALITY / PLAN / INVALID rows).
// Both show the settings signature cfg (ADR-13): equal numbers = the same engine settings.

f_pos(string s) =>
    switch s
        "Top Right" => position.top_right
        "Top Left" => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left" => position.bottom_left
        "Top Center" => position.top_center
        "Bottom Center" => position.bottom_center
        => position.top_right

f_statusText(Core c, bool liveView) =>
    not c.warm ? "WARMING UP" : nonStdChart ? "⚠ NON-STANDARD CHART" : not liveView ? "◀ HISTORY VIEW" : ""

f_dashRow(table tb, int row, string k, string v, color vc, string tip, string sz) =>
    table.cell(tb, 0, row, k, text_color = color.new(C_TEXT, 45), text_size = sz, text_halign = text.align_left)
    table.cell(tb, 1, row, v, text_color = vc, text_size = sz, text_halign = text.align_left, tooltip = tip)
    row + 1

// ── Setup panel (SMC Pro · Setups): the focus setup in four rows, then status and cfg
f_setColor(Setup s) =>
    na(s) ? C_NEUT : s.state >= SS_READY ? C_SIG : color.new(C_SIG, 35)

f_qualityBar(float sc) =>
    int k = int(math.round(sc))
    str.repeat("▮", k) + str.repeat("▯", 10 - k)

f_setupPanel(table tb, Ctx x, Core c, bool liveView, Setup fs) =>
    if not na(tb)
        string sz = panelSz
        int row = 0
        Liq nb = x.nextBsl
        Liq ns = x.nextSsl
        if i_setups
            if na(fs)
                Liq w = na(nb) ? ns : na(ns) ? nb : nb.price - close <= close - ns.price ? nb : ns
                string wt = na(w) ? "— watching" : "— watching " + (w.side == 1 ? "BSL " : "SSL ") + f_px(w.price)
                row := f_dashRow(tb, row, "SETUP", wt, C_NEUT, "No setup. A sweep of the nearest liquidity followed by a shift, or a BOS with the trend, starts one.", sz)
            else
                int left = i_expiry - (bar_index - fs.stageBar)
                string stg = f_sideName(fs.dir) + " — " + f_uiStage(fs.state) + " · " + (fs.model == SM_REV ? "Reversal" : "Continuation")
                string tipS = f_modelName(fs.model) + " · " + fs.chainMid + (fs.state <= SS_READY ? "\nexpires in " + str.tostring(math.max(0, left)) + " bars" : "") + (fs.state == SS_FORMING and fs.why != "" ? "\nwaiting: " + f_reasonText(fs.why) : "")
                row := f_dashRow(tb, row, "SETUP", stg, f_setColor(fs), tipS, sz)
                if fs.state >= SS_READY
                    color gc = fs.grade >= GR_A ? C_SIG : fs.grade == GR_B ? C_TEXT : C_NEUT
                    row := f_dashRow(tb, row, "QUALITY", str.tostring(fs.score, "0.0") + " / 10 · " + f_gradeName(fs.grade) + "  " + f_qualityBar(fs.score), gc, fs.factors + "Score = completeness of the setup, not a win probability", sz)
                    row := f_dashRow(tb, row, "PLAN", "E " + f_px(fs.entry) + " · SL " + f_px(fs.slInit) + " · TP1 " + f_px(fs.tp1), C_SIG, f_setPlanText(fs), sz)
                    row := f_dashRow(tb, row, "INVALID", f_px(fs.inv) + " · close " + (fs.dir == 1 ? "below" : "above"), C_BEAR, "Before the entry the setup is cancelled by a close beyond this level, an opposite swing CHoCH or a broken POI", sz)
        string stt = f_statusText(c, liveView)
        if stt != ""
            row := f_dashRow(tb, row, "STATUS", stt, C_WARN, "Setups and alerts are suppressed during warm-up; the panel always describes the latest bar", sz)
        // history: READY count, outcomes, and the most frequent reason a setup ended without a trade
        string topK = ""
        int topV = 0
        string all = ""
        array<string> ks = setStats.keys()
        for k in ks
            int v = setStats.get(k)
            all := all + k + "  " + str.tostring(v) + "\n"
            if k != "READY" and k != "WIN" and k != "SL" and v > topV
                topK := k
                topV := v
        string stxt = "READY " + str.tostring(nz(setStats.get("READY"))) + " · ✓" + str.tostring(nz(setStats.get("WIN"))) + " ✕" + str.tostring(nz(setStats.get("SL"))) + (topV > 0 ? " · " + str.lower(topK) + " " + str.tostring(topV) : "")
        row := f_dashRow(tb, row, "STATS", stxt, C_NEUT, "Whole loaded history: setups that reached READY, trades won (✓, at least TP1) and stopped (✕), and the most frequent reason a setup ended without a trade.\n\n" + all + "\nGRADE_LOW: score below the preset's READY grade · RR_LOW: last target closer than Min RR · SL_TOO_WIDE / SL_TOO_TIGHT: stop outside the limits · NO_POI / POI_IN_PREMIUM / POI_IN_DISCOUNT: no zone of the shift leg on the right side · NO_SHIFT_IN_WINDOW: no CHoCH / BOS after the sweep · SUPERSEDED: replaced by a newer setup · TP1_BEFORE_ENTRY: price ran away (MISSED)", sz)
        row := f_dashRow(tb, row, "CFG", str.tostring(cfgSig) + " · v" + BUILD, C_NEUT, "Settings signature: must equal the cfg number of SMC Visualizer Pro (Dashboard Expanded → MODE row). Different numbers mean the two indicators run the engines with different settings, and the setups do not match the structure on the chart.", sz)
        if row <= SET_PANEL_ROWS - 1
            table.clear(tb, 0, row, 1, SET_PANEL_ROWS - 1)
    true

// ═══ 90 · MAIN PIPELINE ═════════════════════════════════════════════════════════
// Fixed engine order per bar (docs §4.5): Data → Structure → Liquidity → Zones → Context → Setup.
// Logic runs only on confirmed bars; visuals run only on the last bar. The engine part is shared
// by both indicators (ADR-13); the Setup step, markers and setup visuals exist in SMC Pro · Setups,
// the history renderers and Ribbon / Dashboard / Debug in SMC Visualizer Pro.

// ── Logical state (registry: live sets + archives of finished objects)
var Core core = Core.new(barEvents = array.new<Event>(), history = array.new<Event>(), histCap = mc.debug ? 1000 : 300)
var StructState stI = f_newStruct(LV_INT, inLen)
var StructState stS = f_newStruct(LV_SWG, swLen)
var array<Liq> liqs = array.new<Liq>()
var array<Liq> liqArch = array.new<Liq>()
var array<Zone> zones = array.new<Zone>()
var array<Zone> zoneArch = array.new<Zone>()
var Range rng = Range.new()
var array<RangeSnap> rangeArch = array.new<RangeSnap>()
var Sess sAsia = Sess.new("Asia", "ASIA", "AH", "AL", specAsia)
var Sess sLon = Sess.new("London killzone", "LON KZ", "LOH", "LOL", specLon)
var Sess sNy = Sess.new("New York AM killzone", "NY KZ", "NYH", "NYL", specNy)
var array<SessBox> sessHist = array.new<SessBox>()
var array<Brk> htfBreaks = array.new<Brk>()
var Ctx ctx = Ctx.new()
var array<Setup> setups = array.new<Setup>()
var array<Setup> setupArch = array.new<Setup>()
var float confClose = na
// Per-bar close and ATR, so a scrolled-back view can rank objects at any past bar
var array<float> histClose = array.new<float>()
var array<float> histAtr = array.new<float>()
var int histBase = 0

// Engine steps that read the bar history are called on every calculation with the confirmed-bar
// flag cf and do their work only when it is set (CW10003); everything else stays in `if cf` blocks.
// The order of the steps is the fixed pipeline order (docs §4.5).
bool cf = barstate.isconfirmed
if cf
    core.barEvents.clear()
    confClose := close
    histClose.push(close)
    histAtr.push(vu)
    if histClose.size() > HIST_CAP
        histClose.shift()
        histAtr.shift()
        histBase += 1
    if not core.warm and bar_index >= warmBars
        core.warm := true
        f_emit(core, EV_SYS_WARM, 0, close, na, na, 4)
    // Data-level events
    if fvgUp
        core.lastFvgUpBar := bar_index
    if fvgDn
        core.lastFvgDnBar := bar_index
    if dispFvgUp
        Event du = f_emit(core, EV_DISP, 1, close, na, na, 3, body[1] / vu, na, 1)
        core.lastDispUpId := du.id
        core.lastDispUpBar := bar_index
    if dispFvgDn
        Event dd = f_emit(core, EV_DISP, -1, close, na, na, 3, body[1] / vu, na, 1)
        core.lastDispDnId := dd.id
        core.lastDispDnBar := bar_index
    // Sessions (feed session high/low key levels)
    if sesOk
        for q = 0 to 2
            f_sessStep(core, q == 0 ? sAsia : q == 1 ? sLon : sNy, q == 0 ? inAsia : q == 1 ? inLon : inNy, liqs, sessHist)
// Structure: internal, then swing
f_structStep(core, stI, phI, plI, cf)
f_structStep(core, stS, phS, plS, cf)
Brk iUp = stI.newUp
Brk iDn = stI.newDn
if cf
    if not na(iUp) and not na(stS.newUp)
        iUp.shadowed := true
    if not na(iDn) and not na(stS.newDn)
        iDn.shadowed := true
    int chochInt = 0
    if not na(iUp)
        chochInt := iUp.kind == BK_CHOCH ? 1 : 0
    if not na(iDn)
        chochInt := iDn.kind == BK_CHOCH ? -1 : chochInt
    // Liquidity: update existing levels, then add new ones (new levels are not checked on their birth bar)
    f_liqStep(core, liqs, liqArch, chochInt)
    if not na(stS.newHigh)
        f_liqAddSwing(core, liqs, stS.newHigh)
    if not na(stS.newLow)
        f_liqAddSwing(core, liqs, stS.newLow)
    if keyDayOk and newDay
        f_liqAddKey(core, liqs, LK_PDH, 1, pdH, pdT, "PDH")
        f_liqAddKey(core, liqs, LK_PDL, -1, pdL, pdT, "PDL")
    if keyWeekOk and newWeek
        f_liqAddKey(core, liqs, LK_PWH, 1, pwH, pwT, "PWH")
        f_liqAddKey(core, liqs, LK_PWL, -1, pwL, pwT, "PWL")
    // HTF Feed (§4.7): ingest confirmed HTF objects once; they then share the chart lifecycle
    if htfOk
        if htfNewBias
            f_emit(core, EV_HTF_BIAS, hBias, close, na, na, 1, na, na, na, htfLabel, TF_HTF1)
        // the bullish channel first: when one HTF bar broke both sides, the bearish break came last
        if htfNewBu
            f_htfBreak(core, htfBreaks, 1, hBuKind, hBuPx, hBuSwT, hBuT)
        if htfNewBd
            f_htfBreak(core, htfBreaks, -1, hBdKind, hBdPx, hBdSwT, hBdT)
        if htfNewPh and i_htfLiq
            f_liqAddHtf(core, liqs, 1, hPhP, hPhT)
        if htfNewPl and i_htfLiq
            f_liqAddHtf(core, liqs, -1, hPlP, hPlT)
        if htfNewOu
            f_zoneAddHtf(core, zones, ZK_OB, 1, hOuTop, hOuBot, hOuT)
        if htfNewOd
            f_zoneAddHtf(core, zones, ZK_OB, -1, hOdTop, hOdBot, hOdT)
        if htfNewFvg
            f_zoneAddHtf(core, zones, ZK_FVG, hFvgDir, hFvgTop, hFvgBot, hFvgT)
    // Zones: lifecycle of live zones (finished ones go to the archive), then births on this bar
    f_zoneStep(core, zones, zoneArch)
f_fvgNew(core, zones, 1, cf and fvgUp)
f_fvgNew(core, zones, -1, cf and fvgDn)
// order: swing up, swing down, then internal up, internal down (internal only if enabled and not shadowed by a swing break)
f_obFromBreak(core, zones, stS.newUp, stS, cf)
f_obFromBreak(core, zones, stS.newDn, stS, cf)
f_obFromBreak(core, zones, iUp, stS, cf and i_obInternal)
f_obFromBreak(core, zones, iDn, stS, cf and i_obInternal)
if cf
    // Context
    f_rangeStep(core, rng, stS, rangeArch)
    float pdNow = f_pdStep(core, rng)
    f_ctxBuild(ctx, stS, stI, rng, pdNow, liqs, sAsia, sLon, sNy, htfOk, htfLowHist, hBias)
    // Setups (P7): never during warm-up (AC-08)
    if i_setups and core.warm
        f_setupStep(core, setups, setupArch, stS, stI, liqs, zones, ctx, sLon.on or sNy.on)
    if i_log
        f_logEvents(core)

// Price-scale markers (§14.9): entry, SL and TP1 of the focus setup once it has a plan
var float pmE = na
var float pmSL = na
var float pmTP = na
if barstate.isconfirmed
    Setup pmS = i_setups ? f_focusSetup(setups, 0) : na
    bool pmOk = not na(pmS) and pmS.state >= SS_READY and pmS.state <= SS_TP2
    pmE := pmOk ? pmS.entry : na
    pmSL := pmOk ? pmS.slInit : na
    pmTP := pmOk ? pmS.tp1 : na
plot(i_priceMarkers ? pmE : na, "Setup entry", color = C_SIG, display = display.price_scale, editable = false)
plot(i_priceMarkers ? pmSL : na, "Setup SL", color = C_BEAR, display = display.price_scale, editable = false)
plot(i_priceMarkers ? pmTP : na, "Setup TP1", color = C_BULL, display = display.price_scale, editable = false)

// ── Visual pools (created once; creation order = z-order, §13.13)
var BoxPool pSetBox = BoxPool.new(array.new<box>())
var LinePool pSetLine = LinePool.new(array.new<line>())
var LabelPool pSetLab = LabelPool.new(array.new<label>())
if barstate.isfirst
    f_fillBoxPool(pSetBox, i_setups ? mc.poolSetBox : 0)
    f_fillLinePool(pSetLine, i_setups ? mc.poolSetLine : 0)
    f_fillLabelPool(pSetLab, i_setups ? mc.poolSetLab : 0)

// ── Panels
var table tSetup = i_setups and i_setPanel ? table.new(f_pos(i_setPanelPos), 2, SET_PANEL_ROWS, bgcolor = color.new(C_PANEL, F_PANEL), frame_color = C_PBORDER, frame_width = 1, border_width = 0) : na

// ── Render pass (call order decides who gets the label budget). v0.6: once on the last historical
// bar, then once per closed realtime bar. Logic changes only on confirmed bars, so there is nothing
// to redraw between closes; nothing depends on the visible range, so scrolling and zooming never
// re-run the script (user feedback: "lags, keeps redrawing").
if barstate.islastconfirmedhistory or (barstate.isrealtime and barstate.isconfirmed)
    float px = na(confClose) ? close : confClose
    View view = f_buildView(histClose, histAtr, histBase, px)
    pSetBox.used := 0
    pSetLine.used := 0
    pSetLab.used := 0
    f_renderSetups(view, pSetBox, pSetLine, pSetLab, setups, setupArch)
    f_finishBoxes(pSetBox)
    f_finishLines(pSetLine)
    f_finishLabels(pSetLab)
    Setup focus = i_setups ? f_focusSetup(setups, 0) : na
    f_setupPanel(tSetup, ctx, core, view.live, focus)

// ═══ 95 · ALERTS ════════════════════════════════════════════════════════════════
// Static alertcondition() set (docs §12.7). Conditions are read from the event bus of the
// confirmed bar — the alert engine never recomputes detector logic (A-03). No alerts
// during warm-up (AC-08). Chart-TF structure alerts ignore HTF events (separate conditions).
// Sweep, OB-touch and FVG-fill alerts also fire for HTF objects: those happen on chart bars,
// and their events carry tf = HTF1 for logs and the P9 webhook.
// Setup alerts also send a detailed alert() message; the batched JSON webhook arrives with P9.
// SMC Visualizer Pro carries the structure / liquidity / zone conditions, SMC Pro · Setups the
// setup conditions (ADR-13).
bool alertOk = barstate.isconfirmed and core.warm and core.barEvents.size() > 0
// Setups: READY / TRIGGERED / INVALID from the alert grade on (grade is v3 of these events)
f_setupEv(Core c, int typ, int minGrade) =>
    Event hit = na
    for e in c.barEvents
        if na(hit) and e.typ == typ and nz(e.v3) >= minGrade
            hit := e
    hit

Event evReady = alertOk and i_setups ? f_setupEv(core, EV_SETUP_READY, setAlertGrade) : na
Event evTrig = alertOk and i_setups ? f_setupEv(core, EV_SETUP_TRIGGERED, setAlertGrade) : na
Event evInv = alertOk and i_setups ? f_setupEv(core, EV_SETUP_INVALID, setAlertGrade) : na
bool aSetReady = not na(evReady)
bool aSetTrig = not na(evTrig)
bool aSetInv = not na(evInv)

// One message per bar close for the alert "Any alert() function call" (§12.7, ADR-08): text or the
// JSON webhook envelope (50_webhook). Alerts fire only in realtime, so the message is built there;
// with Debug + "log events" it is also written to Pine Logs on every bar, to inspect the JSON.
bool whLog = mc.debug and i_log
if barstate.isconfirmed and core.warm and (barstate.isrealtime or whLog)
    bool whLive = false
    for s in setups
        whLive := whLive or (s.state >= SS_READY and s.state <= SS_TP2 and s.grade >= setAlertGrade)
    bool whSnap = i_whSnap > 0 and bar_index % i_whSnap == 0 and core.barEvents.size() == 0 and whLive
    [whMsg, whN] = f_whMessage(core, ctx, setups, setupArch, whSnap)
    if whN > 0 or whSnap
        alert(whMsg, alert.freq_once_per_bar_close)
        if whLog
            log.info(whMsg)


alertcondition(aSetReady, "Setup READY", "SMC Pro · {{ticker}} {{interval}} · setup READY (grade ≥ alert min grade) · close {{close}}")
alertcondition(aSetTrig, "Setup TRIGGERED", "SMC Pro · {{ticker}} {{interval}} · setup entry reached · close {{close}}")
alertcondition(aSetInv, "Setup INVALID", "SMC Pro · {{ticker}} {{interval}} · setup invalidated before entry · close {{close}}")
