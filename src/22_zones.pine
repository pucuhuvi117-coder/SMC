// ═══ 22 · ZONE ENGINE ═══════════════════════════════════════════════════════════
// Order blocks and fair value gaps with explicit lifecycles; Breaker / Mitigation Block /
// IFVG are outcomes of a broken zone (Appendix A.7, A.8, A.10, §7.3–7.4, ADR-07).

f_zoneStrength(float disp, float size, float vr) =>
    float sd = math.min(1.0, disp / 2.5)
    float ss = math.min(1.0, size / vu / 1.5)
    na(vr) ? 0.8 * sd + 0.2 * ss : 0.6 * sd + 0.2 * ss + 0.2 * math.min(1.0, vr / 2.0)

// Latest pivot of one side on a structure level that formed before a given bar
f_swingBefore(StructState st, int side, int beforeBar) =>
    float p = na
    int n = st.swings.size()
    if n > 0
        for i = n - 1 to 0
            Swing s = st.swings.get(i)
            if s.side == side and s.bar < beforeBar
                p := s.price
                break
    p

// Order block from a structure break (A.7)
f_obFromBreak(Core c, array<Zone> zs, Brk b, StructState swSt) =>
    int dir = b.dir
    bool ok = bar_index - (b.origBar - OB_NPRE) <= MAXBACK_GUARD
    bool created = false
    // d: first displacement bar of the impulse (fallback: first candle in break direction)
    int d = b.firstDisp
    if ok and na(d)
        if b.origBar < bar_index
            for k = b.origBar + 1 to bar_index
                int off = bar_index - k
                if (dir == 1 and close[off] > open[off]) or (dir == -1 and close[off] < open[off])
                    d := k
                    break
        if na(d)
            d := bar_index
    // j: last opposite candle in [origin - nPre, d - 1]
    int j = na
    bool fb = false
    if ok
        int lo = math.max(b.origBar - OB_NPRE, d - OB_MAX_SEARCH)
        int hi = d - 1
        if hi >= lo
            for k = hi to lo
                int off = bar_index - k
                if (dir == 1 and close[off] < open[off]) or (dir == -1 and close[off] > open[off])
                    j := k
                    break
        if na(j)
            j := b.origBar
            fb := true
    if ok and not na(j)
        int offJ = bar_index - j
        float o = open[offJ]
        float cl = close[offJ]
        float h = high[offJ]
        float l = low[offJ]
        float top = math.max(o, cl)
        float bot = math.min(o, cl)
        if i_obZone == ObZone.full
            top := h
            bot := l
        else if i_obZone == ObZone.bodyWick
            top := dir == 1 ? math.max(o, cl) : h
            bot := dir == 1 ? l : math.min(o, cl)
        float sz = top - bot
        if sz > obMax * vu and i_obZone != ObZone.body
            top := math.max(o, cl)
            bot := math.min(o, cl)
            sz := top - bot
        bool pass = sz >= obMin * vu and sz <= obMax * vu and sz > 0
        if pass and i_obReqDisp and b.disp < i_obDispMin
            pass := false
        // peak relative volume of the impulse
        float vrMax = na
        if pass and hasVolume and d <= bar_index
            for k = d to bar_index
                float vr = volRatio[bar_index - k]
                if not na(vr)
                    vrMax := na(vrMax) ? vr : math.max(vrMax, vr)
        if pass and i_volFilter and hasVolume and not na(vrMax) and vrMax < i_volMult
            pass := false
        // integrity: closed through before birth → reject; traded into after the impulse → touched
        bool touched = false
        if pass and j < bar_index
            for k = j + 1 to bar_index
                int off = bar_index - k
                if (dir == 1 and close[off] < bot) or (dir == -1 and close[off] > top)
                    pass := false
                    break
                if k > d and ((dir == 1 and low[off] <= top) or (dir == -1 and high[off] >= bot))
                    touched := true
        // dedupe: the same candle from internal and swing breaks is one OB
        int tJ = time[offJ]
        if pass
            int n = zs.size()
            if n > 0
                for i = n - 1 to 0
                    Zone z = zs.get(i)
                    if z.kind == ZK_OB and z.dir == dir and z.t == tJ
                        pass := false
                        if b.lvl > z.lvl
                            z.lvl := b.lvl
                        break
        if pass
            float extRef = b.lvl == LV_SWG ? na : f_swingBefore(swSt, dir, b.origBar)
            float strength = f_zoneStrength(b.disp, sz, vrMax) * (fb ? 0.7 : 1.0)
            Zone z = Zone.new(id = f_nextId(c), kind = ZK_OB, dir = dir, state = touched ? ZS_TOUCHED : ZS_FRESH, top = top, bottom = bot, bar = j, t = tJ, born = bar_index, touches = touched ? 1 : 0, strength = strength, disp = b.disp, extRef = extRef, legExt = b.legExt1, brkId = b.id, lvl = b.lvl, tf = TF_CHART, fallback = fb)
            zs.push(z)
            f_emit(c, EV_ZONE_NEW, dir, (top + bot) / 2, z.id, b.evId, 2, ZK_OB, top, bot, "OB")
            created := true
    created

// Fair value gap on the current (third) candle (A.10)
f_fvgNew(Core c, array<Zone> zs, int dir) =>
    float top = dir == 1 ? low : low[2]
    float bot = dir == 1 ? high[2] : high
    float sz = top - bot
    bool disp = dir == 1 ? isDispUp[1] : isDispDn[1]
    float strength = 0.6 * (disp ? math.min(1.0, body[1] / vu / 2.0) : 0.2) + 0.4 * math.min(1.0, sz / vu)
    Zone z = Zone.new(id = f_nextId(c), kind = ZK_FVG, dir = dir, state = ZS_FRESH, top = top, bottom = bot, bar = bar_index - 2, t = time[2], born = bar_index, unfilled = dir == 1 ? top : bot, strength = strength, disp = disp ? body[1] / vu : 0.0, lvl = LV_SWG, tf = TF_CHART)
    zs.push(z)
    int cause = disp ? (dir == 1 ? c.lastDispUpId : c.lastDispDnId) : na
    f_emit(c, EV_ZONE_NEW, dir, (top + bot) / 2, z.id, cause, 2, ZK_FVG, top, bot, "FVG")
    z

f_zoneEvent(Core c, Zone z, int typ, int tier, float v2 = na) =>
    f_emit(c, typ, z.dir, close, z.id, na, tier, z.kind, v2, z.touches, f_kindTag(z.kind))

// Lifecycle for OB / BB / MB / IFVG (§7.3)
f_obLife(Core c, array<Zone> zs, Zone z) =>
    bool bull = z.dir == 1
    float h = math.max(z.top - z.bottom, syminfo.mintick)
    float mid = (z.top + z.bottom) / 2
    if z.kind == ZK_OB and not na(z.legExt)
        z.legExt := bull ? math.max(z.legExt, high) : math.min(z.legExt, low)
    bool broken = bull ? close < z.bottom : close > z.top
    if broken
        z.endBar := bar_index
        z.endT := time
        Event be = f_zoneEvent(c, z, EV_ZONE_BROKEN, 2)
        if z.kind == ZK_OB and i_breakers
            bool swept = z.lvl == LV_SWG or (not na(z.extRef) and not na(z.legExt) and (bull ? z.legExt > z.extRef : z.legExt < z.extRef))
            int nk = swept ? ZK_BB : ZK_MB
            Zone nz = Zone.new(id = f_nextId(c), kind = nk, dir = -z.dir, state = ZS_FRESH, top = z.top, bottom = z.bottom, bar = z.bar, t = z.t, born = bar_index, strength = z.strength * 0.9, disp = z.disp, parent = z.id, brkId = z.brkId, lvl = z.lvl, tf = z.tf)
            zs.push(nz)
            z.state := ZS_CONVERTED
            f_emit(c, EV_ZONE_CONVERTED, nz.dir, (nz.top + nz.bottom) / 2, nz.id, be.id, 2, nk, z.id, na, f_kindTag(nk))
        else
            z.state := ZS_INVALID
    else
        bool inZone = bull ? low <= z.top : high >= z.bottom
        if inZone
            float pen = bull ? (z.top - low) / h : (high - z.bottom) / h
            pen := math.max(0.0, math.min(1.0, pen))
            z.maxPen := math.max(z.maxPen, pen)
            bool newTouch = bull ? low[1] > z.top : high[1] < z.bottom
            if newTouch
                z.touches := z.touches + 1
            if z.state == ZS_FRESH
                z.state := ZS_TOUCHED
                f_zoneEvent(c, z, EV_ZONE_TOUCHED, 2, pen)
            if z.state == ZS_TOUCHED
                bool mit = i_mitRule == MitRule.touch ? true : i_mitRule == MitRule.half ? (bull ? low <= mid : high >= mid) : (bull ? low <= z.bottom : high >= z.top)
                if mit
                    z.state := ZS_MITIGATED
                    f_zoneEvent(c, z, EV_ZONE_MITIGATED, 3, z.maxPen)
    true

// Lifecycle for FVG (§7.4)
f_fvgLife(Core c, array<Zone> zs, Zone z) =>
    bool bull = z.dir == 1
    float mid = (z.top + z.bottom) / 2
    bool inZone = bull ? low <= z.top : high >= z.bottom
    if inZone
        if z.state == ZS_FRESH
            z.state := ZS_PARTIAL
            z.touches := 1
            f_zoneEvent(c, z, EV_ZONE_TOUCHED, 2)
        z.unfilled := bull ? math.max(z.bottom, math.min(z.unfilled, low)) : math.min(z.top, math.max(z.unfilled, high))
        if z.state == ZS_PARTIAL and (bull ? low <= mid : high >= mid)
            z.state := ZS_CE
            f_zoneEvent(c, z, EV_ZONE_CE, 3)
        bool filled = i_fillRule == FillRule.wick ? (bull ? low <= z.bottom : high >= z.top) : i_fillRule == FillRule.closeEdge ? (bull ? close <= z.bottom : close >= z.top) : (bull ? low <= mid : high >= mid)
        if filled
            z.endBar := bar_index
            z.endT := time
            Event fe = f_zoneEvent(c, z, EV_ZONE_FILLED, 3)
            bool inv = i_ifvg and (bull ? close < z.bottom : close > z.top)
            if inv
                Zone nz = Zone.new(id = f_nextId(c), kind = ZK_IFVG, dir = -z.dir, state = ZS_FRESH, top = z.top, bottom = z.bottom, bar = z.bar, t = z.t, born = bar_index, strength = z.strength, disp = z.disp, parent = z.id, lvl = z.lvl, tf = z.tf)
                zs.push(nz)
                z.state := ZS_CONVERTED
                f_emit(c, EV_ZONE_CONVERTED, nz.dir, (nz.top + nz.bottom) / 2, nz.id, fe.id, 2, ZK_IFVG, z.id, na, "IFVG")
            else
                z.state := ZS_FILLED
    true

// Confirmed-bar step for all zones: lifecycle, expiry, cleanup, cap
f_zoneStep(Core c, array<Zone> zs, int keep) =>
    int n = zs.size()
    if n > 0
        for i = n - 1 to 0
            Zone z = zs.get(i)
            if z.state < ZS_FILLED
                if z.born < bar_index
                    if z.kind == ZK_FVG
                        f_fvgLife(c, zs, z)
                    else
                        f_obLife(c, zs, z)
                if z.state < ZS_FILLED
                    float dist = close > z.top ? close - z.top : close < z.bottom ? z.bottom - close : 0.0
                    int maxAge = z.kind == ZK_FVG or z.kind == ZK_IFVG ? FVG_MAX_AGE : OB_MAX_AGE
                    if bar_index - z.born > maxAge or dist > ZONE_MAX_DIST * vu
                        z.state := ZS_EXPIRED
                        z.endBar := bar_index
                        z.endT := time
                        f_zoneEvent(c, z, EV_ZONE_EXPIRED, 4)
            else if bar_index - z.endBar > keep
                zs.remove(i)
    if zs.size() > ZONE_CAP
        int idx = 0
        for [i, z] in zs
            if z.state >= ZS_FILLED
                idx := i
                break
        zs.remove(idx)
    true
