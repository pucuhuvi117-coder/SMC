// ═══ 61 · VISUAL PRIORITY ═══════════════════════════════════════════════════════
// Relevance Score R ∈ [0, 1] (docs §16). Visual-only: never read by logic (ADR-11).
// Components: H (timeframe), P (proximity), F (freshness), A (activity), S (strength),
// L (liquidity importance), U (setup relevance — 0 until the Setup Engine lands in P7).
// v0.2: R is measured at an anchor (a segment's last bar, its close and ATR), so a
// scrolled-back view ranks objects as they mattered at that moment.

f_zoneDistAt(Zone z, float px, float atr) =>
    px > z.top ? (px - z.top) / atr : px < z.bottom ? (z.bottom - px) / atr : 0.0

f_zoneActivity(Zone z) =>
    switch z.state
        ZS_FRESH => z.kind == ZK_OB or z.kind == ZK_FVG ? 1.0 : 0.8
        ZS_TOUCHED => 0.7
        ZS_PARTIAL => 0.7
        ZS_CE => 0.6
        ZS_MITIGATED => 0.4
        => 0.1

// alive: the zone still existed at the anchor bar
f_zoneRAt(Zone z, float px, float atr, int anchor, bool alive) =>
    float d = f_zoneDistAt(z, px, atr)
    float p = d <= 0 ? 1.0 : math.max(0.0, 1.0 - d / mc.distMax)
    float h = z.tf == TF_CHART ? 0.5 : 0.85
    float f = math.pow(0.5, math.max(0, anchor - z.born) / 150.0)
    float a = alive ? (z.state < ZS_FILLED ? f_zoneActivity(z) : 0.7) : 0.3
    float s = z.strength
    bool fv = z.kind == ZK_FVG or z.kind == ZK_IFVG
    float wH = fv ? 0.15 : 0.20
    float wP = fv ? 0.30 : 0.25
    float wF = fv ? 0.20 : 0.15
    float wA = 0.15
    float wS = fv ? 0.10 : 0.15
    float wU = 0.10
    (wH * h + wP * p + wF * f + wA * a + wS * s) / (wH + wP + wF + wA + wS + wU)

f_liqMajorAt(Liq x, int anchor) =>
    x.kind != LK_SWING or x.touches >= 2 or anchor - x.bar >= i_oldAge

f_liqRAt(Liq x, float px, float atr, int anchor) =>
    float d = math.abs(px - x.price) / atr
    float p = math.max(0.0, 1.0 - d / mc.distMax)
    float h = x.kind == LK_PWH or x.kind == LK_PWL ? 1.0 : x.kind == LK_PDH or x.kind == LK_PDL ? 0.9 : 0.5
    float f = math.pow(0.5, math.max(0, anchor - x.born) / 150.0)
    float a = x.state == LS_PENDING ? 0.7 : 1.0
    float age = math.min(1.0, math.max(0, anchor - x.bar) / math.max(1.0, i_oldAge))
    float l = x.kind != LK_SWING ? 1.0 : 0.4 * (f_liqMajorAt(x, anchor) ? 1.0 : 0.0) + 0.3 * math.min(1.0, (x.touches - 1) / 3.0) + 0.3 * age
    0.20 * h + 0.25 * p + 0.05 * f + 0.15 * a + 0.25 * l
