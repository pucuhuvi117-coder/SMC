// ═══ 02 · TYPES ═════════════════════════════════════════════════════════════════
// Logical objects never hold drawing handles (docs §8.1): they stay serializable and
// reusable by the strategy build. Drawings live only in the visual pools (§8.4).

enum DisplayMode
    clean = "Clean"
    normal = "Normal"
    analysis = "Analysis"
    debug = "Debug"
    custom = "Custom"

enum ThemeOpt
    auto = "Auto"
    dark = "Dark"
    light = "Light"

enum PaletteOpt
    standard = "Standard"
    cvd = "Color-blind safe"

enum Verbosity
    icons = "Icons"
    brief = "Short"
    full = "Full"

enum StructPreset
    scalp = "Scalp 5/2"
    intraday = "Intraday 10/3"
    swing = "Swing 20/5"
    manual = "Manual"

enum BreakSrc
    onClose = "Close"
    wick = "Wick"

enum ObZone
    full = "Full"
    bodyWick = "Body+Wick"
    body = "Body"

enum MitRule
    touch = "Touch"
    half = "50%"
    full = "Full"

enum FillRule
    wick = "Wick far edge"
    closeEdge = "Close far edge"
    ce = "CE (50%)"

enum PdView
    off = "Off"
    eqOnly = "EQ only"
    eqOte = "EQ + OTE"
    full = "Full (wash)"

enum SesPreset
    ictNy = "ICT (NY)"
    originalUtc = "Original (UTC)"
    custom = "Custom"

enum SesView
    rangeBox = "Range box"
    off = "Off"

enum Visibility
    subtle = "Subtle"
    standard = "Standard"
    bold = "Bold"

enum PanelSize
    small = "Small"
    normal = "Normal"
    large = "Large"

enum HtfMode
    auto = "Auto"
    manual = "Manual"
    off = "Off"

enum HistView
    visible = "History window"
    recent = "Recent only"

enum SetPreset
    balanced = "Balanced"
    conservative = "Conservative"
    aggressive = "Aggressive"

enum EntryMode
    ce = "CE (50%)"
    edge = "Zone edge"
    ote = "OTE 0.705"

enum SlMode
    auto = "Auto (by model)"
    poi = "Beyond POI"
    atr = "ATR × 1.5"

enum TpMode
    liq = "Liquidity"
    rr = "RR 1 / 2 / 3"

enum GradeOpt
    c = "C"
    b = "B"
    a = "A"
    ap = "A+"

// Immutable fact about a state transition, emitted on a confirmed bar (§6.2)
type Event
    int id
    int typ
    int dir = 0
    int tf = 0
    int bar
    int t
    float price
    int ref
    int cause
    int tier = 3
    float v1
    float v2
    float v3
    string s1 = ""

// Event bus + id registry (§6.3)
type Core
    int nextId = 0
    array<Event> barEvents
    array<Event> history
    int histCap = 300
    int lastDispUpId
    int lastDispUpBar
    int lastDispDnId
    int lastDispDnBar
    int lastFvgUpBar
    int lastFvgDnBar
    Event lastStruct
    Event lastHtfStruct
    Event lastLiq
    bool warm = false

type Swing
    int id
    int side
    int lvl
    float price
    int bar
    int t
    int confirmBar
    string tag = ""
    bool eq = false
    bool broken = false

// Structure break (BOS / CHoCH). legExt0 is the leg origin extreme, legExt1 the far extreme.
type Brk
    int id
    int kind
    int dir
    int lvl
    float price
    int swingBar
    int swingT
    int bar
    int t
    float legExt0
    float legExt1
    int origBar
    int origT
    int firstDisp
    float disp
    bool mss = false
    bool initial = false
    bool shadowed = false
    int evId
    int tf = 0

// Structure automaton for one level (internal or swing) on one TF (§7.1)
type StructState
    int lvl
    int len
    int trend = 0
    Swing refHigh
    Swing refLow
    Swing lastHigh
    Swing lastLow
    float upOrigLow
    int upOrigBar
    int upOrigT
    float upLegHigh
    int upFirstDisp
    float dnOrigHigh
    int dnOrigBar
    int dnOrigT
    float dnLegLow
    int dnFirstDisp
    float protLow
    float protHigh
    int lastBrkBar
    int lastBrkDir = 0
    int lastBrkKind = 0
    int prevBrkBar
    int prevBrkDir = 0
    int prevBrkKind = 0
    Brk newUp
    Brk newDn
    Swing newHigh
    Swing newLow
    array<Swing> swings
    array<Brk> breaks

// Liquidity level (§7.2). side +1 = BSL, -1 = SSL.
type Liq
    int id
    int side
    int kind
    int tf = 0
    float price
    int bar
    int t
    int born
    int lastBar
    int touches = 1
    bool major = false
    int state = 1
    int pendSince
    float ext
    int endBar
    int endT
    int sweepType = 0
    int lvl = 1
    string tag = ""
    int hBorn

// Unified zone model for OB / BB / MB / FVG / IFVG (§8.3, ADR-07)
type Zone
    int id
    int kind
    int dir
    int state = 1
    float top
    float bottom
    int bar
    int t
    int born
    int bornT
    int endBar
    int endT
    int touches = 0
    float maxPen = 0.0
    float unfilled
    float strength = 0.0
    float disp = 0.0
    float extRef
    float legExt
    int parent
    int brkId
    int lvl = 1
    int tf = 0
    bool fallback = false
    int hBorn
    float nearD

// Dealing range (§7.5). state: 0 none, 1 developing, 2 established.
type Range
    int id
    int dir = 0
    int state = 0
    float hi
    float lo
    int hiBar
    int loBar
    int t0
    int b0
    int pdZone = 0
    bool inOte = false

// Finished dealing range kept for history rendering
type RangeSnap
    int dir
    float hi
    float lo
    int t0
    int t1
    int b0
    int b1

type Sess
    string name
    string code
    string tagHi
    string tagLo
    string spec
    bool on = false
    float hi
    float lo
    int t0
    int b0
    int endT

type SessBox
    string code
    float hi
    float lo
    int t0
    int t1
    int b0
    int b1

// Market context snapshot for Ribbon / Dashboard (§8.3)
type Ctx
    int market = 0
    int swTrend = 0
    int inTrend = 0
    bool ranging = false
    float pd
    int pdZone = 0
    bool inOte = false
    int rangeState = 0
    string sessCode = ""
    int minsLeft
    Liq nextBsl
    Liq nextSsl
    bool htfOk = false
    bool htfLow = false
    int htfTrend = 0

//#if setups
// Alert message (§12.7) and the events it carries
enum AlertFmt
    plain = "Text"
    json = "JSON (webhook)"

enum WhScope
    setups = "Setups"
    key = "Setups + key events"
    all = "All events (min tier)"

// Setup: an evolving trade hypothesis with its evidence, plan and score (§7.7, §9, §10).
// v1.0 setups are analytical: drawn and alerted, never executed. The DRAFT TradePlan
// (entry / SL / targets / RR) is kept inside the setup until the P9 webhook needs it apart.
type Setup
    int id
    int model
    int dir
    int state
    int bornBar
    int bornT
    int stageBar
    // liquidity component
    int sweepEvId
    int sweptLiqId
    float sweepExt
    bool sweepMajor = false
    string sweepTag = ""
    int sweepBar
    int sweepT
    float sweepPx
    bool contSweep = false
    // shift component
    int shiftEvId
    int shiftBrkId
    int shiftBar
    int shiftT
    int shiftLvl
    int shiftKind
    bool isMSS = false
    float disp
    float shiftPx
    int shiftSwT
    // location: range built by the shift leg
    float rLo
    float rHi
    int legBar
    // POI
    Zone poi
    Zone poiAlt
    bool combo = false
    float entryTop
    float entryBot
    // plan (DRAFT TradePlan)
    float entry
    float sl
    float slInit
    float inv
    float tp1
    float tp2
    float tp3
    string tp1Tag = ""
    string tp2Tag = ""
    string tp3Tag = ""
    int nTp = 0
    float rrFinal
    bool drawLiq = false
    string drawTxt = ""
    // score
    float score = 0.0
    int grade = 0
    string factors = ""
    string chain = ""
    string chainMid = ""
    string why = ""
    bool kz = false
    // lifecycle
    int readyBar
    int readyT
    int trigBar
    int trigT
    int endBar
    int endT
    int tpHit = 0
    bool be = false
    float rReal = 0.0
    string reason = ""
//#endif

// Display mode ceilings (§15.3, §19.2). SMC Pro · Setups gets a short type with only the
// fields it reads: the full rows cost it ~600 tokens of compile budget (ADR-13).
//#if core
type ModeCfg
    int structEvents
    int internalEvents
    bool swingLabels
    int zonesPerSide
    int majorPerSide
    int minorPerSide
    int sweptShow
    float distMax
    float theta
    int ttl
    int hist
    bool mitigated
    int pdCap
    bool gauge
    int sessions
    bool dashboard
    int labelLevel
    bool debug
    int structWin
    int internalWin
    int swingLabelWin
    int sweepWin
    int sessWin
    int rangeWin
    int poolZone
    int poolWash
    int poolLvl
    int poolStr
    int poolLab
    int htfStructEvents
    int htfStructWin
    int keyCap
    int gradeFloor = 1
    int setupPast = 0
    int poolSetBox = 8
    int poolSetLine = 16
    int poolSetLab = 16
//#else
type ModeCfg
    float distMax
    int hist
    int labelLevel
    bool debug
    int gradeFloor = 1
    int setupPast = 0
    int poolSetBox = 8
    int poolSetLine = 16
    int poolSetLab = 16
//#endif

// What the render pass draws: a bar window, split into time segments. Each segment ranks
// objects against its own anchor (close and ATR at the segment's last bar), so a wide or
// scrolled-back view keeps the same density as the live edge (docs §15, AC-M16).
type View
    bool vp
    bool live
    int iL
    int iR
    int segs = 1
    array<int> segEnd
    array<float> segPx
    array<float> segAtr
    float winLo
    float winHi
    int tL

// Visual pools: drawings are created once and reused (§4.9)
type BoxPool
    array<box> items
    int used = 0

type LinePool
    array<line> items
    int used = 0

type LabelPool
    array<label> items
    int used = 0

// Right-edge tag for levels, merged by Smart Labels (§14.7)
type Tag
    float price
    string txt
    color col
    string tip
