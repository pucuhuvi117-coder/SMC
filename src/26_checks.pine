// ═══ 26 · DEBUG SELF-CHECKS ═════════════════════════════════════════════════════
// P11: invariants of the engines, checked on confirmed bars in Debug mode only (no cost otherwise).
// A violation is written to Pine Logs as `ASSERT|time|what` and counted; the count is shown in the
// Debug table (SMC Visualizer Pro) and in the STATS row (SMC Pro · Setups). Read-only.

var array<int> assertN = array.new<int>(1, 0)

f_assert(bool ok, string what) =>
    if not ok
        assertN.set(0, assertN.get(0) + 1)
        log.error("ASSERT|" + f_timeStr(time) + "|" + what)
    ok

f_engineChecks(Core c, array<Zone> zs, array<Liq> lv, StructState sw, StructState si) =>
    for z in zs
        if z.state < ZS_FILLED
            string id = f_kindTag(z.kind) + " #" + str.tostring(z.id) + " "
            f_assert(z.top > z.bottom, id + "top not above bottom")
            f_assert(z.born <= bar_index, id + "born in the future")
            f_assert(z.kind != ZK_FVG or na(z.unfilled) or (z.unfilled >= z.bottom - syminfo.mintick and z.unfilled <= z.top + syminfo.mintick), id + "unfilled edge outside the gap")
    for x in lv
        if x.state == LS_PENDING
            f_assert(not na(x.ext) and not na(x.pendSince), "level #" + str.tostring(x.id) + " pending without extreme")
    f_assert(math.abs(sw.trend) <= 1 and math.abs(si.trend) <= 1, "structure trend out of range")
    int n = c.barEvents.size()
    if n > 1
        for i = 1 to n - 1
            f_assert(c.barEvents.get(i).id > c.barEvents.get(i - 1).id, "event ids not increasing")
    true
