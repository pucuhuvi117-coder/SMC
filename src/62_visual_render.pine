// ═══ 62 · VISUAL RENDERERS ══════════════════════════════════════════════════════
// Immediate-mode rendering into pre-created object pools (§4.9): every pass takes objects
// from the pools in priority order and hides what is left. Runs only on the last bar,
// so historical bars draw nothing (ADR-02). Selection uses the last confirmed close at
// the live edge, which keeps the picture stable between realtime ticks (AC-M13).
// v0.2: everything is drawn for a View — the visible range split into time segments,
// or the recent window — so history keeps the same density as the live edge.
// v0.3: each segment gets its share of every pool, and picks inside a segment are spread
// over time slots, so the left part of the screen is never starved.

// ── Pools
f_fillBoxPool(BoxPool p, int n) =>
    if n > 0
        for i = 1 to n
            p.items.push(box.new(int(na), float(na), int(na), float(na), xloc = xloc.bar_time, border_color = color(na), bgcolor = color(na)))
    p.items.size()

f_fillLinePool(LinePool p, int n) =>
    if n > 0
        for i = 1 to n
            p.items.push(line.new(int(na), float(na), int(na), float(na), xloc = xloc.bar_time, color = color(na)))
    p.items.size()

f_fillLabelPool(LabelPool p, int n) =>
    if n > 0
        for i = 1 to n
            p.items.push(label.new(int(na), float(na), "", xloc = xloc.bar_time, color = color(na), textcolor = color(na), style = label.style_none))
    p.items.size()

method takeBox(BoxPool this) =>
    box b = na
    if this.used < this.items.size()
        b := this.items.get(this.used)
        this.used := this.used + 1
    b

method takeLine(LinePool this) =>
    line ln = na
    if this.used < this.items.size()
        ln := this.items.get(this.used)
        this.used := this.used + 1
    ln

method takeLabel(LabelPool this) =>
    label lb = na
    if this.used < this.items.size()
        lb := this.items.get(this.used)
        this.used := this.used + 1
    lb

f_finishBoxes(BoxPool p) =>
    int n = p.items.size()
    if p.used < n
        for i = p.used to n - 1
            box b = p.items.get(i)
            box.set_bgcolor(b, color(na))
            box.set_border_color(b, color(na))
            box.set_text(b, "")
    p.used

f_finishLines(LinePool p) =>
    int n = p.items.size()
    if p.used < n
        for i = p.used to n - 1
            line.set_color(p.items.get(i), color(na))
    p.used

f_finishLabels(LabelPool p) =>
    int n = p.items.size()
    if p.used < n
        for i = p.used to n - 1
            label lb = p.items.get(i)
            label.set_text(lb, "")
            label.set_tooltip(lb, "")
            label.set_textcolor(lb, color(na))
            label.set_color(lb, color(na))
    p.used

// ── Primitive setters
// Box text is only used for Debug IDs; zone tags go to the right-edge column (v0.3).
f_box(BoxPool p, int l, int r, float top, float bot, color fill, color border, int bw, string bst, string txt, color tc, string halign) =>
    box b = p.takeBox()
    if not na(b)
        box.set_lefttop(b, l, top)
        box.set_rightbottom(b, r, bot)
        box.set_bgcolor(b, fill)
        box.set_border_color(b, border)
        box.set_border_width(b, bw)
        box.set_border_style(b, bst)
        box.set_text(b, txt)
        box.set_text_color(b, tc)
        box.set_text_size(b, size.tiny)
        box.set_text_halign(b, halign)
        box.set_text_valign(b, text.align_center)
    not na(b)

f_line(LinePool p, int x1, float y1, int x2, float y2, color c, string st, int w) =>
    line ln = p.takeLine()
    if not na(ln)
        line.set_xy1(ln, x1, y1)
        line.set_xy2(ln, x2, y2)
        line.set_color(ln, c)
        line.set_style(ln, st)
        line.set_width(ln, w)
    not na(ln)

f_label(LabelPool p, int x, float y, string txt, color tc, string st, string sz, string tip, string yl) =>
    label lb = p.takeLabel()
    if not na(lb)
        label.set_xy(lb, x, y)
        label.set_yloc(lb, yl)
        label.set_text(lb, txt)
        label.set_textcolor(lb, tc)
        label.set_color(lb, color(na))
        label.set_style(lb, st)
        label.set_size(lb, sz)
        label.set_tooltip(lb, tip)
        label.set_textalign(lb, text.align_left)
    not na(lb)

// ── Right-edge tags with Smart Labels merging (§14.7). The merge distance grows with the
// visible price span, so tags never print on top of each other when zoomed out.
f_drawTags(LabelPool p, array<Tag> tags, int x, float sep) =>
    int n = tags.size()
    if n > 0
        array<float> ps = array.new<float>()
        for tg in tags
            ps.push(tg.price)
        array<int> idx = ps.sort_indices(order.ascending)
        float curP = na
        string curT = ""
        string curTip = ""
        color curC = na
        for k = 0 to n - 1
            Tag tg = tags.get(idx.get(k))
            if i_smartLabels and not na(curP) and tg.price - curP < sep
                curT := curT + " · " + tg.txt
                curTip := curTip + "\n" + tg.tip
            else
                if not na(curP)
                    f_label(p, x, curP, curT, curC, label.style_label_left, size.tiny, curTip, yloc.price)
                curP := tg.price
                curT := tg.txt
                curTip := tg.tip
                curC := tg.col
        if not na(curP)
            f_label(p, x, curP, curT, curC, label.style_label_left, size.tiny, curTip, yloc.price)
    n

// ── View: visible range (or recent window) split into time segments (§15, AC-M16)
f_histAt(array<float> a, int base, int idx, float dflt) =>
    int k = idx - base
    k >= 0 and k < a.size() ? a.get(k) : dflt

f_buildView(int vpBarL, int vpBarR, array<float> hc, array<float> ha, int hb, float pxLive) =>
    bool vp = vHistory and not na(vpBarL) and not na(vpBarR) and vpBarR >= vpBarL
    int iR = vp ? vpBarR : bar_index
    int iL = vp ? vpBarL : math.max(0, bar_index - histDepth)
    bool live = iR >= bar_index - 1
    if live
        iR := bar_index
    int w = iR - iL + 1
    // v0.3: a segment is at most SEG_BARS wide, so even the default zoom has two anchors
    int segs = vp ? math.max(1, math.min(SEG_MAX, int(math.ceil(w / SEG_BARS)))) : 1
    View v = View.new(vp, live, iL, iR, segs, array.new<int>(), array.new<float>(), array.new<float>())
    for s = 0 to segs - 1
        int e = s == segs - 1 ? iR : iL + int(math.round((s + 1) * w / segs)) - 1
        v.segEnd.push(e)
        v.segPx.push(e >= bar_index ? pxLive : f_histAt(hc, hb, e, pxLive))
        v.segAtr.push(e >= bar_index ? vu : f_histAt(ha, hb, e, vu))
    // visible range only: left edge time (label clamping) and price span of the closes
    // (label spacing that follows the zoom)
    if vp
        v.tL := chart.left_visible_bar_time
        float lo = na
        float hi = na
        for k = iL to iR
            float c = k >= bar_index ? pxLive : f_histAt(hc, hb, k, na)
            if not na(c)
                lo := na(lo) ? c : math.min(lo, c)
                hi := na(hi) ? c : math.max(hi, c)
        v.winLo := lo
        v.winHi := hi
    v

// Segment that contains a bar index (the last segment for anything at or beyond the right edge)
f_segOf(View v, int idx) =>
    int s = v.segs - 1
    for k = 0 to v.segs - 1
        if idx <= v.segEnd.get(k)
            s := k
            break
    s

// Per-segment share of a window cap, so objects cover the whole screen instead of piling
// up near the right edge (user feedback v0.2: "the chart is empty on the left"). Rounded
// down, so the shares never add up to more than the cap and the pools behind it.
f_quota(View v, int cap) =>
    cap <= 0 ? 0 : math.max(1, int(cap / v.segs))

// Even spread inside segments (v0.3): candidates arrive in priority order. Pass 1 takes at most
// one object per time slot, pass 2 fills each segment's quota in priority order. Returns the
// indices of the picked candidates; index 0 is always picked first when anything is.
f_spreadPick(View v, array<int> xs, array<int> sg, int q, int slots) =>
    array<int> out = array.new<int>()
    int m = xs.size()
    if m > 0 and q > 0
        int ns = math.max(1, slots)
        int w = math.max(1, v.iR - v.iL + 1)
        array<int> cnt = array.new<int>(v.segs, 0)
        array<bool> slotUsed = array.new<bool>(ns, false)
        array<bool> took = array.new<bool>(m, false)
        for pass = 0 to 1
            for k = 0 to m - 1
                if not took.get(k)
                    int s = sg.get(k)
                    if cnt.get(s) < q
                        int sl = math.max(0, math.min(ns - 1, int((xs.get(k) - v.iL) * ns / w)))
                        if pass == 1 or not slotUsed.get(sl)
                            took.set(k, true)
                            slotUsed.set(sl, true)
                            cnt.set(s, cnt.get(s) + 1)
                            out.push(k)
    out

f_htfPrefix(int tf) =>
    tf != TF_CHART ? "◆" + htfLabel + " " : ""

// ── Zones (§13.8, §14.10, §15 M2/M3/M6)
// Converted zones (BB / MB / IFVG) start where the parent broke, so they never overlap it.
f_zoneLeftT(Zone z) =>
    z.kind == ZK_BB or z.kind == ZK_MB or z.kind == ZK_IFVG ? z.bornT : z.t

f_zoneTip(Zone z) =>
    (z.tf != TF_CHART ? htfLabel + " " : "") + f_kindTag(z.kind) + (z.dir == 1 ? " bullish" : " bearish") + " · " + f_zoneStateName(z.state) + "\n" + f_px(z.bottom) + " – " + f_px(z.top) + "\nsince " + f_timeStr(z.t)

f_drawZone(BoxPool pz, LinePool pm, array<Tag> tags, Zone z, float r, int mergeN, int rightT, bool ghostEnded, bool liveView) =>
    bool liveNow = z.state < ZS_FILLED
    bool htf = z.tf != TF_CHART
    bool ghost = (mc.debug and r < mc.theta) or (not liveNow and ghostEnded)
    color hue = ghost ? C_INV : z.state == ZS_MITIGATED ? C_MITI : f_dirColor(z.dir)
    // finished zones stay readable as history: light fill plus a dotted border (v0.3)
    int fillBase = not liveNow ? F_LIGHT : z.kind == ZK_OB ? (z.state == ZS_FRESH ? (htf ? F_STRONG : F_BASE) : z.state == ZS_TOUCHED ? F_LIGHT : F_FAINT) : z.kind == ZK_MB ? F_FAINT : F_LIGHT
    bool hasBorder = z.kind != ZK_FVG or htf or not liveNow
    int borderBase = not liveNow ? OP_SOFT : z.state == ZS_FRESH ? (htf ? OP_STRONG : OP_MEDIUM) : OP_SOFT
    string bst = z.kind == ZK_BB or z.kind == ZK_IFVG ? line.style_dashed : z.kind == ZK_MB or z.kind == ZK_FVG or z.state == ZS_MITIGATED or not liveNow ? line.style_dotted : line.style_solid
    int fT = ghost ? F_GHOST : f_tr(fillBase, r)
    color fillC = color.new(hue, fT)
    color bdC = hasBorder ? color.new(hue, ghost ? f_tok(85) : f_tr(borderBase, r)) : color(na)
    float top = z.top
    float bot = z.bottom
    if i_shrink and z.kind == ZK_FVG and liveNow and not na(z.unfilled)
        if z.dir == 1
            top := math.max(z.bottom, math.min(z.top, z.unfilled))
        else
            bot := math.min(z.top, math.max(z.bottom, z.unfilled))
    int lx = f_zoneLeftT(z)
    int rx = liveNow ? rightT : z.endT
    bool dbg = mc.debug and i_showIds
    string tag = f_htfPrefix(z.tf) + f_kindTag(z.kind) + (mergeN > 1 ? " ×" + str.tostring(mergeN) : "")
    if dbg
        tag := "#" + str.tostring(z.id) + " " + tag + " " + f_zoneStateName(z.state) + " R" + str.tostring(r, "0.00")
    bool drawn = f_box(pz, lx, rx, top, bot, fillC, bdC, htf ? 2 : 1, bst, dbg ? tag : "", color.new(hue, 0), text.align_right)
    // Tags of active zones join the right-edge column (Smart Labels) instead of sitting inside
    // the box, so they never cover the last candles, whatever the zoom
    if drawn and liveNow and liveView and labelLvl > 0 and not dbg
        tags.push(Tag.new((z.top + z.bottom) / 2, tag, color.new(hue, 0), f_zoneTip(z)))
    bool isOb = z.kind == ZK_OB or z.kind == ZK_BB or z.kind == ZK_MB
    if drawn and liveNow and ((isOb and i_obMid) or (not isOb and i_fvgCE))
        float mid = (z.top + z.bottom) / 2
        if mid <= top and mid >= bot
            int lt = z.state == ZS_CE ? OP_FAINT : f_tr(OP_SOFT, r)
            f_line(pm, lx, mid, rx, mid, color.new(hue, lt), line.style_dotted, 1)
    drawn

// Candidates are grouped by virtual segment: vs = 2 × time segment + 1 for zones alive at the
// segment's anchor, 2 × segment for zones that finished inside it (history). Side caps apply
// per virtual segment, and zones alive at the right edge have their own pool share, so history
// never competes with active zones near the live edge. History picks are first spread over
// time slots, so strong zones bunched in one burst do not leave the rest of a segment empty.
f_renderZones(View v, BoxPool pz, LinePool pm, array<Tag> tags, array<Zone> liveZ, array<Zone> archZ, int rightT, array<float> hc, array<float> ha, int hb) =>
    array<Zone> cz = array.new<Zone>()
    array<float> keys = array.new<float>()
    array<float> rs = array.new<float>()
    array<int> segIx = array.new<int>()
    array<float> anchorPx = array.new<float>()
    array<bool> ghostIx = array.new<bool>()
    // boxes narrower than this are invisible slivers at the current zoom
    int sliver = math.max(2, int((v.iR - v.iL) / 200))
    array<int> slotIx = array.new<int>()
    for src = 0 to 1
        array<Zone> arr = src == 0 ? liveZ : archZ
        for z in arr
            bool htf = z.tf != TF_CHART
            bool liveNow = z.state < ZS_FILLED
            int endEff = liveNow ? bar_index : z.endBar
            if z.born <= v.iR and endEff >= v.iL and f_zoneShown(z) and (z.state != ZS_MITIGATED or vMitigated)
                int seg = f_segOf(v, math.min(endEff, v.iR))
                bool liveSeg = v.live and seg == v.segs - 1
                int anchor = v.segEnd.get(seg)
                float px = v.segPx.get(seg)
                float atr = v.segAtr.get(seg)
                bool ok = true
                bool ghost = false
                bool histRank = false
                if endEff < anchor
                    bool recentEnd = mc.ttl > 0 and bar_index - z.endBar <= mc.ttl and z.state != ZS_CONVERTED and z.state != ZS_EXPIRED
                    if liveSeg and recentEnd
                        // just finished at the live edge: a ghost for a few bars
                        ghost := true
                    else
                        // finished earlier: ranked where price reached it, freshness counted from
                        // its birth (no bias to short-lived boxes). Clean (no TTL) shows finished
                        // zones only when the chart is scrolled back into history.
                        histRank := true
                        // width in bars as drawn; for an HTF box the part before ingestion (from
                        // the HTF candle) is estimated from time
                        bool conv = z.kind == ZK_BB or z.kind == ZK_MB or z.kind == ZK_IFVG
                        int wBars = z.endBar - (conv ? z.born : z.bar) + (htf and not conv ? int((z.bornT - z.t) / barMs) : 0)
                        ok := (mc.ttl > 0 or not v.live) and wBars >= sliver
                        anchor := z.born
                        px := f_histAt(hc, hb, z.endBar, px)
                        atr := f_histAt(ha, hb, z.endBar, atr)
                if ok
                    if f_zoneDistAt(z, px, atr) <= mc.distMax * (htf ? 2 : 1)
                        float r = f_zoneRAt(z, px, atr, anchor, not ghost)
                        if r >= mc.theta or mc.debug or htf
                            int vs = seg * 2 + (histRank ? 0 : 1)
                            cz.push(z)
                            rs.push(r)
                            keys.push(vs + r * 0.999)
                            segIx.push(vs)
                            anchorPx.push(px)
                            ghostIx.push(ghost)
                            slotIx.push(math.min(endEff, v.iR) - v.iL)
    int m = cz.size()
    int cap = pz.items.size()
    // pool shares: one per time segment plus one for the zones alive at the right edge
    int budget = math.max(1, int(cap / (v.segs + 1)))
    int nsl = math.max(1, budget * v.segs)
    int wv = math.max(1, v.iR - v.iL + 1)
    array<int> picked = array.new<int>()
    array<int> mergeN = array.new<int>()
    if m > 0 and cap > 0
        array<int> ord = keys.sort_indices(order.descending)
        // counters per virtual segment: OB above/below, FVG above/below, HTF above/below, inside
        array<int> cnt = array.new<int>(v.segs * 14, 0)
        array<int> used = array.new<int>(v.segs + 1, 0)
        array<bool> done = array.new<bool>(m, false)
        array<bool> slotUsed = array.new<bool>(nsl, false)
        // pass 0: history, one zone per time slot; pass 1: each share filled best first;
        // pass 2: leftovers, best first
        for pass = 0 to 2
            for k = 0 to m - 1
                int oi = ord.get(k)
                int vs = segIx.get(oi)
                int seg = int(vs / 2)
                // the right-edge share is only for zones alive at the right edge of the view
                bool edge = vs % 2 == 1 and seg == v.segs - 1
                bool hist = not edge
                int bi = edge ? v.segs : seg
                int sl = math.max(0, math.min(nsl - 1, int(slotIx.get(oi) * nsl / wv)))
                bool gate = pass == 2 or (used.get(bi) < budget and (pass == 1 or (hist and not slotUsed.get(sl))))
                if not done.get(oi) and picked.size() < cap and gate
                    Zone z = cz.get(oi)
                    float px = anchorPx.get(oi)
                    bool htf = z.tf != TF_CHART
                    bool isOb = z.kind == ZK_OB or z.kind == ZK_BB or z.kind == ZK_MB
                    bool above = z.bottom > px
                    bool below = z.top < px
                    int into = -1
                    int pn = picked.size()
                    if pn > 0 and not mc.debug
                        for q = 0 to pn - 1
                            int pq = picked.get(q)
                            if segIx.get(pq) == vs
                                Zone y = cz.get(pq)
                                if y.dir == z.dir and y.tf == z.tf
                                    float ov = math.min(y.top, z.top) - math.max(y.bottom, z.bottom)
                                    float sm = math.min(y.top - y.bottom, z.top - z.bottom)
                                    if sm > 0 and ov >= 0.5 * sm
                                        into := q
                                        break
                    if into >= 0
                        mergeN.set(into, mergeN.get(into) + 1)
                        done.set(oi, true)
                    else
                        int fam = htf ? 4 : isOb ? 0 : 2
                        int ci = vs * 7 + (above or below ? fam + (above ? 0 : 1) : 6)
                        int sideCap = htf and (above or below) ? math.max(1, nZonesSide - 1) : nZonesSide
                        if mc.debug or cnt.get(ci) < sideCap
                            picked.push(oi)
                            mergeN.push(1)
                            cnt.set(ci, cnt.get(ci) + 1)
                            used.set(bi, used.get(bi) + 1)
                            slotUsed.set(sl, true)
                            done.set(oi, true)
    int pn2 = picked.size()
    if pn2 > 0
        for q = 0 to pn2 - 1
            int oi = picked.get(q)
            f_drawZone(pz, pm, tags, cz.get(oi), rs.get(oi), mergeN.get(q), rightT, ghostIx.get(oi), v.live)
    pn2

// ── Liquidity levels (§14.12): levels alive at the window's right edge
f_liqTag(Liq x) =>
    string base = x.kind == LK_SWING ? (x.side == 1 ? "BSL" : "SSL") + (x.touches >= 2 ? " ≡" + str.tostring(x.touches) : "") : x.kind == LK_SESS ? x.tag : "◆" + x.tag
    string withTf = f_htfPrefix(x.tf) + base
    x.state == LS_PENDING ? withTf + " ?" : withTf

f_liqTip(Liq x) =>
    string what = x.kind == LK_SWING ? (x.touches >= 2 ? "equal " + (x.side == 1 ? "highs" : "lows") + " ×" + str.tostring(x.touches) : "swing " + (x.side == 1 ? "high" : "low")) : x.tag
    (x.tf != TF_CHART ? htfLabel + " " : "") + (x.side == 1 ? "Buy-side liquidity · " : "Sell-side liquidity · ") + what + "\n" + f_px(x.price) + (x.state == LS_PENDING ? " · closed beyond, waiting for reclaim" : "") + "\nsince " + f_timeStr(x.t)

f_drawLevel(LinePool pl, array<Tag> tags, Liq x, float r, bool major, int rightT, bool liveView) =>
    bool aliveNow = x.state == LS_ACTIVE or x.state == LS_PENDING
    bool key = x.kind != LK_SWING
    bool htf = x.tf != TF_CHART
    int w = (key and x.kind != LK_SESS) or htf ? 2 : 1
    string st = x.state == LS_PENDING ? line.style_dashed : major ? line.style_solid : line.style_dotted
    int tr = major ? f_tr(OP_STRONG, r) : OP_FAINT
    int x2 = aliveNow ? rightT : x.endT
    f_line(pl, x.t, x.price, x2, x.price, color.new(C_LIQ, tr), st, w)
    if liveView and aliveNow and (major or mc.debug)
        string tx = f_liqTag(x)
        if mc.debug and i_showIds
            tx := "#" + str.tostring(x.id) + " " + tx + " R" + str.tostring(r, "0.00")
        tags.push(Tag.new(x.price, tx, color.new(C_LIQ, math.min(tr, OP_MEDIUM)), f_liqTip(x)))
    true

f_renderLevels(View v, LinePool pl, array<Tag> tags, array<Liq> liveL, array<Liq> archL, int rightT) =>
    int seg = v.segs - 1
    int anchor = v.iR
    float px = v.segPx.get(seg)
    float atr = v.segAtr.get(seg)
    array<Liq> cl = array.new<Liq>()
    array<float> rs = array.new<float>()
    if vLevels
        for src = 0 to 1
            array<Liq> arr = src == 0 ? liveL : archL
            for x in arr
                bool aliveNow = x.state == LS_ACTIVE or x.state == LS_PENDING
                int endEff = aliveNow ? bar_index : x.endBar
                bool key = x.kind != LK_SWING
                bool htf = x.tf != TF_CHART
                bool show = not htf or i_htfLiq
                bool histOk = v.vp or key or htf or bar_index - x.born <= histDepth
                if show and x.born <= anchor and endEff >= anchor and histOk
                    float d = math.abs(px - x.price) / atr
                    if d <= (key or htf ? mc.distMax * 2 : mc.distMax)
                        cl.push(x)
                        rs.push(f_liqRAt(x, px, atr, anchor))
    int shown = 0
    int m = cl.size()
    if m > 0
        array<int> ord = rs.sort_indices(order.descending)
        int majUp = 0
        int majDn = 0
        int minUp = 0
        int minDn = 0
        int keyUp = 0
        int keyDn = 0
        for k = 0 to m - 1
            int oi = ord.get(k)
            Liq x = cl.get(oi)
            bool up = x.side == 1
            bool major = x.tf != TF_CHART or f_liqMajorAt(x, anchor)
            bool take = false
            if mc.debug
                take := true
            else if x.kind != LK_SWING or x.tf != TF_CHART
                // key levels and HTF levels share their own bucket
                take := up ? keyUp < mc.keyCap : keyDn < mc.keyCap
                if take
                    keyUp += up ? 1 : 0
                    keyDn += up ? 0 : 1
            else if major
                take := up ? majUp < nMajorSide : majDn < nMajorSide
                if take
                    majUp += up ? 1 : 0
                    majDn += up ? 0 : 1
            else
                take := up ? minUp < nMinorSide : minDn < nMinorSide
                if take
                    minUp += up ? 1 : 0
                    minDn += up ? 0 : 1
            if take
                f_drawLevel(pl, tags, x, rs.get(oi), major, rightT, v.live)
                shown += 1
    shown

// Liquidity history (§14.10, §14.12): swept / taken levels and past key levels that ended
// inside the window, spread evenly over time. Priority inside a segment:
// major sweeps → minor sweeps and major runs → past key levels → minor runs.
f_renderSwept(View v, LinePool pl, LabelPool pb, array<Liq> liveL, array<Liq> archL) =>
    int ttlS = mc.ttl == 0 ? 20 : mc.ttl * 3
    int cap = v.vp ? mc.sweepWin : mc.sweptShow
    int q = v.vp ? f_quota(v, cap) : cap
    array<Liq> cl = array.new<Liq>()
    array<float> keys = array.new<float>()
    array<int> segIx = array.new<int>()
    if vSwept or vSweeps
        for src = 0 to 1
            array<Liq> arr = src == 0 ? liveL : archL
            for x in arr
                bool htf = x.tf != TF_CHART
                bool keyPast = x.state == LS_EXPIRED and x.kind != LK_SWING and v.vp
                if (x.state == LS_SWEPT or x.state == LS_TAKEN or keyPast) and (not htf or i_htfLiq)
                    bool inWin = v.vp ? x.endBar >= v.iL and x.endBar <= v.iR : bar_index - x.endBar <= ttlS
                    bool major = x.major or htf
                    if inWin and (major or mc.minorPerSide > 0) and (x.state == LS_SWEPT or vSwept)
                        int seg = v.vp ? f_segOf(v, x.endBar) : 0
                        float pri = x.state == LS_SWEPT ? (major ? 3.0 : 2.0) : keyPast ? 1.0 : major ? 2.0 : 0.0
                        cl.push(x)
                        segIx.push(seg)
                        keys.push(seg * 100000000.0 + pri * 10000000.0 + x.endBar)
    int m = cl.size()
    array<Liq> cand = array.new<Liq>()
    array<int> xs = array.new<int>()
    array<int> sg = array.new<int>()
    if m > 0
        array<int> ord = keys.sort_indices(order.descending)
        for oi in ord
            Liq x = cl.get(oi)
            cand.push(x)
            xs.push(x.endBar)
            sg.push(segIx.get(oi))
    array<int> sel = f_spreadPick(v, xs, sg, q, v.vp ? q * v.segs : 1)
    for k in sel
        Liq x = cand.get(k)
        bool htf = x.tf != TF_CHART
        bool major = x.major or htf
        if vSwept or x.state == LS_SWEPT
            int tr = x.state == LS_EXPIRED ? OP_SOFT : major ? OP_MEDIUM : OP_FAINT
            f_line(pl, x.t, x.price, x.endT, x.price, color.new(C_LIQ, tr), x.state == LS_EXPIRED ? line.style_solid : line.style_dotted, htf or x.state == LS_EXPIRED ? 2 : 1)
        if x.state == LS_SWEPT and vSweeps
            string sideTxt = x.side == 1 ? "BSL" : "SSL"
            string txt = major and labelLvl > 0 ? f_htfPrefix(x.tf) + sideTxt + " ✕" : "✕"
            string stype = x.sweepType == SWEEP_TURTLE ? "turtle soup" : x.sweepType == SWEEP_RECLAIM ? "reclaim" : "wick"
            float pen = na(x.ext) ? na : math.abs(x.ext - x.price) / vu
            string tip = (htf ? htfLabel + " " : "") + sideTxt + " swept (" + stype + ") · " + x.tag + " " + f_px(x.price) + "\npenetration " + str.tostring(pen, "0.00") + " ATR · " + f_timeStr(x.endT)
            f_label(pb, x.endT, x.price, txt, color.new(C_LIQ, major ? OP_SOLID : OP_MEDIUM), x.side == 1 ? label.style_label_down : label.style_label_up, major ? size.small : size.tiny, tip, x.side == 1 ? yloc.abovebar : yloc.belowbar)
        else if x.state == LS_EXPIRED and labelLvl > 0
            f_label(pb, x.endT, x.price, "◆" + x.tag, color.new(C_LIQ, OP_MEDIUM), label.style_label_left, size.tiny, x.tag + " " + f_px(x.price) + " · " + f_timeStr(x.t), yloc.price)
    sel.size()

// ── Structure (§13.12, AC-M14): breaks inside the window, spread evenly over time
f_brkTip(Brk b) =>
    string nm = b.kind == BK_BOS ? "Break of Structure" : b.mss ? "Market Structure Shift (CHoCH + displacement + FVG)" : "Change of Character"
    string disp = na(b.disp) ? "" : " · leg " + str.tostring(b.disp, "0.0") + " ATR"
    (b.tf != TF_CHART ? htfLabel + " " : "") + nm + (b.dir == 1 ? " ↑" : " ↓") + " · " + (b.lvl == LV_SWG ? "swing" : "internal") + (b.initial ? " · first break" : "") + "\nlevel " + f_px(b.price) + disp + "\n" + f_timeStr(b.t)

f_renderBreaks(View v, LinePool pl, LabelPool pb, array<Brk> brks, int cap, bool internal) =>
    int n = brks.size()
    int q = v.vp ? f_quota(v, cap) : cap
    array<Brk> cand = array.new<Brk>()
    array<int> xs = array.new<int>()
    array<int> sg = array.new<int>()
    if cap > 0 and n > 0
        // breaks are stored in time order: walk back from the newest until the window's left edge
        for i = n - 1 to 0
            Brk b = brks.get(i)
            if b.bar < v.iL
                break
            if b.bar <= v.iR and (not b.shadowed or mc.debug)
                cand.push(b)
                xs.push(b.bar)
                sg.push(v.vp ? f_segOf(v, b.bar) : 0)
    array<int> sel = f_spreadPick(v, xs, sg, q, v.vp ? q * v.segs : 1)
    for k in sel
        Brk b = cand.get(k)
        bool htf = b.tf != TF_CHART
        bool recent = k == 0
        color hue = f_dirColor(b.dir)
        int tr = htf ? OP_STRONG : internal ? OP_SOFT : recent ? OP_STRONG : OP_MEDIUM
        f_line(pl, b.swingT, b.price, b.t, b.price, color.new(hue, tr), internal ? line.style_dotted : line.style_dashed, htf ? 2 : 1)
        string nm = b.kind == BK_BOS ? "BOS" : b.mss ? "MSS" : "CHoCH"
        string base = f_htfPrefix(b.tf) + (internal ? "i" : "") + nm + f_arrow(b.dir)
        if labelLvl == 0 and internal
            base := f_arrow(b.dir)
        string txt = base
        if labelLvl >= 2 and not internal and recent
            txt := txt + " " + f_px(b.price)
        if labelLvl >= 3 and not na(b.disp)
            txt := txt + " · " + str.tostring(b.disp, "0.0") + " ATR"
        if mc.debug and i_showIds
            txt := "#" + str.tostring(b.id) + " " + txt
            base := txt
        color tc = color.new(hue, internal ? OP_MEDIUM : recent or htf ? OP_SOLID : 15)
        string sz = internal ? size.tiny : size.small
        // Placement (VIS-11). Text width is estimated in bars for a ~1300 px plot. Chart-TF labels
        // run from the pivot toward the break (the side of the level the leg had not reached), or
        // left of the pivot over its own clear bars; the longest text that fits is used (full,
        // short, arrow), and a label that fits nowhere leaves only the line. Anchors are clamped
        // to the left edge of the visible range, so breaks near it keep their labels.
        if htf
            int lx = int((b.swingT + b.t) / 2)
            bool hc = not na(v.tL) and lx < v.tL
            if hc
                lx := v.tL
            string hst = hc ? (b.dir == 1 ? label.style_label_lower_left : label.style_label_upper_left) : b.dir == 1 ? label.style_label_down : label.style_label_up
            f_label(pb, lx, b.price, txt, tc, hst, sz, f_brkTip(b), yloc.price)
        else
            bool clamp = v.vp and not na(v.tL) and not na(b.swingBar) and b.swingBar < v.iL
            int x0 = clamp ? v.iL : nz(b.swingBar, b.bar)
            int lx = clamp ? v.tL : b.swingT
            string show = txt
            bool right = true
            if v.vp
                float bpp = (v.iR - v.iL + 1) / 1300.0
                float chW = internal ? 6.0 : 7.5
                float spanR = b.bar - x0
                float spanL = clamp ? 0.0 : float(internal ? inLen : swLen)
                show := ""
                for tx in array.from(txt, base, f_arrow(b.dir))
                    float need = (str.length(tx) + 1) * chW * bpp
                    if show == ""
                        if spanR >= need
                            show := tx
                        else if spanL >= need and x0 - need >= v.iL
                            show := tx
                            right := false
            if show != ""
                string lst = right ? (b.dir == 1 ? label.style_label_lower_left : label.style_label_upper_left) : (b.dir == 1 ? label.style_label_lower_right : label.style_label_upper_right)
                f_label(pb, lx, b.price, show, tc, lst, sz, f_brkTip(b), yloc.price)
    sel.size()

f_renderSwings(View v, LabelPool pb, StructState st, int cap) =>
    int n = st.swings.size()
    int q = v.vp ? f_quota(v, cap) : cap
    array<Swing> cand = array.new<Swing>()
    array<int> xs = array.new<int>()
    array<int> sg = array.new<int>()
    if cap > 0 and n > 0
        for i = n - 1 to 0
            Swing s = st.swings.get(i)
            if s.bar < v.iL
                break
            if s.bar <= v.iR
                cand.push(s)
                xs.push(s.bar)
                sg.push(v.vp ? f_segOf(v, s.bar) : 0)
    array<int> sel = f_spreadPick(v, xs, sg, q, v.vp ? q * v.segs : 1)
    for k in sel
        Swing s = cand.get(k)
        string tip = s.tag + " " + f_px(s.price) + " · " + f_timeStr(s.t)
        f_label(pb, s.t, s.price, s.tag, color.new(C_NEUT, OP_MEDIUM), s.side == 1 ? label.style_label_down : label.style_label_up, size.tiny, tip, yloc.price)
    sel.size()

// ── Dealing range: EQ, OTE band, optional wash, Range Gauge (§14.13)
f_drawRangeBody(BoxPool prb, LinePool prl, array<Tag> tags, int dir, float hi, float lo, int t0, int t1, bool developing, bool withTag) =>
    float span = hi - lo
    float eq = (hi + lo) / 2
    if vPd >= 3
        f_box(prb, t0, t1, hi, eq, color.new(C_BEAR, F_WASH), color(na), 1, line.style_solid, "", color(na), text.align_right)
        f_box(prb, t0, t1, eq, lo, color.new(C_BULL, F_WASH), color(na), 1, line.style_solid, "", color(na), text.align_right)
    f_line(prl, t0, eq, t1, eq, color.new(C_NEUT, OP_MEDIUM), developing ? line.style_dashed : line.style_dotted, 1)
    if withTag
        tags.push(Tag.new(eq, developing ? "EQ~" : "EQ", color.new(C_NEUT, OP_MEDIUM), "Equilibrium " + f_px(eq) + (developing ? " · developing range" : " · established range") + "\nrange " + f_px(lo) + " – " + f_px(hi)))
    if vPd >= 2
        float oTop = dir == 1 ? hi - oteLo * span : lo + oteHi * span
        float oBot = dir == 1 ? hi - oteHi * span : lo + oteLo * span
        float sweet = dir == 1 ? hi - 0.705 * span : lo + 0.705 * span
        f_box(prb, t0, t1, oTop, oBot, color.new(C_SIG, F_FAINT), color(na), 1, line.style_solid, "", color(na), text.align_right)
        f_line(prl, t0, sweet, t1, sweet, color.new(C_SIG, OP_SOFT), line.style_dotted, 1)
        if withTag and labelLvl > 0
            tags.push(Tag.new((oTop + oBot) / 2, "OTE", color.new(C_SIG, OP_MEDIUM), "OTE band " + f_px(oBot) + " – " + f_px(oTop) + " · sweet spot " + f_px(sweet)))
    true

f_renderRange(View v, BoxPool prb, LinePool prl, LabelPool pb, array<Tag> tags, Range r, array<RangeSnap> arch, float pxLive, int rightT) =>
    bool curOk = r.state > 0 and r.hi > r.lo
    bool drawn = false
    if vPd > 0
        // Range active at the window's right edge gets EQ + OTE; older ranges get EQ only, spread over time
        if curOk and r.b0 <= v.iR
            f_drawRangeBody(prb, prl, tags, r.dir, r.hi, r.lo, r.t0, rightT, r.state == 1, v.live)
            drawn := true
        int n = arch.size()
        if v.vp and n > 0
            int q = f_quota(v, mc.rangeWin - 1)
            array<RangeSnap> cand = array.new<RangeSnap>()
            array<int> xs = array.new<int>()
            array<int> sg = array.new<int>()
            for i = n - 1 to 0
                RangeSnap s = arch.get(i)
                if s.b1 < v.iL
                    break
                if s.b0 <= v.iR and s.hi > s.lo
                    if not drawn and s.b1 >= v.iR
                        f_drawRangeBody(prb, prl, tags, s.dir, s.hi, s.lo, s.t0, s.t1, false, false)
                        drawn := true
                    else
                        int xe = math.min(s.b1, v.iR)
                        cand.push(s)
                        xs.push(xe)
                        sg.push(f_segOf(v, xe))
            array<int> sel = f_spreadPick(v, xs, sg, q, q * v.segs)
            for k in sel
                RangeSnap s = cand.get(k)
                float eq = (s.hi + s.lo) / 2
                f_line(prl, s.t0, eq, s.t1, eq, color.new(C_NEUT, OP_SOFT), line.style_dotted, 1)
    if curOk and vGauge and v.live
        float span = r.hi - r.lo
        float eq = (r.hi + r.lo) / 2
        // two bars right of the last candle (§14.13); its value joins the right-edge tags
        int gx = time + 2 * barMs
        int gx2 = gx + barMs
        float oTop = r.dir == 1 ? r.hi - oteLo * span : r.lo + oteHi * span
        float oBot = r.dir == 1 ? r.hi - oteHi * span : r.lo + oteLo * span
        f_line(prl, gx, r.lo, gx, r.hi, color.new(C_NEUT, OP_MEDIUM), line.style_solid, 1)
        f_line(prl, gx, oBot, gx, oTop, color.new(C_SIG, OP_STRONG), line.style_solid, 2)
        f_line(prl, gx, eq, gx2, eq, color.new(C_NEUT, OP_MEDIUM), line.style_solid, 1)
        float pdv = (pxLive - r.lo) / span
        string loc = pdv > 0.5 + EQ_BAND ? "PREMIUM" : pdv < 0.5 - EQ_BAND ? "DISCOUNT" : "EQUILIBRIUM"
        tags.push(Tag.new(math.max(r.lo, math.min(r.hi, pxLive)), "◀ " + str.tostring(math.round(pdv * 100)) + "%", C_TEXT, "Price in dealing range: " + loc + "\n0% = " + f_px(r.lo) + " · 100% = " + f_px(r.hi)))
    drawn

// ── Sessions: colored range boxes with a clear border; the name sits above the session high,
// off the candles (§14.14). Fill transparency comes from the settings. A history session gets
// its name only when it is wide enough at the current zoom; the colour identifies it otherwise.
f_drawSession(BoxPool pw, LabelPool pb, string code, float hi, float lo, int t0, int t1, bool current, bool withLabel) =>
    color c = f_sesColor(code)
    int ft = math.min(100, i_sesFill + (current ? 0 : 4))
    bool drawn = f_box(pw, t0, t1, hi, lo, color.new(c, ft), color.new(c, current ? 0 : 25), current ? 2 : 1, current ? line.style_solid : line.style_dashed, "", color(na), text.align_right)
    if drawn and withLabel and labelLvl > 0
        f_label(pb, t0, hi, code, color.new(c, 0), label.style_label_lower_left, current ? size.small : size.tiny, code + " " + f_px(lo) + " – " + f_px(hi) + "\n" + f_timeStr(t0), yloc.price)
    drawn

f_renderSessions(View v, BoxPool pw, LabelPool pb, array<SessBox> hist, Sess sa, Sess sl, Sess sn) =>
    int cap = v.vp ? mc.sessWin : vSessN - 1
    int q = v.vp ? f_quota(v, cap) : cap
    int shown = 0
    if vSessN > 0
        if v.live
            for s in array.from(sa, sl, sn)
                if s.on
                    f_drawSession(pw, pb, s.code, s.hi, s.lo, s.t0, time, true, true)
        int n = hist.size()
        if n > 0 and q > 0
            array<SessBox> cand = array.new<SessBox>()
            array<int> xs = array.new<int>()
            array<int> sg = array.new<int>()
            for i = n - 1 to 0
                SessBox b = hist.get(i)
                if b.b1 < v.iL
                    break
                if b.b0 <= v.iR
                    int xe = math.min(b.b1, v.iR)
                    cand.push(b)
                    xs.push(xe)
                    sg.push(v.vp ? f_segOf(v, xe) : 0)
            array<int> sel = f_spreadPick(v, xs, sg, q, v.vp ? q * v.segs : 1)
            int w = v.iR - v.iL + 1
            for k in sel
                SessBox b = cand.get(k)
                f_drawSession(pw, pb, b.code, b.hi, b.lo, b.t0, b.t1, false, (b.b1 - b.b0 + 1) * 30 >= w)
            shown := sel.size()
    shown
