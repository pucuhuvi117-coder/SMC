// ═══ 95 · ALERTS ════════════════════════════════════════════════════════════════
// Static alertcondition() set (docs §12.7). Conditions are read from the event bus of the
// confirmed bar — the alert engine never recomputes detector logic (A-03). No alerts
// during warm-up (AC-08). Chart-TF structure alerts ignore HTF events (separate conditions).
// Sweep, OB-touch and FVG-fill alerts also fire for HTF objects: those happen on chart bars,
// and their events carry tf = HTF1 for logs and the webhook.
// SMC Pro · Setups also sends one alert() message per bar close (Text or the JSON envelope, 50_webhook).
// SMC Visualizer Pro carries the structure / liquidity / zone conditions, SMC Pro · Setups the
// setup conditions (ADR-13).
bool alertOk = barstate.isconfirmed and core.warm and core.barEvents.size() > 0
//#if core
bool aBosUp = alertOk and f_evFlag(core, EV_BOS, 1, LV_SWG, TF_CHART)
bool aBosDn = alertOk and f_evFlag(core, EV_BOS, -1, LV_SWG, TF_CHART)
bool aChochUp = alertOk and f_evFlag(core, EV_CHOCH, 1, LV_SWG, TF_CHART)
bool aChochDn = alertOk and f_evFlag(core, EV_CHOCH, -1, LV_SWG, TF_CHART)
bool aHtfBias = alertOk and f_evFlag(core, EV_HTF_BIAS, 0, na)
bool aHtfBrk = alertOk and (f_evFlag(core, EV_BOS, 0, LV_SWG, TF_HTF1) or f_evFlag(core, EV_CHOCH, 0, LV_SWG, TF_HTF1))
bool aSweepUp = alertOk and f_evFlag(core, EV_LIQ_SWEPT, 1, na)
bool aSweepDn = alertOk and f_evFlag(core, EV_LIQ_SWEPT, -1, na)
bool aObTouch = alertOk and f_evFlag(core, EV_ZONE_TOUCHED, 0, ZK_OB)
bool aFvgFill = alertOk and f_evFlag(core, EV_ZONE_FILLED, 0, ZK_FVG)
bool aSession = alertOk and f_evFlag(core, EV_SESSION_START, 0, na)
bool aPdEnter = alertOk and f_evFlag(core, EV_PD_ENTER, 0, na)
bool aOteEnter = alertOk and f_evFlag(core, EV_OTE_ENTER, 0, na)

//#else
// Setups: READY / TRIGGERED / INVALID from the alert grade on (grade is v3 of these events)
f_setupEv(Core c, int typ, int minGrade) =>
    Event hit = na
    for e in c.barEvents
        if na(hit) and e.typ == typ and nz(e.v3) >= minGrade
            hit := e
    hit

Event evReady = alertOk and i_setups ? f_setupEv(core, EV_SETUP_READY, setAlertGrade) : na
Event evTrig = alertOk and i_setups ? f_setupEv(core, EV_SETUP_TRIGGERED, setAlertGrade) : na
Event evInv = alertOk and i_setups ? f_setupEv(core, EV_SETUP_INVALID, setAlertGrade) : na
bool aSetReady = not na(evReady)
bool aSetTrig = not na(evTrig)
bool aSetInv = not na(evInv)
bool aSetReadyL = aSetReady and evReady.dir == 1
bool aSetReadyS = aSetReady and evReady.dir == -1

// One message per bar close for the alert "Any alert() function call" (§12.7, ADR-08): text or the
// JSON webhook envelope (50_webhook). Alerts fire only in realtime, so the message is built there;
// with Debug + "log events" it is also written to Pine Logs on every bar, to inspect the JSON.
bool whLog = mc.debug and i_log
if barstate.isconfirmed and core.warm and (barstate.isrealtime or whLog)
    bool whLive = false
    for s in setups
        whLive := whLive or (s.state >= SS_READY and s.state <= SS_TP2 and s.grade >= setAlertGrade)
    bool whSnap = i_whSnap > 0 and bar_index % i_whSnap == 0 and core.barEvents.size() == 0 and whLive
    [whMsg, whN] = f_whMessage(core, ctx, setups, setupArch, whSnap)
    if whN > 0 or whSnap
        alert(whMsg, alert.freq_once_per_bar_close)
        if whLog
            log.info(whMsg)

//#endif

//#if core
alertcondition(aBosUp, "BOS ↑ (swing)", "SMC Pro · {{ticker}} {{interval}} · BOS ↑ · close {{close}}")
alertcondition(aBosDn, "BOS ↓ (swing)", "SMC Pro · {{ticker}} {{interval}} · BOS ↓ · close {{close}}")
alertcondition(aChochUp, "CHoCH ↑ (swing)", "SMC Pro · {{ticker}} {{interval}} · CHoCH ↑ · close {{close}}")
alertcondition(aChochDn, "CHoCH ↓ (swing)", "SMC Pro · {{ticker}} {{interval}} · CHoCH ↓ · close {{close}}")
alertcondition(aSweepUp, "Sweep ↑ (SSL swept)", "SMC Pro · {{ticker}} {{interval}} · SSL swept · close {{close}}")
alertcondition(aSweepDn, "Sweep ↓ (BSL swept)", "SMC Pro · {{ticker}} {{interval}} · BSL swept · close {{close}}")
alertcondition(aObTouch, "Order block touch", "SMC Pro · {{ticker}} {{interval}} · order block touched · close {{close}}")
alertcondition(aFvgFill, "FVG filled", "SMC Pro · {{ticker}} {{interval}} · fair value gap filled · close {{close}}")
alertcondition(aSession, "Session / killzone start", "SMC Pro · {{ticker}} {{interval}} · session or killzone started")
alertcondition(aPdEnter, "Premium / discount change", "SMC Pro · {{ticker}} {{interval}} · price changed premium/discount zone · close {{close}}")
alertcondition(aHtfBias, "HTF bias change", "SMC Pro · {{ticker}} {{interval}} · higher-timeframe bias changed · close {{close}}")
alertcondition(aHtfBrk, "HTF BOS / CHoCH", "SMC Pro · {{ticker}} {{interval}} · higher-timeframe structure break · close {{close}}")
alertcondition(aOteEnter, "OTE entered", "SMC Pro · {{ticker}} {{interval}} · price entered the OTE band · close {{close}}")
//#else
alertcondition(aSetReady, "Setup READY", "SMC Pro · {{ticker}} {{interval}} · setup READY (grade ≥ alert min grade) · close {{close}}")
alertcondition(aSetReadyL, "Setup READY LONG", "SMC Pro · {{ticker}} {{interval}} · LONG setup READY (grade ≥ alert min grade) · close {{close}}")
alertcondition(aSetReadyS, "Setup READY SHORT", "SMC Pro · {{ticker}} {{interval}} · SHORT setup READY (grade ≥ alert min grade) · close {{close}}")
alertcondition(aSetTrig, "Setup TRIGGERED", "SMC Pro · {{ticker}} {{interval}} · setup entry reached · close {{close}}")
alertcondition(aSetInv, "Setup INVALID", "SMC Pro · {{ticker}} {{interval}} · setup invalidated before entry · close {{close}}")
//#endif
