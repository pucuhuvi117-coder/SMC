// ═══ 66 · PANELS ═════════════════════════════════════════════════════════════════
// SMC Visualizer Pro: Context Ribbon answers "what is happening" in one line (§14.6); Dashboard
// gives the answers with details in tooltips (§14.5); Debug shows budgets and data health (§19.1).
// SMC Pro · Setups: one compact Setup panel (§14.5 SETUP / QUALITY / PLAN / INVALID rows).
// Both show the settings signature cfg (ADR-13): equal numbers = the same engine settings.

f_pos(string s) =>
    switch s
        "Top Right" => position.top_right
        "Top Left" => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left" => position.bottom_left
        "Top Center" => position.top_center
        "Bottom Center" => position.bottom_center
        => position.top_right

//#if core
f_structText(Event e) =>
    na(e) ? "—" : (e.typ == EV_BOS ? "BOS " : e.v3 == 1 ? "MSS " : "CHoCH ") + f_arrow(e.dir)

f_liqText(Event e) =>
    string out = "—"
    if not na(e)
        bool swept = e.typ == EV_LIQ_SWEPT
        int side = swept ? -e.dir : e.dir
        out := (side == 1 ? "BSL" : "SSL") + (swept ? " SWEPT" : " TAKEN")
    out

f_pdText(Ctx x, bool longForm) =>
    string out = "—"
    if not na(x.pd)
        string z = x.pdZone == 1 ? (longForm ? "PREMIUM " : "PREM ") : x.pdZone == -1 ? (longForm ? "DISCOUNT " : "DISC ") : "EQ "
        out := z + str.tostring(math.round(x.pd * 100)) + "%" + (x.inOte ? " · OTE" : "")
    out

f_pdColor(Ctx x) =>
    na(x.pd) ? C_NEUT : x.pdZone == 1 ? C_BEAR : x.pdZone == -1 ? C_BULL : C_NEUT

//#endif
f_statusText(Core c) =>
    not c.warm ? "WARMING UP" : nonStdChart ? "⚠ NON-STANDARD CHART" : ""

//#if core
// Context Ribbon: HTF │ STR │ SESSION │ PD │ LIQ │ status
f_htfText(Ctx x) =>
    htfBadCfg ? "⚠ HTF ≤ TF" : not x.htfOk ? "HTF OFF" : x.htfLow ? "HTF " + htfLabel + " ⚠" : "HTF " + htfLabel + (x.htfTrend == 1 ? " ▲ BULL" : x.htfTrend == -1 ? " ▼ BEAR" : " —")

f_htfColor(Ctx x) =>
    htfBadCfg or x.htfLow ? C_WARN : x.htfOk ? f_dirColor(x.htfTrend) : C_NEUT

f_htfTip(Ctx x) =>
    htfBadCfg ? "The manual higher timeframe must be above the chart timeframe; the HTF Feed is off" : not x.htfOk ? "Higher timeframe is off" : x.htfLow ? "Fewer than " + str.tostring(i_minHtfBars) + " confirmed " + htfLabel + " bars: the HTF bias is treated as unknown (A.16)" : "Higher-timeframe swing structure from confirmed " + htfLabel + " bars"

f_ribbon(table tb, Ctx x, Core c) =>
    if not na(tb)
        string sz = panelSz
        table.cell(tb, 0, 0, f_htfText(x), text_color = f_htfColor(x), text_size = sz, tooltip = f_htfTip(x))
        string s0 = x.ranging ? "STR ◆ RANGE" : x.swTrend == 1 ? "STR ▲ BULL" : x.swTrend == -1 ? "STR ▼ BEAR" : "STR —"
        color c0 = x.ranging ? C_NEUT : f_dirColor(x.swTrend)
        table.cell(tb, 1, 0, s0, text_color = c0, text_size = sz, tooltip = "Swing structure on the chart timeframe" + (x.ranging ? " · regime: ranging" : ""))
        string s1 = x.sessCode == "" ? "NO KZ" : x.sessCode + (na(x.minsLeft) ? "" : " " + str.tostring(x.minsLeft) + "m")
        table.cell(tb, 2, 0, s1, text_color = x.sessCode == "" ? C_NEUT : f_sesColor(x.sessCode), text_size = sz, tooltip = "Active session or killzone (" + sesTz + "), minutes left")
        table.cell(tb, 3, 0, na(x.pd) ? "PD —" : f_pdText(x, false), text_color = f_pdColor(x), text_size = sz, tooltip = "Location in the dealing range: 0% = range low, 100% = range high")
        Event le = c.lastLiq
        string s3 = "LIQ —"
        if not na(le)
            if bar_index - le.bar <= 20
                bool swept = le.typ == EV_LIQ_SWEPT
                int side = swept ? -le.dir : le.dir
                s3 := (side == 1 ? "BSL" : "SSL") + (swept ? " ✕ " : " TAKEN ") + str.tostring(bar_index - le.bar) + "b"
        table.cell(tb, 4, 0, s3, text_color = s3 == "LIQ —" ? C_NEUT : C_LIQ, text_size = sz, tooltip = na(le) ? "No recent liquidity event" : le.s1 + " · " + f_px(le.price) + " · " + f_timeStr(le.t))
        string s4 = f_statusText(c)
        if s4 == ""
            table.clear(tb, 5, 0)
        else
            table.cell(tb, 5, 0, s4, text_color = C_WARN, text_size = sz, tooltip = nonStdChart ? "Renko, Kagi, Point & Figure, Range or Heikin Ashi: structure is built on synthetic prices" : "Signals and alerts are suppressed during warm-up (first " + str.tostring(warmBars) + " bars).")
    true

//#endif
f_dashRow(table tb, int row, string k, string v, color vc, string tip, string sz) =>
    table.cell(tb, 0, row, k, text_color = color.new(C_TEXT, 45), text_size = sz, text_halign = text.align_left)
    table.cell(tb, 1, row, v, text_color = vc, text_size = sz, text_halign = text.align_left, tooltip = tip)
    row + 1

//#if core
// Dashboard: answers instead of statistics (§14.5)
f_dashboard(table tb, Ctx x, Core c, StructState si, Range r) =>
    if not na(tb)
        bool exp = i_dashSize == "Expanded"
        string sz = panelSz
        int row = 0
        string mk = x.market == MK_RANGE ? "RANGING" : x.market == MK_MIXED ? "MIXED" : x.market == MK_BULL ? "BULLISH" : x.market == MK_BEAR ? "BEARISH" : "UNDEFINED"
        color mkc = x.market == MK_RANGE or x.market == MK_MIXED ? C_WARN : f_dirColor(x.market)
        row := f_dashRow(tb, row, "MARKET", mk, x.market == MK_RANGE ? C_NEUT : mkc, "Ranging regime → RANGING. HTF and chart structure agree → that side; disagree → MIXED; HTF unknown → chart structure (A.16).", sz)
        string ht = htfBadCfg ? "⚠ HTF ≤ chart TF" : not x.htfOk ? "OFF" : x.htfLow ? htfLabel + " ⚠ low history" : htfLabel + (x.htfTrend == 1 ? " BULLISH" : x.htfTrend == -1 ? " BEARISH" : " —")
        Event lh = c.lastHtfStruct
        row := f_dashRow(tb, row, "HTF", ht + (na(lh) or not x.htfOk ? "" : " · " + f_structText(lh)), f_htfColor(x), na(lh) or not x.htfOk ? f_htfTip(x) : "Last HTF break at " + f_px(lh.price) + " · " + f_timeStr(lh.t), sz)
        Event ls = c.lastStruct
        string st = na(ls) ? "—" : f_structText(ls) + " · " + str.tostring(bar_index - ls.bar) + " bars"
        row := f_dashRow(tb, row, "STRUCTURE", st, na(ls) ? C_NEUT : f_dirColor(ls.dir), na(ls) ? "No swing break yet" : "Broken level " + f_px(ls.price) + " · leg " + str.tostring(ls.v2, "0.0") + " ATR · " + f_timeStr(ls.t), sz)
        string ses = x.sessCode == "" ? "—" : x.sessCode + (na(x.minsLeft) ? "" : " · " + str.tostring(x.minsLeft) + "m")
        row := f_dashRow(tb, row, "SESSION", ses, x.sessCode == "" ? C_NEUT : f_sesColor(x.sessCode), "Session timezone: " + sesTz, sz)
        string rngTip = r.state > 0 ? "Dealing range " + f_px(r.lo) + " – " + f_px(r.hi) + (r.state == 1 ? " (developing)" : " (established)") : "No dealing range yet"
        row := f_dashRow(tb, row, "LOCATION", f_pdText(x, true), f_pdColor(x), rngTip, sz)
        Event le = c.lastLiq
        string lq = na(le) ? "—" : f_liqText(le) + " · " + str.tostring(bar_index - le.bar) + " bars"
        row := f_dashRow(tb, row, "LIQUIDITY", lq, na(le) ? C_NEUT : C_LIQ, na(le) ? "No sweep yet" : le.s1 + " · " + f_px(le.price) + " · " + f_timeStr(le.t), sz)
        Liq nb = x.nextBsl
        Liq ns = x.nextSsl
        string nbT = na(nb) ? "—" : nb.tag + " " + f_px(nb.price) + " (+" + str.tostring((nb.price - close) / vu, "0.0") + " ATR)"
        string nsT = na(ns) ? "—" : ns.tag + " " + f_px(ns.price) + " (−" + str.tostring((close - ns.price) / vu, "0.0") + " ATR)"
        row := f_dashRow(tb, row, "TARGET ↑", nbT, na(nb) ? C_NEUT : C_LIQ, "Nearest major buy-side liquidity above price", sz)
        row := f_dashRow(tb, row, "TARGET ↓", nsT, na(ns) ? C_NEUT : C_LIQ, "Nearest major sell-side liquidity below price", sz)
        if exp
            string inT = x.inTrend == 1 ? "BULLISH" : x.inTrend == -1 ? "BEARISH" : "—"
            row := f_dashRow(tb, row, "INTERNAL", inT, f_dirColor(x.inTrend), "Internal structure trend", sz)
            row := f_dashRow(tb, row, "MODE", str.tostring(i_mode) + " · v" + BUILD, C_NEUT, "Display mode and build", sz)
        string stt = f_statusText(c)
        if stt != ""
            row := f_dashRow(tb, row, "STATUS", stt, C_WARN, "Signals and alerts are suppressed during warm-up", sz)
        row := f_dashRow(tb, row, "CFG", str.tostring(cfgSig), C_NEUT, "Settings signature of the engines: SMC Pro · Setups must show the same cfg number in its panel, otherwise its setups are built on different structure, liquidity or zone settings", sz)
        if mc.labelLevel >= 3 and exp
            int nh = c.history.size()
            int shown = 0
            if nh > 0
                for i = nh - 1 to 0
                    Event e = c.history.get(i)
                    if shown < 5 and row < DASH_ROWS - 1 and (e.typ == EV_BOS or e.typ == EV_CHOCH or e.typ == EV_LIQ_SWEPT) and (e.typ == EV_LIQ_SWEPT or e.v1 == LV_SWG)
                        string et = e.typ == EV_LIQ_SWEPT ? f_liqText(e) : f_structText(e)
                        row := f_dashRow(tb, row, str.format_time(e.t, "MM-dd HH:mm", sesTz), et + " · " + f_px(e.price), e.typ == EV_LIQ_SWEPT ? C_LIQ : f_dirColor(e.dir), e.s1, sz)
                        shown += 1
        if row <= DASH_ROWS - 1
            table.clear(tb, 0, row, 1, DASH_ROWS - 1)
    true

// Debug table (§19.1): budgets, registries, data health
f_debugTable(table tb, View v, Core c, array<Zone> zs, array<Zone> za, array<Liq> lv, array<Liq> la, BoxPool pz, BoxPool pw, BoxPool prb, LinePool pm, LinePool pl, LinePool ps, LinePool prl, LabelPool pb) =>
    if not na(tb)
        string sz = size.tiny
        int zLive = 0
        for z in zs
            zLive += z.state < ZS_FILLED ? 1 : 0
        int lLive = 0
        for x in lv
            lLive += x.state == LS_ACTIVE or x.state == LS_PENDING ? 1 : 0
        int boxUsed = pz.used + pw.used + prb.used
        int boxCap = pz.items.size() + pw.items.size() + prb.items.size()
        int lineUsed = pm.used + pl.used + ps.used + prl.used
        int lineCap = pm.items.size() + pl.items.size() + ps.items.size() + prl.items.size()
        int row = 0
        row := f_dashRow(tb, row, "BUILD", "v" + BUILD + " · " + str.tostring(i_mode) + " · cfg " + str.tostring(cfgSig), C_TEXT, "cfg: settings signature, equal in both indicators when their engine settings match", sz)
        row := f_dashRow(tb, row, "BARS", str.tostring(bar_index + 1) + (c.warm ? " · warm" : " · warming up"), c.warm ? C_TEXT : C_WARN, "Warm-up: " + str.tostring(warmBars) + " bars", sz)
        row := f_dashRow(tb, row, "VIEW", (v.vp ? "window " : "recent ") + str.tostring(v.iL) + "–" + str.tostring(v.iR) + " · " + str.tostring(v.segs) + " seg", C_TEXT, "Bar window drawn and number of time segments", sz)
        string zFrom = za.size() > 0 ? " · from bar " + str.tostring(za.get(0).endBar) : ""
        string lFrom = la.size() > 0 ? " · from bar " + str.tostring(la.get(0).endBar) : ""
        row := f_dashRow(tb, row, "ZONES", str.tostring(zLive) + " live / " + str.tostring(zs.size()) + " · arch " + str.tostring(za.size()), C_TEXT, "Live cap " + str.tostring(ZONE_CAP) + " · archive cap " + str.tostring(ZONE_ARCH_CAP) + zFrom, sz)
        row := f_dashRow(tb, row, "LEVELS", str.tostring(lLive) + " live / " + str.tostring(lv.size()) + " · arch " + str.tostring(la.size()), C_TEXT, "Live cap " + str.tostring(LIQ_CAP) + " · archive cap " + str.tostring(LIQ_ARCH_CAP) + lFrom, sz)
        row := f_dashRow(tb, row, "EVENTS", str.tostring(c.barEvents.size()) + " bar · " + str.tostring(c.history.size()) + " hist", C_TEXT, "Event bus: current bar / history ring", sz)
        row := f_dashRow(tb, row, "BOXES", str.tostring(boxUsed) + " / " + str.tostring(boxCap), C_TEXT, "Drawn / pool size (platform limit 500)", sz)
        row := f_dashRow(tb, row, "LINES", str.tostring(lineUsed) + " / " + str.tostring(lineCap), C_TEXT, "Drawn / pool size (platform limit 500)", sz)
        row := f_dashRow(tb, row, "LABELS", str.tostring(pb.used) + " / " + str.tostring(pb.items.size()), C_TEXT, "Drawn / pool size (platform limit 500)", sz)
        int na1 = assertN.get(0)
        row := f_dashRow(tb, row, "ASSERTS", str.tostring(na1), na1 > 0 ? C_WARN : C_TEXT, "Self-check violations since the first bar (Debug mode); details in Pine Logs as ASSERT|…", sz)
        row := f_dashRow(tb, row, "VOLUME", hasVolume ? "yes" : "none (filters off)", hasVolume ? C_TEXT : C_WARN, "", sz)
        row := f_dashRow(tb, row, "CHART", nonStdChart ? "non-standard" : "standard", nonStdChart ? C_WARN : C_TEXT, "", sz)
        row := f_dashRow(tb, row, "LENGTHS", "swing " + str.tostring(swLen) + " · int " + str.tostring(inLen), C_TEXT, "", sz)
        row := f_dashRow(tb, row, "SESSIONS", sesOk ? sesTz : "off (TF > 1H)", C_TEXT, specAsia + " · " + specLon + " · " + specNy, sz)
        row := f_dashRow(tb, row, "HTF", htfOk ? htfLabel + " (" + htfTf + ") · " + str.tostring(hLastBars) + " bars" : htfBadCfg ? "⚠ not above chart TF" : "off", htfOk and not htfLowHist ? C_TEXT : C_WARN, "Higher timeframe and confirmed HTF bars. HTF objects age in HTF bars; distance limit ×" + str.tostring(htfDistMult, "0.0"), sz)
    true
//#else
// ── Setup panel (SMC Pro · Setups): the focus setup in four rows, then status and cfg
f_setColor(Setup s) =>
    na(s) ? C_NEUT : s.state >= SS_READY ? C_SIG : color.new(C_SIG, 35)

f_qualityBar(float sc) =>
    int k = int(math.round(sc))
    str.repeat("▮", k) + str.repeat("▯", 10 - k)

f_setupPanel(table tb, Ctx x, Core c, Setup fs, Setup ins) =>
    if not na(tb)
        string sz = panelSz
        int row = 0
        Liq nb = x.nextBsl
        Liq ns = x.nextSsl
        if i_setups
            if na(fs)
                Liq w = na(nb) ? ns : na(ns) ? nb : nb.price - close <= close - ns.price ? nb : ns
                string wt = na(w) ? "— watching" : "— watching " + (w.side == 1 ? "BSL " : "SSL ") + f_px(w.price)
                row := f_dashRow(tb, row, "SETUP", wt, C_NEUT, "No setup. A sweep of the nearest liquidity followed by a shift, or a BOS with the trend, starts one.", sz)
            else
                int left = i_expiry - (bar_index - fs.stageBar)
                string stg = f_sideName(fs.dir) + " — " + f_uiStage(fs.state) + " · " + (fs.model == SM_REV ? "Reversal" : "Continuation")
                string tipS = f_modelName(fs.model) + " · " + fs.chainMid + (fs.state <= SS_READY ? "\nexpires in " + str.tostring(math.max(0, left)) + " bars" : "") + (fs.state == SS_FORMING and fs.why != "" ? "\nwaiting: " + f_reasonText(fs.why) : "")
                row := f_dashRow(tb, row, "SETUP", stg, f_setColor(fs), tipS, sz)
                if fs.state >= SS_READY
                    color gc = fs.grade >= GR_A ? C_SIG : fs.grade == GR_B ? C_TEXT : C_NEUT
                    row := f_dashRow(tb, row, "QUALITY", str.tostring(fs.score, "0.0") + " / 10 · " + f_gradeName(fs.grade) + "  " + f_qualityBar(fs.score), gc, fs.factors + "Score = completeness of the setup, not a win probability", sz)
                    row := f_dashRow(tb, row, "PLAN", "E " + f_px(fs.entry) + " · SL " + f_px(fs.slInit) + " · TP1 " + f_px(fs.tp1), C_SIG, f_setPlanText(fs), sz)
                    row := f_dashRow(tb, row, "INVALID", f_px(fs.inv) + " · close " + (fs.dir == 1 ? "below" : "above"), C_BEAR, "Before the entry the setup is cancelled by a close beyond this level, an opposite swing CHoCH or a broken POI", sz)
        string stt = f_statusText(c)
        if stt != ""
            row := f_dashRow(tb, row, "STATUS", stt, C_WARN, "Setups and alerts are suppressed during warm-up; the panel always describes the latest bar", sz)
        // Inspect: the setup at the chosen time, or why there was none (§17.3)
        if i_inspect
            string it = f_timeStr(i_inspectT)
            if not na(ins)
                string ih = f_sideName(ins.dir) + " " + f_stateCode(ins.state) + " · " + f_modelName(ins.model) + (na(ins.readyBar) ? "" : " · " + f_gradeName(ins.grade) + " " + str.tostring(ins.score, "0.0"))
                row := f_dashRow(tb, row, "INSPECT", ih, C_SIG, it + "\n" + f_setTip(ins), sz)
            else
                string why = ""
                int nw = 0
                int na0 = attT0.size()
                if na0 > 0
                    for i = na0 - 1 to 0
                        if attT0.get(i) <= i_inspectT and i_inspectT <= attT1.get(i) and nw < 4
                            why := why + attTxt.get(i) + "\n"
                            nw += 1
                string w1 = nw > 0 ? str.split(why, "\n").first() : "no sweep or BOS opened a setup"
                row := f_dashRow(tb, row, "INSPECT", "no setup · " + w1, C_NEUT, it + "\n" + (nw > 0 ? "Attempts that ended without a trade:\n" + why : "No liquidity sweep with a shift, and no BOS with the trend, was open at this time.") + (na0 >= ATT_CAP ? "\nOnly the last " + str.tostring(ATT_CAP) + " attempts are kept." : ""), sz)
        // history: READY count, outcomes, and the most frequent reason a setup ended without a trade
        string topK = ""
        int topV = 0
        string all = ""
        array<string> ks = setStats.keys()
        for k in ks
            int v = setStats.get(k)
            all := all + k + "  " + str.tostring(v) + "\n"
            if k != "READY" and k != "WIN" and k != "SL" and v > topV
                topK := k
                topV := v
        int nAs = assertN.get(0)
        string stxt = (nAs > 0 ? "⚠" + str.tostring(nAs) + " asserts · " : "") + "READY " + str.tostring(nz(setStats.get("READY"))) + " · ✓" + str.tostring(nz(setStats.get("WIN"))) + " ✕" + str.tostring(nz(setStats.get("SL"))) + (topV > 0 ? " · " + str.lower(topK) + " " + str.tostring(topV) : "")
        row := f_dashRow(tb, row, "STATS", stxt, C_NEUT, "Whole loaded history: setups that reached READY, trades won (✓, at least TP1) and stopped (✕), and the most frequent reason a setup ended without a trade.\n\n" + all + "\nGRADE_LOW: score below the preset's READY grade · RR_LOW: last target closer than Min RR · SL_TOO_WIDE / SL_TOO_TIGHT: stop outside the limits · NO_POI / POI_IN_PREMIUM / POI_IN_DISCOUNT: no zone of the shift leg on the right side · NO_SHIFT_IN_WINDOW: no CHoCH / BOS after the sweep · SUPERSEDED: replaced by a newer setup · TP1_BEFORE_ENTRY: price ran away (MISSED)", sz)
        row := f_dashRow(tb, row, "CFG", str.tostring(cfgSig) + " · v" + BUILD, C_NEUT, "Settings signature: must equal the cfg number of SMC Visualizer Pro (Dashboard → CFG row). Different numbers mean the two indicators run the engines with different settings, and the setups do not match the structure on the chart.", sz)
        if row <= SET_PANEL_ROWS - 1
            table.clear(tb, 0, row, 1, SET_PANEL_ROWS - 1)
    true
//#endif
